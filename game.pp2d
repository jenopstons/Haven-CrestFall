{
  "pythonAssets": {
    "script": [
      {
        "Game": {
          "type": "game script",
          "start": "game.frame = 0\ngame.counter = 0\ngame.persisted = {}\ngame.globals = {}\ngame._studio_sound_fades = []\ngame._studio_room_music = None\ngame._studio_room_music_volume = 0\nif GAME_MUSIC is not None:\n    game._studio_game_music = sound(GAME_MUSIC['file'])\n    set_volume(game._studio_game_music, GAME_MUSIC['volume'])\n    loop_sound(game._studio_game_music)\n_validate_static_exit_destinations()\ngame.startRoom = \"DungeonStart\"\ngame.startLocation = \"start\"\n_validate_start(game.startRoom, game.startLocation)\n_validate_title(\"A_title_screen\")\n_enter_room(\"A_title_screen\", None)",
          "loop": "game.frame += 1\n_update_sound_fades()\n# skipDialog closes any open dialog at once, skipping a conversation's\n# remaining lines.\nif _control_was_pressed('skipDialog') and getattr(game, 'dialogBox', None) is not None:\n    hide_dialog()\n# A dialog with nothing currently claiming the interact key (no NPC/sign\n# conversation and no interact-activated exit is the active\n# _resolve_interact_target()) just closes on the next press - covers an\n# exit's own end-of-game dialog (its object stops running once reached) and\n# any one-shot dialog a callback or room script shows directly, with no\n# extra code needed from whoever called show_dialog().\nif (\n    _control_was_pressed('interact')\n    and getattr(game, 'dialogBox', None) is not None\n    and _resolve_interact_target() is None\n    and not _finish_dialog_typing()\n):\n    hide_dialog()\n# CONTROLS['debugGrid'] toggles a (row, col) label over every cell of the\n# current room's grid - an authoring aid for finding the right\n# cell(row, col) while building a map, not gameplay. An empty debugGrid\n# opts out of this tool entirely.\nif _control_was_pressed('debugGrid') and game.mapRows is not None:\n    labels = getattr(game, 'debugCoordLabels', None)\n    if labels:\n        for label in labels:\n            destroy(label)\n        game.debugCoordLabels = None\n    else:\n        labels = []\n        for row in range(game.mapRows):\n            for col in range(game.mapCols):\n                x, y = xy(row, col)\n                label = text(f'({row}, {col})', x, y)\n                label.fontSize = 12\n                label.halign = 'center'\n                label.valign = 'middle'\n                label.color = 'magenta'\n                label.z = 999\n                labels.append(label)\n        game.debugCoordLabels = labels\n# CONTROLS['debugHitbox'] toggles the player's own collision hitbox\n# visible, for testing - not gameplay. An empty debugHitbox opts out.\nif _control_was_pressed('debugHitbox') and game.player is not None:\n    game.player.hitbox.visible = not game.player.hitbox.visible"
        }
      },
      {
        "Player": {
          "type": "object script",
          "start": "poses = PLAYER_CONFIG['poses']\nself.runPose = _load_pose(_resolve_pose(poses, 'run'))\nself.idlePose = _load_pose(_resolve_pose(poses, 'idle'))\nself.jumpUpPose = _load_pose(_resolve_pose(poses, 'jumpUp'))\nself.jumpDownPose = _load_pose(_resolve_pose(poses, 'jumpDown'))\nself.attackPose = _load_pose(_resolve_pose(poses, 'attack'))\nself.climbPose = _load_pose(_resolve_pose(poses, 'climb'))\n# Holding still on a ladder shows the climb art without animating.\nself.climbStillPose = _load_pose(_resolve_pose(poses, 'climb'), fps=0)\n# Frozen copy of idle, used for the finished-game freeze.\nself.frozenPose = _load_pose(_resolve_pose(poses, 'idle'), fps=0)\n_apply_pose(self, self.idlePose)\n# Above Exit's z (5) so the player draws in front of exits.\nself.z = 6\nself.hitbox = PlayerHitbox()\nself.hitbox.z = self.z + 1\n# Sized from the actual idle sprite, not a hardcoded pixel count, so any\n# character swap keeps working.\nself.hitbox.scaleX = get_width(self) * PLAYER_CONFIG['hitboxWidthPercent'] / 100 / get_width(self.hitbox)\nself.hitbox.scaleY = get_height(self) * PLAYER_CONFIG['hitboxHeightPercent'] / 100 / get_height(self.hitbox)\n# Negative because world Y increases upward.\nself.hitboxOffsetY = -(get_height(self) - get_height(self.hitbox)) / 2\n\nself.accel = PLAYER_CONFIG['accel']\nself.decel = PLAYER_CONFIG['decel']\nself.maxSpeed = PLAYER_CONFIG['maxSpeed']\nself.jumpSpeed = PLAYER_CONFIG['jumpSpeed']\nself.fallMult = PLAYER_CONFIG['fallMult']\nself.gravity = PLAYER_CONFIG['gravity']\nself.jumpCut = PLAYER_CONFIG['jumpCut']\n\nself.coyoteMax = PLAYER_CONFIG['coyoteMax']\nself.bufferMax = PLAYER_CONFIG['bufferMax']\nself.invulnerableFrames = PLAYER_CONFIG['invulnerableFrames']\nself.damageFlashFrames = PLAYER_CONFIG['damageFlashFrames']\nself.blinkCycleFrames = PLAYER_CONFIG['blinkCycleFrames']\nself.knockbackX = PLAYER_CONFIG['knockbackX']\nself.knockbackY = PLAYER_CONFIG['knockbackY']\nself.landingSquashX = PLAYER_CONFIG['landingSquashX']\nself.landingSquashY = PLAYER_CONFIG['landingSquashY']\nself.jumpSquashX = PLAYER_CONFIG['jumpSquashX']\nself.jumpSquashY = PLAYER_CONFIG['jumpSquashY']\nself.squashEaseRate = PLAYER_CONFIG['squashEaseRate']\nself.stompBounce = PLAYER_CONFIG['stompBounce']\nself.stompDamage = PLAYER_CONFIG['stompDamage']\nself.fallMargin = PLAYER_CONFIG['fallMargin']\n\n# Collision-safety clamp, not a feel setting - keeps fast falls from\n# tunneling through thin platforms.\nself.terminalVel = PLAYER_CONFIG['terminalVel']\nself.coyoteTimer = 0\nself.jumped = False\nself.bufferTimer = 0\n\nself.dx = 0\nself.dy = 0\nself.onGround = False\n# Where a fall puts the player back: the last still, hazard-free ground stood on.\nself.safeGround = None\nself.moveLocked = False\n# Runtime horizontal direction; art orientation comes from the active pose.\nself.facing = 1\nself.health = _max_health()\nself.invulnerable = 0\nself.damageFilterId = None\nself.damageFlashTimer = 0\nself.frozen = False\nself.projectile = PLAYER_CONFIG.get('projectile')\nself.dashing = False\nself.dashX = 1\nself.dashY = 0\nself.dashFramesLeft = 0\nself.dashCooldownTimer = 0\nself.dashCharges = ABILITIES_CONFIG['dash']['charges']\nself.dashFilterId = None\nself.airJumpMax = ABILITIES_CONFIG['airJump']['count']\nself.airJumps = self.airJumpMax if ABILITIES_CONFIG['airJump']['refill'] == 'landing' else 0\n# Wall jump: the side of the wall last touched (-1 left, 1 right), frames left to still jump off\n# it, and frames the push away from it still overrides left/right.\nself.wallSide = 0\nself.wallTimer = 0\nself.wallKickTimer = 0\n# Climbing: on a ladder now, the ladder top stood on, frames before up grabs again, and\n# whether this frame's jump let go of a ladder.\nself.climbing = False\nself.climbableBelow = None\nself.climbRegrabTimer = 0\nself.climbJumped = False\nself.shootCooldown = 0\nself.ammo = COMBAT_CONFIG['maxAmmo']\nself.ammoTimer = 0\nself.healTimer = 0\nself.healFilterId = None\nself.attackTimer = 0\nself.strike = None\ngame.hitStop = 0\nself.sqX = 1.0\nself.sqY = 1.0\nself.squashOffsetY = 0\nself.squashDrawnY = None\nself.scaleX = getattr(self, 'artFacing', 1) * self.facing\n",
          "loop": "if self._destroyed:\n    return\nif self.frozen:\n    _end_attack(self)\n    _cancel_heal(self)\n    game.hitStop = 0\n    _apply_pose(self, self.frozenPose)\n    self.scaleX = getattr(self, 'artFacing', 1) * self.facing * self.sqX\n    self.scaleY = self.sqY\n    cx, cy = _follow_player_camera(self.x, self.y)\n    cx += getattr(game, 'shakeX', 0)\n    cy += getattr(game, 'shakeY', 0)\n    set_camera(cx, cy)\n    game.bg.x = cx\n    game.bg.y = cy\n    return\nif _step_hit_stop():\n    return\n_update_appearing()\n\n# Squash only shifts the drawn sprite; code that moved the player since keeps its position.\nif self.y == self.squashDrawnY:\n    self.y -= self.squashOffsetY\nself.scaleX = getattr(self, 'artFacing', 1) * self.facing\nself.scaleY = 1\n\nif self.invulnerable > 0:\n    self.invulnerable -= 1\n    self.visible = self.invulnerable % self.blinkCycleFrames < self.blinkCycleFrames // 2\nelse:\n    self.visible = True\n\nself.damageFlashTimer -= 1\nif self.damageFilterId is not None and self.damageFlashTimer <= 0:\n    remove_filter(self, self.damageFilterId)\n    self.damageFilterId = None\n\n# Two-pass axis-separated collision (Y then X). Solids are anything\n# tagged 'Platform' or 'Barrier' (a locked Barrier blocks like a\n# platform until opened); the X pass also stops at the room's EdgeWalls.\n\n# === Y: gravity + move ===\n_step_climbing(self)\npreviousFeet = _feet(self)\nif self.climbing:\n    pass\nelif self.dashing:\n    self.dy = _dash_dy(self)\nelif self.dy < 0:\n    self.dy += self.gravity * self.fallMult\nelse:\n    self.dy += self.gravity\nif self.dy < self.terminalVel:\n    self.dy = self.terminalVel\nself.y += self.dy\n\n# === Y collision (closest solid wins) ===\nwasOnGround = self.onGround\nself.onGround = False\nself.climbableBelow = None\nself.hitbox.x = self.x\nself.hitbox.y = self.y + self.hitboxOffsetY\nsolids = _solids_touching(self.hitbox)\nbest = None\nfor solid in solids:\n    barrier = getattr(solid, 'barrier', solid if hasattr(solid, 'locked') else None)\n    if barrier is not None:\n        _open_barrier(barrier)\n    if getattr(solid, '_destroyed', False):\n        continue\n    hh = get_height(self.hitbox) / 2 + get_height(solid) / 2\n    isFloor = self.hitbox.y > solid.y\n    candidateHitboxY = solid.y + hh if isFloor else solid.y - hh\n    candidateY = candidateHitboxY - self.hitboxOffsetY\n    delta = abs(candidateY - self.y)\n    # Prefer a launcher (spring, trampoline, ...) over a same-distance neighbour tile.\n    if best is None or delta < best[0] or (\n        delta == best[0] and getattr(solid, 'launchSpeed', None) is not None\n        and getattr(best[3], 'launchSpeed', None) is None\n    ):\n        best = (delta, candidateY, isFloor, solid)\nif best is not None:\n    self.y = best[1]\n    if best[2]:\n        self.onGround = True\n        # Carry a moving platform's own per-frame delta.\n        self.x += getattr(best[3], 'dx', 0)\n        launchSpeed = getattr(best[3], 'launchSpeed', None)\n        if launchSpeed is not None:\n            self.onGround = False\n            self.jumped = True\n            self.coyoteTimer = 0\n            self.bufferTimer = 0\n            self.dy = launchSpeed\n            best[3].springTimer = best[3].springFrames\n            _apply_pose(best[3], best[3].springPressedPose)\n            best[3].scaleX = getattr(best[3], 'artFacing', 1)\n            _play_sound('spring')\n        else:\n            self.dy = -(abs(getattr(best[3], 'dy', 0)) + 2)\n    else:\n        self.dy = 0\nif best is None or not best[2]:\n    _land_on_climbable_top(self, previousFeet)\nif self.climbing and self.onGround and self.dy <= 0:\n    self.climbing = False\n\nif self.onGround and not wasOnGround:\n    self.sqX = self.landingSquashX\n    self.sqY = self.landingSquashY\n\nif self.onGround and _stands_on_safe_ground(self, solids):\n    self.safeGround = (self.x, self.y)\n\n# === Fall off the map ===\nmapBottom = getattr(game, 'mapBottom', None)\nif mapBottom is not None and self.y < mapBottom - self.fallMargin:\n    _fall_to_safe_ground(self)\n    return\n\n# === X: accel/decel/turn ===\nmoving = False\ntarget = 0\n# After a fall, a direction still held is ignored until it's let go.\nif self.moveLocked and not _control_is_pressed('moveLeft') and not _control_is_pressed('moveRight'):\n    self.moveLocked = False\n# A wall jump's push carries the player away from the wall for a few frames.\nif self.onGround or self.climbing:\n    self.wallKickTimer = 0\nsteering = not self.moveLocked and self.wallKickTimer <= 0 and not self.climbing\nif steering and _control_is_pressed('moveLeft'):\n    target -= self.maxSpeed\n    self.facing = -1\n    moving = True\nif steering and _control_is_pressed('moveRight'):\n    target += self.maxSpeed\n    self.facing = 1\n    moving = True\nif self.climbing:\n    moving = self.dx != 0 or self.dy != 0\nelif self.wallKickTimer > 0:\n    self.wallKickTimer -= 1\nelif target != 0:\n    self.dx = min(self.dx + self.accel, target) if target > self.dx else max(self.dx - self.accel, target)\nelif self.dx > 0:\n    self.dx = max(self.dx - self.decel, 0)\nelif self.dx < 0:\n    self.dx = min(self.dx + self.decel, 0)\n_step_abilities(self)\nself.x += self.dx\n\n# === X collision ===\n# get_collision_list misses overlaps of 2 px or less, so walls are found 2 px ahead.\nself.hitbox.x = self.x + (2 if self.dx > 0 else -2 if self.dx < 0 else 0)\nself.hitbox.y = self.y + self.hitboxOffsetY\nsolids = _solids_touching(self.hitbox, edges=True)\nbest = None\nfor solid in solids:\n    barrier = getattr(solid, 'barrier', solid if hasattr(solid, 'locked') else None)\n    if barrier is not None:\n        _open_barrier(barrier)\n    if getattr(solid, '_destroyed', False):\n        continue\n    hw = get_width(self.hitbox) / 2 + get_width(solid) / 2\n    candidateX = solid.x + hw if self.x > solid.x else solid.x - hw\n    delta = abs(candidateX - self.x)\n    if best is None or delta < best[0]:\n        best = (delta, candidateX)\nif best is not None:\n    self.x = best[1]\n\nself.hitbox.x = self.x\nself.hitbox.y = self.y + self.hitboxOffsetY\n_step_wall_contact(self)\n\n# === Jump: coyote time + input buffer ===\nif self.onGround:\n    self.coyoteTimer = self.coyoteMax\n    self.jumped = False\nelse:\n    self.coyoteTimer -= 1\nif _control_was_pressed('jump'):\n    self.bufferTimer = self.bufferMax\nelse:\n    self.bufferTimer -= 1\nif _control_was_released('jump') and self.dy > 0:\n    self.dy *= self.jumpCut\ncanJump = (self.onGround or self.coyoteTimer > 0) and not self.jumped\nwantJump = (_control_was_pressed('jump') or self.bufferTimer > 0) and not self.climbing and not self.climbJumped\nif wantJump and canJump:\n    _end_dash(self)\n    self.dy = self.jumpSpeed\n    self.jumped = True\n    self.coyoteTimer = 0\n    self.bufferTimer = 0\n    self.sqX = self.jumpSquashX\n    self.sqY = self.jumpSquashY\n    _play_sound('jump')\nelif wantJump and not _try_wall_jump(self):\n    _try_air_jump(self)\n_start_dash(self)\n_start_attack(self)\n_step_attack(self)\n\n_step_shooting(self)\n_step_heal(self)\n\n# === Animation ===\nself.scaleX = getattr(self, 'artFacing', 1) * self.facing\nif _attack_pose_showing(self):\n    _apply_pose(self, self.attackPose)\nelif self.climbing:\n    _apply_pose(self, self.climbPose if moving else self.climbStillPose)\nelif not self.onGround:\n    _apply_pose(self, self.jumpUpPose if self.dy > 0 else self.jumpDownPose)\nelif moving:\n    _apply_pose(self, self.runPose)\nelse:\n    _apply_pose(self, self.idlePose)\n\nself.sqX += (1.0 - self.sqX) * self.squashEaseRate\nself.sqY += (1.0 - self.sqY) * self.squashEaseRate\n\nself.hitbox.x = self.x\nself.hitbox.y = self.y + self.hitboxOffsetY\ncontactFeet = self.hitbox.y - get_height(self.hitbox) / 2\nstompSurfaceY = None\nfor enemyHitbox in get_collision_list(self.hitbox, 'EnemyHitbox'):\n    enemyTop = _handle_enemy_contact(enemyHitbox.owner, self, contactFeet)\n    if enemyTop is not None and (stompSurfaceY is None or enemyTop > stompSurfaceY):\n        stompSurfaceY = enemyTop\nif self._destroyed:\n    return\nif stompSurfaceY is not None:\n    self.hitbox.y = stompSurfaceY + get_height(self.hitbox) / 2\n    self.y = self.hitbox.y - self.hitboxOffsetY\n\ncx, cy = _follow_player_camera(self.x, self.y)\ncx += getattr(game, 'shakeX', 0)\ncy += getattr(game, 'shakeY', 0)\nset_camera(cx, cy)\ngame.bg.x = cx\ngame.bg.y = cy\n\n# Draw squashed or stretched with the feet where the hitbox's feet are.\nself.squashOffsetY = -get_height(self) * (1 - self.sqY) / 2\nself.scaleX = getattr(self, 'artFacing', 1) * self.facing * self.sqX\nself.scaleY = self.sqY\nself.y += self.squashOffsetY\nself.squashDrawnY = self.y\n"
        }
      },
      {
        "Enemies": [
          {
            "Enemy": {
              "type": "object script",
              "start": "self.behavior = 'patrol'\nself.spawnX = 0\nself.spawnY = 0\nself.patrolRange = ENEMY_DEFAULTS['patrolRange']\nself.speed = 2 / 3 * UNIT\nself.dir = 1\nself.z = 3\nself.sensor = EnemySensor()\nself.hitbox = EnemyHitbox()\nself.hitbox.owner = self\nself.hitboxOffsetX = 0\nself.hitboxOffsetY = 0\nself.hitboxBase = None\nself.hopPause = 0\nself.hopDy = 0\nself.flying = False\nself.sqX = 1.0\nself.sqY = 1.0\nself.invulnerable = 0\nself.hitFlashTimer = 0\nself.staggerTimer = 0\nself.hitFilterId = None\nself.dying = False\nself.invincible = False\nself.dropState = 'wait'\nself.dropDy = 0\nself.dropPause = 0\nself.projectile = None\nself.fireTimer = 0\nself.shootInterval = PROJECTILE_CONFIG['enemyFireInterval']\nself.stillPose = None\nself.winFrozen = False\nself._isEnemy = True\nself.typeName = None\nself.maxHealth = 1\nself.poses = {}\nself.poseName = None\nself.airborne = False\nself.dropPending = False\nself.groundSolid = None\nself.senseAhead = ENEMY_DEFAULTS.get('senseAhead', 0)\nself.senseDown = ENEMY_DEFAULTS.get('senseDown', 0)\nself.lastGround = (0, 0)\nself.fallsOut = 0\nself.home = (0, 0)\nself.loopScript = None\nself.isBoss = False\nself.beatenSetsGlobal = None\n# Sprite, health, and behavior-specific tuning are set by add_enemy\n# right after construction, once the enemy's type is known.\n",
              "loop": "if self._destroyed:\n    return\nif getattr(game, 'finished', False) and not self.dying:\n    if self.hitFilterId is not None:\n        remove_filter(self, self.hitFilterId)\n        self.hitFilterId = None\n    self.visible = True\n    _freeze_for_win(self)\n    return\n_update_enemy_hit_effects(self)\nif self.behavior == 'jumper':\n    _unsquash_jumper(self)\n_step_enemy(self)\nif self.behavior == 'jumper' and not self._destroyed:\n    _squash_jumper(self)\n"
            }
          },
          {
            "EnemyHitbox": {
              "type": "object script",
              "start": "# Invisible collision proxy for Enemy, so squash never changes what the player touches.\nself.sprite = sprite('pixel.png')\nself.visible = False\nself.collisionProxy = True\nself.scaleX = 1.0\nself.scaleY = 1.0\n",
              "loop": ""
            }
          },
          {
            "EnemySensor": {
              "type": "object script",
              "start": "# Invisible probe used to check for ground or walls ahead.\nself.sprite = sprite('pixel.png')\nself.visible = False\nself.collisionProxy = True\nself.scaleX = max(ENEMY_DEFAULTS['sensorSize'], ENEMY_SENSOR_MIN_WIDTH)\nself.scaleY = ENEMY_DEFAULTS['sensorSize']\n",
              "loop": ""
            }
          }
        ]
      },
      {
        "Environment": [
          {
            "Barrier": {
              "type": "object script",
              "start": "self.z = 2\nself.parts = []\nself.locked = True\nself.requires = None\nself.condition = None\nself.persistentId = None\n",
              "loop": "if self._destroyed:\n    return\nif get_collision(self, 'PlayerHitbox'):\n    _open_barrier(self)\n"
            }
          },
          {
            "Climbable": {
              "type": "object script",
              "start": "# Tagged Climbable: the player climbs it with up and down, and can stand on the top one.\n# It never blocks movement.\nself.z = 1\n",
              "loop": ""
            }
          },
          {
            "EdgeWall": {
              "type": "object script",
              "start": "# The room's invisible left and right edges: they stop sideways movement, and nothing stands on them.\n",
              "loop": ""
            }
          },
          {
            "Exit": {
              "type": "object script",
              "start": "self.z = 5\nself.region = None\n",
              "loop": "if self._destroyed:\n    return\nregion = self.region\nif region is None or region['reached']:\n    return\n# Two overlapping exits that end the game must not both finish it in the\n# same frame.\nif not region['toRoom'] and getattr(game, 'finished', False):\n    return\ntouching = any(get_collision(trigger, 'PlayerHitbox') for trigger in region['triggers'])\nindicator = region['promptIndicator']\nif not touching:\n    # Leaving the region re-arms it and resets the dialog guard.\n    region['armed'] = True\n    region['dialogFrame'] = None\n    region['dialogShown'] = False\n    if indicator is not None:\n        destroy(indicator)\n        region['promptIndicator'] = None\n    return\n# One region can be shared by several trigger parts - only process each once per frame.\nif region['dialogFrame'] == game.frame:\n    return\nregion['dialogFrame'] = game.frame\nif not region['armed']:\n    return\nif region['prompt']:\n    if indicator is None and not region.get('promptSuppressed') and UI_CONFIG['dialog']['indicator']['pose'] is not None:\n        indicator = DialogPrompt()\n        region['promptIndicator'] = indicator\n    if indicator is not None:\n        indicatorLayout = UI_CONFIG['dialog']['indicator']['exit']\n        indicator.x = self.x + indicatorLayout['offsetX']\n        indicator.y = self.y + get_height(self) / 2 + get_height(indicator) / 2 + indicatorLayout['gap']\n        indicator.visible = not region.get('promptSuppressed')\n        indicator.alpha = region.get('promptAlpha', 1)\n    # The shared interaction selector may have picked a different nearby\n    # NPC/sign/door for this frame's interact press - only the chosen\n    # target acts.\n    if not is_interact_target(region) or not _control_was_pressed('interact'):\n        return\nif not _requires_met(region['requires']):\n    if not region['dialogShown']:\n        if region['failText']:\n            show_dialog('', region['failText'])\n            region['dialogShown'] = True\n        return\n    if _control_was_pressed('interact') and not _finish_dialog_typing():\n        hide_dialog()\n    return\nregion['reached'] = True\nif indicator is not None:\n    destroy(indicator)\n    region['promptIndicator'] = None\nif region['toRoom']:\n    _play_sound('travel')\n    go_to_room(region['toRoom'], region['toLocation'])\n    return\n_play_sound('goal')\ngame.finished = True\n# A callback observes completion - it never replaces the default\n# freeze/dialog, so installing one can't silently disable it.\nplayer = game.player\n# Freezing skips Player-loop.py entirely, which is what normally ticks\n# invulnerable/visible each frame - stop the damage-flash blink first, or\n# the player can freeze mid-blink and stay invisible for the rest of the game.\nplayer.invulnerable = 0\nplayer.visible = True\nif player.damageFilterId is not None:\n    remove_filter(player, player.damageFilterId)\n    player.damageFilterId = None\nplayer.frozen = True\nshow_dialog('', region['successText'] or \"Goal reached!\")\n# Nothing runs this object's loop again after 'reached' is set (see the\n# early return at the top) - the generic game loop's own dialog-dismiss\n# fallback (see assemble-game.ts) closes this one instead.\n_dispatch('gameFinished', self)\n"
            }
          },
          {
            "Hazard": {
              "type": "object script",
              "start": "self.z = 2\nself.damage = 1\nself.hitbox = None\n",
              "loop": "if self._destroyed:\n    return\ntouching = get_collision(self, 'PlayerHitbox')\nif touching and (self.hitbox is None or _hitbox_touches(self, self.hitbox, touching)):\n    _damage_player(self.damage, self)\n"
            }
          },
          {
            "Platform": {
              "type": "object script",
              "start": "# One instance per tile, at native scale - a wide platform is several of\n# these placed side by side, not one stretched sprite.\nself.scaleX = 1\nself.scaleY = 1\nself.springTimer = 0\nself.moving = False\nself.axis = 'x'\nself.speed = 1.5\nself.dir = 1\nself.startX = 0\nself.targetX = 0\nself.startY = 0\nself.targetY = 0\nself.dx = 0\nself.dy = 0\n",
              "loop": "if self._destroyed:\n    return\nself.dx = 0\nself.dy = 0\nif _hit_stopped():\n    return\nif self.springTimer > 0:\n    self.springTimer -= 1\n    if self.springTimer == 0:\n        _apply_pose(self, self.springIdlePose)\n        self.scaleX = getattr(self, 'artFacing', 1)\nif not self.moving:\n    return\n# dir=1 means \"toward the high end\", since the target can be above or\n# below start.\nif self.axis == 'y':\n    prevY = self.y\n    lo = min(self.startY, self.targetY)\n    hi = max(self.startY, self.targetY)\n    if self.dir > 0:\n        self.y += self.speed\n        if self.y >= hi:\n            self.y = hi\n            self.dir = -1\n    else:\n        self.y -= self.speed\n        if self.y <= lo:\n            self.y = lo\n            self.dir = 1\n    self.dy = self.y - prevY\n    return\nprevX = self.x\nlo = min(self.startX, self.targetX)\nhi = max(self.startX, self.targetX)\nif self.dir > 0:\n    self.x += self.speed\n    if self.x >= hi:\n        self.x = hi\n        self.dir = -1\nelse:\n    self.x -= self.speed\n    if self.x <= lo:\n        self.x = lo\n        self.dir = 1\nself.dx = self.x - prevX\n"
            }
          },
          {
            "Decor": {
              "type": "object script",
              "start": "# Untagged - unlike Platform, decor never collides with the player.\nself.z = 1\n",
