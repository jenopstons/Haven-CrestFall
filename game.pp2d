    "function": [
      {
        "game-toolkit": [
          {
            "placement.py": {
              "type": "function script",
              "head": "# Generic argument/type resolution shared by every placement factory,\n# regardless of game genre.\n\ndef cell(row, col):\n    # An inert grid-cell reference - only meaningful once resolved (via\n    # at=) against the room build_tilemap() most recently ran for. Does\n    # not depend on CELL or an active room itself, so it's safe to build\n    # in maps.py at module-eval time, before any room has been entered.\n    if not isinstance(row, int) or isinstance(row, bool) or row < 0:\n        raise ValueError('cell(row, col) needs nonnegative whole numbers.')\n    if not isinstance(col, int) or isinstance(col, bool) or col < 0:\n        raise ValueError('cell(row, col) needs nonnegative whole numbers.')\n    return {'_posKind': 'cell', 'row': row, 'col': col}\n\ndef world(x, y):\n    # An inert world-space reference - the world-space counterpart to\n    # cell(), resolved the same way via at=.\n    for value in (x, y):\n        if isinstance(value, bool) or not isinstance(value, (int, float)) or value != value or value in (float('inf'), float('-inf')):\n            raise ValueError('world(x, y) needs finite numbers.')\n    return {'_posKind': 'world', 'x': x, 'y': y}\n\ndef _is_position(value):\n    return isinstance(value, dict) and value.get('_posKind') in ('cell', 'world')\n\ndef _resolve_at(at):\n    # Resolves an at= argument to a world (x, y) pair: cell()/world(),\n    # or a named location string from this room's 'locations'. Raises on\n    # anything else, including a raw (x, y) tuple - at= is never\n    # ambiguous about whether it's a cell or a world position.\n    if isinstance(at, str):\n        locations = getattr(game, 'locations', {})\n        if at not in locations:\n            raise ValueError(\n                f\"No location named {at!r} on this map - check 'locations' in \"\n                \"maps.py, and make sure build_tilemap() ran first.\"\n            )\n        return locations[at]\n    if not _is_position(at):\n        raise ValueError(\n            \"at= needs cell(row, col), world(x, y), or a location name string.\"\n        )\n    if at['_posKind'] == 'world':\n        return (at['x'], at['y'])\n    return xy(at['row'], at['col'])\n\n# --- id / remember_as: two independent names -------------------------------\n#\n# `id` names a live placement for scripts (get_object/find_object); it has no\n# persistence effect. `remember_as` names a placement's resolved gameplay\n# state across visits within one play run. Both are reserved for the whole\n# room visit the instant they're supplied, even if the placement turns out to\n# be absent (already resolved on an earlier visit) or is destroyed later -\n# recreating one in the same visit needs a different name or no name.\n\ndef _reserve_name(store, name, what):\n    if not isinstance(name, str) or name == '':\n        raise ValueError(f\"{what} must be a non-empty string.\")\n    if name in store:\n        raise ValueError(\n            f\"Duplicate {what} {name!r} - names must be unique within a room for \"\n            \"the whole visit, even if the earlier placement is absent or destroyed.\"\n        )\n    store.add(name)\n\ndef _reserve_id(id):\n    if id is not None:\n        _reserve_name(game.reservedIds, id, 'id')\n\ndef _reserve_remember_as(remember_as):\n    if remember_as is not None:\n        _reserve_name(game.reservedRememberAs, remember_as, 'remember_as')\n\ndef _register_instance(category, type, obj, id=None):\n    # Indexes a live logical instance by (category, type) for of_type(), and\n    # by id for get_object()/find_object() when the caller gave one. id\n    # uniqueness itself was already enforced by _reserve_id before\n    # construction - this just wires up the live lookup. Every registered\n    # instance is stamped with the current visit token, so a handle kept\n    # across a room change/death is recognizably stale (see\n    # _require_live_handle) instead of silently mutating the new room.\n    game.byCategoryType.setdefault((category, type), []).append(obj)\n    obj._visitToken = game.visitToken\n    if id is not None:\n        game.instances[id] = obj\n        obj.instanceId = id\n    return obj\n\ndef _validate_global(name, what):\n    # GLOBALS is project-authored (see the config block assembleGame emits) -\n    # every sets_global/requires/appears_when/disappears_when name must be declared there (with\n    # a type - see _global_type), so a typo fails loudly instead of\n    # silently reading/writing a fresh default.\n    declared = globals().get('GLOBALS')\n    if declared is None:\n        raise ValueError(\n            \"No GLOBALS declared for this project - declare every checkpointed \"\n            \"global name and type it uses, e.g. \"\n            \"GLOBALS = {'has_key': {'type': 'bool', 'default': False}}.\"\n        )\n    if name not in declared:\n        raise ValueError(f\"{what} names undeclared global {name!r} - add it to GLOBALS.\")\n\ndef _global_type(name):\n    return globals()['GLOBALS'][name]['type']\n\ndef _global_default(name):\n    return globals()['GLOBALS'][name]['default']\n\ndef set_global(name, value):\n    _validate_global(name, 'set_global')\n    expected = _global_type(name)\n    if expected == 'bool' and not isinstance(value, bool):\n        raise ValueError(f\"set_global({name!r}, ...) expected a bool, got {type(value).__name__}.\")\n    if expected == 'int' and (isinstance(value, bool) or not isinstance(value, int)):\n        raise ValueError(f\"set_global({name!r}, ...) expected an int, got {type(value).__name__}.\")\n    if expected == 'enum':\n        allowed = globals()['GLOBALS'][name]['values']\n        if value not in allowed:\n            raise ValueError(f\"set_global({name!r}, {value!r}) - expected one of {allowed}.\")\n    game.globals[name] = value\n\ndef get_global(name):\n    _validate_global(name, 'get_global')\n    return game.globals.get(name, _global_default(name))\n\ndef _persistent_id(remember_as):\n    # Persistence is granted by an authored remember_as= alone, keyed by room\n    # + remember_as - never by id, coordinates, art/type, or destroyed state.\n    if remember_as is not None:\n        return (game.room, remember_as)\n    return None\n\ndef _is_persisted(name, persistent_id):\n    # `name` is which persisted-identity set to check (e.g.\n    # 'collectedMapItems', 'openedBarriers') - each kind of one-time effect\n    # gets its own set within game.persisted so their identities never\n    # collide. Checkpointed/restored wholesale by spawn_player/\n    # _respawn_player (player.py) with no per-name code of its own.\n    return persistent_id is not None and persistent_id in game.persisted.get(name, set())\n\ndef _mark_persisted(name, persistent_id):\n    if persistent_id is not None:\n        game.persisted.setdefault(name, set()).add(persistent_id)\n\n# --- lookup ------------------------------------------------------------\n\ndef get_object(id):\n    if not isinstance(id, str) or id == '':\n        raise ValueError('get_object(id) needs a non-empty string.')\n    obj = getattr(game, 'instances', {}).get(id)\n    if obj is None or obj._destroyed:\n        raise ValueError(f\"No object with id {id!r} - check it was authored/created and still exists.\")\n    return obj\n\ndef find_object(id):\n    if not isinstance(id, str) or id == '':\n        raise ValueError('find_object(id) needs a non-empty string.')\n    obj = getattr(game, 'instances', {}).get(id)\n    if obj is None or obj._destroyed:\n        return None\n    return obj\n\n# Every category of_type()/lookup exposes, and the type catalog each one\n# validates its `type` argument against. 'wall' is not a real category - wall\n# helpers register as 'platform' (see terrain.py) - so an of_type('wall', ...)\n# query raises with that guidance instead of silently returning [].\n_CATEGORY_CATALOGS = {\n    'platform': 'PLATFORM_TYPES',\n    'collectible': 'COLLECTIBLE_TYPES',\n    'key': 'COLLECTIBLE_TYPES',\n    'barrier': 'BARRIER_TYPES',\n    'switch': 'SWITCH_TYPES',\n    'hazard': 'HAZARD_TYPES',\n    'decor': 'DECOR_TYPES',\n    'climbable': 'CLIMBABLE_TYPES',\n    'enemy': 'ENEMY_TYPES',\n    'npc': 'NPC_TYPES',\n    'sign': 'SIGN_TYPES',\n    'exit': 'EXIT_TYPES',\n}\n\ndef of_type(category, type):\n    # Every live logical instance of this (category, type), regardless of\n    # whether it came from the grid, an 'objects' declaration, or a\n    # direct add_*() call - as long as that path registered it. A valid\n    # category/type with no live instances returns [], not KeyError.\n    if category == 'wall':\n        raise ValueError(\"of_type has no 'wall' category - wall helpers register under 'platform'.\")\n    catalog_name = _CATEGORY_CATALOGS.get(category)\n    if catalog_name is None:\n        raise ValueError(f\"Unknown of_type category {category!r} - expected one of {sorted(_CATEGORY_CATALOGS.keys())}.\")\n    catalog = globals().get(catalog_name, {})\n    if type not in catalog:\n        raise ValueError(f\"Unknown type {type!r} for category {category!r} - expected one of {sorted(catalog.keys())}.\")\n    return [obj for obj in game.byCategoryType.get((category, type), []) if not obj._destroyed]\n\n# --- whole-placement operations -----------------------------------------\n\ndef _is_stale(obj):\n    return getattr(obj, '_visitToken', None) != game.visitToken\n\ndef _require_live_handle(obj, what):\n    if obj is None or getattr(obj, '_destroyed', False) or _is_stale(obj):\n        raise ValueError(f\"{what} needs a live placement handle - this one is None, destroyed, or from a previous room.\")\n\ndef _reject_player_handle(obj, what):\n    if getattr(obj, '_isPlayer', False):\n        raise ValueError(f\"{what} does not accept the player handle - player position/lifecycle belongs to spawn_player/exits/death.\")\n\ndef _composite_pieces(obj):\n    # Every piece behind one placement - a barrier's extra parts, an\n    # enemy's sensor and hitbox, or an exit's trigger sprites\n    # (region['triggers'], obj included).\n    pieces = list(getattr(obj, 'parts', None) or [])\n    region = getattr(obj, 'region', None)\n    if region is not None:\n        pieces.extend(region['triggers'])\n    for name in ('sensor', 'hitbox'):\n        piece = getattr(obj, name, None)\n        if piece is not None and not isinstance(piece, dict):\n            pieces.append(piece)\n    return pieces\n\ndef hide_object(obj):\n    # Hides a placement and every composite piece behind it - collision,\n    # requirements and activation are unaffected. Suppresses eligible\n    # prompts (an exit's shared indicator lives on its region, not the\n    # individual trigger piece, so the suppression flag goes there too).\n    _require_live_handle(obj, 'hide_object')\n    _reject_player_handle(obj, 'hide_object')\n    obj.visible = False\n    for piece in _composite_pieces(obj):\n        piece.visible = False\n    prompt = getattr(obj, 'prompt', None)\n    if prompt is not None:\n        prompt.visible = False\n    region = getattr(obj, 'region', None)\n    if region is not None:\n        region['promptSuppressed'] = True\n    obj.promptSuppressed = True\n\ndef show_object(obj):\n    _require_live_handle(obj, 'show_object')\n    _reject_player_handle(obj, 'show_object')\n    obj.visible = True\n    for piece in _composite_pieces(obj):\n        piece.visible = not getattr(piece, 'collisionProxy', False)\n    region = getattr(obj, 'region', None)\n    if region is not None:\n        region['promptSuppressed'] = False\n    obj.promptSuppressed = False\n\ndef destroy_object(obj):\n    # Destroys a placement and every composite piece behind it - plain\n    # destroy() only removes obj itself, leaving the rest alive. Idempotent\n    # for None/already-destroyed/stale handles.\n    if obj is None or getattr(obj, '_destroyed', False) or _is_stale(obj):\n        return\n    _reject_player_handle(obj, 'destroy_object')\n    for piece in _composite_pieces(obj):\n        if piece is not obj and not piece._destroyed:\n            destroy(piece)\n    prompt = getattr(obj, 'prompt', None)\n    if prompt is not None and not prompt._destroyed:\n        destroy(prompt)\n        obj.prompt = None\n    region = getattr(obj, 'region', None)\n    if region is not None:\n        indicator = region.get('promptIndicator')\n        if indicator is not None and not indicator._destroyed:\n            destroy(indicator)\n            region['promptIndicator'] = None\n    destroy(obj)\n\ndef set_object_alpha(obj, alpha):\n    _require_live_handle(obj, 'set_object_alpha')\n    _reject_player_handle(obj, 'set_object_alpha')\n    if isinstance(alpha, bool) or not isinstance(alpha, (int, float)) or alpha < 0 or alpha > 1 or alpha != alpha:\n        raise ValueError('set_object_alpha needs a finite number from 0 to 1.')\n    obj.alpha = alpha\n    obj.promptAlpha = alpha\n    for piece in _composite_pieces(obj):\n        piece.alpha = alpha\n    prompt = getattr(obj, 'prompt', None)\n    if prompt is not None:\n        prompt.alpha = alpha\n    region = getattr(obj, 'region', None)\n    if region is not None:\n        region['promptAlpha'] = alpha\n\ndef move_object(obj, *, at):\n    # Resolves at= as the new anchor center and translates every owned piece\n    # and movement-reference position by the same delta. A teleport of the\n    # placement, not per-frame platform motion - existing physics determines\n    # subsequent contact.\n    _require_live_handle(obj, 'move_object')\n    _reject_player_handle(obj, 'move_object')\n    new_x, new_y = _resolve_at(at)\n    dx = new_x - obj.x\n    dy = new_y - obj.y\n    _translate_owned(obj, dx, dy)\n\ndef _translate_owned(obj, dx, dy):\n    obj.x += dx\n    obj.y += dy\n    for piece in _composite_pieces(obj):\n        piece.x += dx\n        piece.y += dy\n    if hasattr(obj, 'spawnX'):\n        obj.spawnX += dx\n    if hasattr(obj, 'spawnY'):\n        obj.spawnY += dy\n    if hasattr(obj, 'startX'):\n        obj.startX += dx\n    if hasattr(obj, 'targetX'):\n        obj.targetX += dx\n    if hasattr(obj, 'startY'):\n        obj.startY += dy\n    if hasattr(obj, 'targetY'):\n        obj.targetY += dy\n\ndef _require_type(catalog, type, what):\n    # Every placement factory requires an explicit type - no catalog has a\n    # pack-configured default (ENEMY_DEFAULT_TYPE, the one exception, was\n    # removed as a source of hard-to-remember implicit behavior).\n    if type is None:\n        raise ValueError(f\"{what} needs an explicit type - assign one when authoring this content.\")\n    if type in catalog:\n        return catalog[type]\n    raise ValueError(f\"Unknown type {type!r} - expected one of {sorted(catalog.keys())}\")\n\ndef _require_str(value, what):\n    if not isinstance(value, str):\n        raise ValueError(f\"{what} needs a string.\")\n    return value"
            }
          },
          {
            "audio.py": {
              "type": "function script",
              "head": "# Sound playback, genre-neutral.\n\ndef _play_sound(name):\n    # name is a SOUNDS (generated from the active sound pack) key, not a filename.\n    entry = SOUNDS[name]\n    played = getattr(game, '_studio_sound_frames', {})\n    last = played.get(name)\n    if last is not None and game.frame - last < entry.get('cooldown', 0):\n        return\n    played[name] = game.frame\n    game._studio_sound_frames = played\n    clip = sound(entry['file'])\n    set_volume(clip, entry['volume'])\n    play_sound(clip)\n\ndef fade_sound(clip, from_volume, to_volume, frames, stop_at_end=False):\n    set_volume(clip, from_volume)\n    duration = max(1, int(frames))\n    if frames <= 0:\n        set_volume(clip, to_volume)\n        if stop_at_end:\n            stop_sound(clip)\n        return\n    fades = getattr(game, '_studio_sound_fades', [])\n    active = []\n    for fade in fades:\n        if fade['clip'] is not clip:\n            active.append(fade)\n    active.append({\n        'clip': clip,\n        'from': from_volume,\n        'to': to_volume,\n        'frames': duration,\n        'elapsed': 0,\n        'stop': stop_at_end,\n    })\n    game._studio_sound_fades = active\n\ndef _cancel_sound_fades(clip):\n    fades = getattr(game, '_studio_sound_fades', [])\n    game._studio_sound_fades = [fade for fade in fades if fade['clip'] is not clip]\n\ndef _update_sound_fades():\n    fades = getattr(game, '_studio_sound_fades', [])\n    active = []\n    for fade in fades:\n        fade['elapsed'] += 1\n        progress = min(1, fade['elapsed'] / fade['frames'])\n        volume = fade['from'] + (fade['to'] - fade['from']) * progress\n        set_volume(fade['clip'], volume)\n        if progress >= 1:\n            if fade['stop']:\n                stop_sound(fade['clip'])\n        else:\n            active.append(fade)\n    game._studio_sound_fades = active"
            }
          },
          {
            "camera.py": {
              "type": "function script",
              "head": "# Camera clamping and shake, genre-neutral.\n# Imported here for CameraShake's own use (its loop needs randint).\nimport random\n\ndef _clamped_camera(x, y):\n    # Keeps the camera inside cameraBounds (set by build_tilemap). A map narrower\n    # than the viewport is centred; a map shorter than it sits on the bottom edge.\n    # Unbounded if cameraBounds was never set.\n    bounds = getattr(game, 'cameraBounds', None)\n    if bounds is None:\n        return (x, y)\n    left, right, bottom, top = bounds\n    viewport = ENGINE_DEFAULTS['viewport']\n    view_w = viewport['width']\n    view_h = viewport['height']\n    if right - left <= view_w:\n        cx = (left + right) / 2\n    else:\n        cx = min(max(x, left + view_w / 2), right - view_w / 2)\n    if top - bottom <= view_h:\n        cy = bottom + view_h / 2\n    else:\n        cy = min(max(y, bottom + view_h / 2), top - view_h / 2)\n    return (cx, cy)\n\ndef _add_camera_shake():\n    return CameraShake()\n\ndef _on_screen(obj):\n    # True when any part of obj's sprite is inside the camera's view.\n    viewport = ENGINE_DEFAULTS['viewport']\n    return (abs(obj.x - camera_x()) * 2 < viewport['width'] + abs(get_width(obj))\n            and abs(obj.y - camera_y()) * 2 < viewport['height'] + abs(get_height(obj)))"
            }
          },
          {
            "dialog.py": {
              "type": "function script",
              "head": "# Narrative dialog box, genre-neutral. Lines are wrapped manually by\n# measuring each candidate line's rendered width.\n\ndef _validate_dialogue_lines(lines, what):\n    for index, line in enumerate(lines):\n        if isinstance(line, str):\n            continue\n        if not isinstance(line, dict) or not isinstance(line.get('text'), str):\n            raise ValueError(f\"{what} line {index + 1} needs a string or a dict with string 'text'.\")\n        speaker = line.get('speaker')\n        if speaker is not None and not isinstance(speaker, str):\n            raise ValueError(f\"{what} line {index + 1} needs 'speaker' to be a string when provided.\")\n\ndef _wrap_dialog(box, s):\n    maxWidth = abs(UI_CONFIG['dialog']['textOffsetX']) * 2\n    words = s.split(' ')\n    lines = []\n    current = ''\n    for word in words:\n        candidate = (current + ' ' + word) if current else word\n        box.messageText.text = candidate\n        if get_width(box.messageText) > maxWidth and current:\n            lines.append(current)\n            current = word\n        else:\n            current = candidate\n    if current:\n        lines.append(current)\n    return '\\n'.join(lines)\n\ndef _place_dialog_hint(box):\n    # Keeps the hint inside the box's bottom-right corner at its own size, whatever the zoom.\n    layout = UI_CONFIG['dialog']\n    box.hint.x = box.x + get_width(box) / 2 - layout['hintMarginX'] - get_width(box.hint) / 2\n    box.hint.y = box.y - get_height(box) / 2 + layout['hintMarginY'] + get_height(box.hint) / 2\n\ndef show_dialog(speaker, line):\n    box = getattr(game, 'dialogBox', None)\n    if box is None:\n        box = DialogBox()\n        game.dialogBox = box\n    box.speakerText.text = speaker or ''\n    box.fullText = _wrap_dialog(box, line)\n    box.talkCount = 0\n    if UI_CONFIG['dialog'].get('typeSpeed', 0) > 0:\n        box.revealed = 0\n        box.messageText.text = ''\n    else:\n        box.revealed = len(box.fullText)\n        box.messageText.text = box.fullText\n    box.visible = True\n\ndef _finish_dialog_typing():\n    # Shows the rest of a line that is still typing out; False when there was nothing left to show.\n    box = getattr(game, 'dialogBox', None)\n    if box is None or box.revealed >= len(box.fullText):\n        return False\n    box.revealed = len(box.fullText)\n    box.messageText.text = box.fullText\n    return True\n\ndef hide_dialog():\n    box = getattr(game, 'dialogBox', None)\n    if box is not None:\n        destroy(box.speakerText)\n        destroy(box.messageText)\n        if box.hint is not None:\n            destroy(box.hint)\n        destroy(box)\n        game.dialogBox = None\n    game.dialogOwner = None"
            }
          },
          {
            "sprites.py": {
              "type": "function script",
              "head": "# Pose loading/resolution, genre-neutral. A raw \"pose\" is a filename, a\n# (filename, frame) tuple, or a {sheet, start, end} range - SPRITES (config)\n# says how each filename slices into frames. Sprite-pack poses may wrap that\n# descriptor with art-facing metadata; _load_pose accepts both shapes.\n\ndef _tile_identity(sprite):\n    # A comparable (file, {frames}) identity for a tile's raw sprite\n    # descriptor - a single frame or an animated range - or None when it's\n    # neither (a bare filename, ...). Pack-compiled poses wrap the\n    # descriptor under 'pose' (see _load_pose above) - unwrap that first so\n    # a pack-bound type and a grid-imported type using the same frame(s)\n    # compare equal.\n    if isinstance(sprite, dict) and 'pose' in sprite:\n        sprite = sprite['pose']\n    if isinstance(sprite, (tuple, list)) and len(sprite) == 2:\n        return (sprite[0], {sprite[1]})\n    if isinstance(sprite, dict) and 'sheet' in sprite and 'start' in sprite and 'end' in sprite:\n        return (sprite['sheet'], set(range(sprite['start'], sprite['end'] + 1)))\n    return None\n\ndef _tile_identities_overlap(a, b):\n    # A raw grid duplicate is often just one static frame of what a real\n    # object animates through (e.g. one frame of a 2-frame waving flag) -\n    # same underlying art, so this matches on any shared frame, not\n    # identity equality.\n    if a is None or b is None:\n        return False\n    return a[0] == b[0] and bool(a[1] & b[1])\n\ndef _load_pose(file, fps=None):\n    # Pack-compiled poses carry the old descriptor under 'pose' plus the\n    # resolved art orientation. Raw descriptors remain supported for map\n    # imports and hand-authored engine data.\n    facing = 1\n    if isinstance(file, dict) and 'pose' in file:\n        facing = file.get('facing', 1)\n        file = file.get('pose')\n    if file is None:\n        return None\n    if isinstance(file, dict):\n        # A shared atlas sheet plus a contiguous frame range.\n        filename = file.get('sheet')\n        if filename is None:\n            return None\n        meta = SPRITES.get(filename, {'rows': 1, 'cols': 1})\n        resolved_fps = fps if fps is not None else file.get('fps', meta.get('fps', 15))\n        start = int(file.get('start', 0))\n        end = int(file.get('end', start))\n        sheet = sprite(filename, meta['rows'], meta['cols'])\n        return ('anim', animation(sheet, resolved_fps, start, end), facing)\n    if isinstance(file, tuple):\n        # (filename, frame_index) - one static frame cut from an atlas.\n        filename, frame = file\n        meta = SPRITES.get(filename, {'rows': 1, 'cols': 1})\n        sheet = sprite(filename, meta['rows'], meta['cols'])\n        return ('anim', animation(sheet, 0, frame, frame), facing)\n    meta = SPRITES.get(file, {'rows': 1, 'cols': 1})\n    resolved_fps = fps if fps is not None else meta.get('fps', 15)\n    sheet = sprite(file, meta['rows'], meta['cols'])\n    frames = meta['rows'] * meta['cols']\n    if frames > 1:\n        return ('anim', animation(sheet, resolved_fps, 0, frames - 1), facing)\n    return ('sprite', sheet, facing)\n\ndef _apply_pose(obj, pose):\n    if pose is None:\n        return\n    kind = pose[0]\n    data = pose[1]\n    # `artFacing` is metadata from the current pose, not the character's\n    # logical travel direction. A two-item runtime pose remains valid for\n    # older hand-authored callers and uses the neutral orientation.\n    obj.artFacing = pose[2] if len(pose) > 2 else 1\n    if kind == 'anim':\n        set_animation(obj, data)\n    else:\n        obj.sprite = data\n\ndef _resolve_pose(poses, wanted):\n    # Falls back to 'idle', then any defined pose, if `wanted` isn't set.\n    if wanted in poses:\n        return poses[wanted]\n    if 'idle' in poses:\n        return poses['idle']\n    for value in poses.values():\n        return value\n    return None\n\ndef _set_character_pose(obj, poses, wanted):\n    _apply_pose(obj, _load_pose(_resolve_pose(poses, wanted)))\n\ndef _pose_hitbox(sprite):\n    if isinstance(sprite, dict) and 'pose' in sprite:\n        return sprite.get('hitbox')\n    return None\n\ndef _hitbox_touches(obj, hitbox, other):\n    # hitbox fractions are measured from the unflipped art's top-left; world y points up.\n    w = abs(get_width(obj))\n    h = abs(get_height(obj))\n    left = 1 - hitbox['x'] - hitbox['width'] if obj.scaleX < 0 else hitbox['x']\n    top = 1 - hitbox['y'] - hitbox['height'] if obj.scaleY < 0 else hitbox['y']\n    cx = obj.x - w / 2 + (left + hitbox['width'] / 2) * w\n    cy = obj.y + h / 2 - (top + hitbox['height'] / 2) * h\n    return (abs(cx - other.x) * 2 < hitbox['width'] * w + abs(get_width(other))\n            and abs(cy - other.y) * 2 < hitbox['height'] * h + abs(get_height(other)))\n\n\ndef _apply_game_font(label):\n    # Gives a text object the game's font, when the project picked one.\n    font = UI_CONFIG.get('font')\n    if font:\n        label.font_family = font"
            }
          },
          {
            "tilemap.py": {
              "type": "function script",
              "head": "# Grid/legend/room-lifecycle machinery. Genre-neutral: this parses a level's\n# layers/legend/locations (see maps.py, project-owned, for LEGEND/MAPS and\n# the actual grids) and owns the room-visit lifecycle (enter/travel/events).\n# build_tilemap itself (which dispatches legend/object-spec entries to real\n# game object factories, including add_exit) is genre-specific and lives in\n# the active pack instead (packs/platformer/python/functions/grid.py).\n\n_ROOM_FIELDS = {\n    'layers', 'legend', 'tile_size', 'locations', 'background', 'objects',\n    'origin', 'bounds', 'camera', 'boundary', 'fall_margin',\n    'layer_names', 'layer_opacity', 'preserve_z_order',\n}\n\ndef _is_script_room(name):\n    return name in globals().get('SCRIPT_ROOMS', [])\n\ndef _require_room(name):\n    maps = globals().get('MAPS')\n    if not isinstance(maps, dict) or name not in maps:\n        raise ValueError(\n            f\"Cannot enter room {name!r} - no map registered for it in MAPS.\"\n        )\n    return maps[name]\n\ndef _require_destination(from_room, room, location):\n    if _is_script_room(room):\n        if location is not None:\n            raise ValueError(f\"Room {from_room!r} goes to script room {room!r}, which has no locations - leave the location out.\")\n        return\n    if room not in MAPS:\n        raise ValueError(f\"Room {from_room!r} has an exit to unknown room {room!r}.\")\n    _require_valid_location(from_room, room, location)\n\ndef _global_legend():\n    legend = globals().get('LEGEND')\n    if legend is None:\n        raise ValueError(\n            \"This map has no 'legend' and no global LEGEND is defined - \"\n            \"every map needs a resolvable legend.\"\n        )\n    return legend\n\ndef _with_layout(layout, overlay):\n    # Combines a converter-owned layout dict (legend/layers/tile_size/...,\n    # regenerated whenever a map directory's source is reconverted) with an\n    # authored overlay dict (objects/locations, plus any hand-added\n    # 'locations' like a travel anchor). No Python dict-unpacking syntax\n    # (Skulpt can't run `**dict` in a literal), so this is an ordinary\n    # function. 'locations' is merged (union) since both the layout\n    # (converter-generated names) and the overlay (hand-added names) can\n    # contribute entries; 'objects' concatenates - generated layout objects\n    # first, authored overlay objects after, per the converter-ownership\n    # contract (generated pickups vs. authored ones). Every other key is a\n    # plain overlay-wins override, since layout and overlay never otherwise\n    # share a key.\n    merged = dict(layout)\n    merged.update(overlay)\n    if 'locations' in layout or 'locations' in overlay:\n        locations = dict(layout.get('locations', {}))\n        locations.update(overlay.get('locations', {}))\n        merged['locations'] = locations\n    if 'objects' in layout or 'objects' in overlay:\n        merged['objects'] = list(layout.get('objects', [])) + list(overlay.get('objects', []))\n    return merged\n\ndef _finite_number(value):\n    return not isinstance(value, bool) and isinstance(value, (int, float)) and value == value and value not in (float('inf'), float('-inf'))\n\ndef _normalize_room(level_data):\n    # Full validation of one room's metadata dict against the canonical\n    # shape - see the implementation spec's room-metadata field table. No\n    # bare row-list/nested-layer-list shorthand, no entries/default_entry/\n    # spawn/point-legend-marker fields: those are removed, not silently\n    # ignored.\n    if not isinstance(level_data, dict):\n        raise ValueError(\"Map entries must be dictionaries - see the room-metadata contract.\")\n    unknown = level_data.keys() - _ROOM_FIELDS\n    if unknown:\n        raise ValueError(f\"Map has unsupported field(s) {sorted(unknown)!r}.\")\n    if 'layers' not in level_data:\n        raise ValueError(\"Map option 'layers' is required - [] means a world-authored room with no grid.\")\n    layers = level_data['layers']\n    if not isinstance(layers, list):\n        raise ValueError(\"Map option 'layers' must be a list of layers (each a list of row strings), or [].\")\n    has_grid = len(layers) > 0\n\n    legend = None\n    if has_grid:\n        legend = level_data['legend'] if 'legend' in level_data else _global_legend()\n    elif 'legend' in level_data:\n        legend = level_data['legend']\n\n    locations = level_data.get('locations', {})\n    if not isinstance(locations, dict):\n        raise ValueError(\"Map option 'locations' must be a dict of name to cell()/world().\")\n    for name, pos in locations.items():\n        if not isinstance(name, str) or name == '':\n            raise ValueError(\"Map 'locations' names must be non-empty strings.\")\n        if not _is_position(pos):\n            raise ValueError(f\"Map location {name!r} must be cell(row, col) or world(x, y).\")\n\n    background = level_data.get('background')\n    if background is None:\n        raise ValueError(\"Map option 'background' is required.\")\n\n    objects = level_data.get('objects', [])\n    if not isinstance(objects, list):\n        raise ValueError(\"Map option 'objects' must be a list.\")\n\n    origin = level_data.get('origin')\n    if origin is not None:\n        if not has_grid:\n            raise ValueError(\"Map option 'origin' needs a nonempty grid.\")\n        if not _is_position(origin) or origin['_posKind'] != 'cell':\n            raise ValueError(\"Map option 'origin' must be a cell(row, col) descriptor within the grid.\")\n\n    bounds = level_data.get('bounds')\n    if bounds is not None:\n        if has_grid:\n            raise ValueError(\"Map option 'bounds' is only for layers=[] (world-authored) rooms.\")\n        if not isinstance(bounds, dict) or set(bounds.keys()) != {'left', 'right', 'bottom', 'top'}:\n            raise ValueError(\"Map option 'bounds' needs exactly 'left', 'right', 'bottom', 'top'.\")\n        left, right, bottom, top = bounds['left'], bounds['right'], bounds['bottom'], bounds['top']\n        if not all(_finite_number(v) for v in (left, right, bottom, top)):\n            raise ValueError(\"Map option 'bounds' values must be finite numbers.\")\n        if left >= right or bottom >= top:\n            raise ValueError(\"Map option 'bounds' must have left < right and bottom < top.\")\n\n    has_extent = has_grid or bounds is not None\n    camera = level_data.get('camera', 'bounded' if has_extent else 'free')\n    if camera not in ('bounded', 'free'):\n        raise ValueError(\"Map option 'camera' must be 'bounded' or 'free'.\")\n    if camera == 'bounded' and not has_extent:\n        raise ValueError(\"Map option 'camera'='bounded' needs a grid or explicit 'bounds'.\")\n\n    boundary = level_data.get('boundary', has_extent)\n    if not isinstance(boundary, bool):\n        raise ValueError(\"Map option 'boundary' must be a bool.\")\n    if boundary and not has_extent:\n        raise ValueError(\"Map option 'boundary'=True needs a grid or explicit 'bounds'.\")\n\n    fall_margin = level_data.get('fall_margin')\n    if fall_margin is not None and (isinstance(fall_margin, bool) or not _finite_number(fall_margin) or fall_margin < 0):\n        raise ValueError(\"Map option 'fall_margin' must be a finite nonnegative number.\")\n\n    preserve_z_order = level_data.get('preserve_z_order', False)\n    layer_names = level_data.get('layer_names', [])\n    layer_opacity = level_data.get('layer_opacity', {})\n    tile_size = level_data.get('tile_size')\n    if tile_size is not None and (isinstance(tile_size, bool) or not _finite_number(tile_size) or tile_size <= 0):\n        raise ValueError(\"Map option 'tile_size' must be a positive number.\")\n\n    return {\n        'layers': layers, 'legend': legend, 'tile_size': tile_size,\n        'locations': locations, 'background': background, 'objects': objects,\n        'origin': origin, 'bounds': bounds, 'camera': camera, 'boundary': boundary,\n        'fall_margin': fall_margin, 'layer_names': layer_names,\n        'layer_opacity': layer_opacity, 'preserve_z_order': preserve_z_order,\n        'has_grid': has_grid,\n    }\n\ndef _parse_layers(layers, legend):\n    # Validates every layer, then sorts each cell into terrain or entities.\n    if not isinstance(layers[0], list) or not layers[0]:\n        raise ValueError(\"A tilemap needs at least one non-empty row.\")\n    if any(not isinstance(row, str) for row in layers[0]):\n        raise ValueError(\"Tilemap rows must be strings.\")\n    rows = len(layers[0])\n    cols = len(layers[0][0])\n    if cols == 0:\n        raise ValueError(\"Tilemap rows must not be empty.\")\n    for layer in layers:\n        if not isinstance(layer, list) or any(not isinstance(row, str) for row in layer):\n            raise ValueError(\"Tilemap layers must contain string rows.\")\n        if len(layer) != rows or any(len(row) != cols for row in layer):\n            raise ValueError(\"All layers within one map must have identical dimensions.\")\n\n    terrain_cells = []\n    entity_cells = []\n    for layer_idx, layer in enumerate(layers):\n        for row_idx, row_str in enumerate(layer):\n            for col_idx, token in enumerate(row_str):\n                if token is None or token == '.':\n                    continue\n                if token not in legend:\n                    raise ValueError(f\"Unknown legend token {token!r} at row {row_idx}, col {col_idx}.\")\n                entry = legend[token]\n                if entry is None:\n                    continue\n                category, type_name = entry\n                cell_pos = (row_idx, col_idx)\n                if category == 'platform':\n                    terrain_cells.append((cell_pos, type_name, layer_idx))\n                else:\n                    entity_cells.append((cell_pos, category, type_name, layer_idx))\n    return rows, cols, terrain_cells, entity_cells\n\ndef _cell_center(row, col, rows):\n    # Row 0 is the top. A cell's centre is its world position, matching\n    # every placement factory's own convention.\n    return (col * CELL, (rows - 1 - row) * CELL)\n\ndef xy(row, col):\n    # Converts a top-down map row/column into this room's world-space (x, y)\n    # centre, right now - unlike cell(), which builds an inert reference\n    # resolved later. Requires grid metadata (a nonempty grid built by\n    # build_tilemap()); an advanced conversion, not a second placement form.\n    rows = getattr(game, 'mapRows', None)\n    cols = getattr(game, 'mapCols', None)\n    if rows is None or cols is None:\n        raise ValueError('xy() needs build_tilemap() to have run for a room with a nonempty grid.')\n    if not isinstance(row, int) or not isinstance(col, int) or row < 0 or row >= rows or col < 0 or col >= cols:\n        raise ValueError('xy(row, col) needs a whole cell inside this map.')\n    x, y = _cell_center(row, col, rows)\n    return (x - getattr(game, 'originX', 0), y - getattr(game, 'originY', 0))\n\ndef _room_locations(room):\n    # A room's declared 'locations' names, without building it - used to\n    # validate a travel/start destination before it's ever reached.\n    normalized = _normalize_room(_require_room(room))\n    return set(normalized['locations'].keys())\n\ndef _require_valid_location(from_room, to_room, location):\n    if not isinstance(location, str) or location == '':\n        raise ValueError(f\"Room {from_room!r} needs a location name string, not {location!r}.\")\n    if location not in _room_locations(to_room):\n        raise ValueError(\n            f\"Room {from_room!r} travels to {to_room!r} location {location!r}, \"\n            \"not declared in that room's 'locations'.\"\n        )\n\ndef _exit_destination(destination):\n    # An exit's destination: None ends the game, a room name is a script\n    # room, and (room, location) is a map room.\n    if destination is None:\n        return None, None\n    if isinstance(destination, str):\n        return destination, None\n    if isinstance(destination, (tuple, list)) and len(destination) == 2:\n        return destination[0], destination[1]\n    raise ValueError(\"An exit's destination must be None, a script room name, or (room, location).\")\n\ndef _validate_static_exit_destinations():\n    # Every statically-declared ('objects' list) exit destination is\n    # checked before any room runs, so a typo'd destination fails at boot.\n    # A destination built at runtime is checked by add_exit itself.\n    for room, level_data in MAPS.items():\n        normalized = _normalize_room(level_data)\n        for spec in normalized['objects']:\n            if not isinstance(spec, dict) or spec.get('category') != 'exit':\n                continue\n            to_room, to_location = _exit_destination(spec.get('destination'))\n            if to_room is not None:\n                _require_destination(room, to_room, to_location)\n\ndef _validate_start(room, location):\n    if not room:\n        raise ValueError(\"Manifest needs a non-empty startRoom.\")\n    if _is_script_room(room):\n        return\n    if not location:\n        raise ValueError(\"Manifest needs a non-empty startLocation.\")\n    if room not in MAPS:\n        raise ValueError(f\"Start room {room!r} is not registered in MAPS.\")\n    _require_valid_location('(start)', room, location)\n\ndef _validate_title(room):\n    if not _is_script_room(room):\n        raise ValueError(f\"Title room {room!r} must be a script room.\")\n\ndef _fresh_listeners():\n    return {'collect': [], 'gameFinished': [], 'enemyDefeated': [], 'playerHit': []}\n\ndef _stop_room_music():\n    current_music = getattr(game, '_studio_room_music', None)\n    if current_music is not None:\n        _cancel_sound_fades(current_music)\n        stop_sound(current_music)\n    game._studio_room_music = None\n    game._studio_room_music_volume = 0\n\ndef _resume_room_music():\n    current_music = getattr(game, '_studio_room_music', None)\n    if current_music is None:\n        return\n    _cancel_sound_fades(current_music)\n    set_volume(current_music, getattr(game, '_studio_room_music_volume', 0))\n\ndef _start_room_music(name, preserve_current=False):\n    if preserve_current:\n        _resume_room_music()\n        return\n    _stop_room_music()\n    music = globals().get('ROOM_MUSIC', {}).get(name)\n    if music is None:\n        return\n    game._studio_room_music = sound(music['file'])\n    set_volume(game._studio_room_music, 0)\n    loop_sound(game._studio_room_music)\n    fade_sound(game._studio_room_music, 0, music['volume'], 30)\n    game._studio_room_music_volume = music['volume']\n\ndef _enter_room(name, location, preserve_music=False):\n    # The only caller of set_room() - every room change routes through here\n    # so room-entry state resets exactly once before that room's start() runs.\n    _require_destination('(travel)', name, location)\n    game.room = name\n    game.arrivalLocation = location\n    game.visitToken = getattr(game, 'visitToken', 0) + 1\n    game.byCategoryType = {}\n    game.instances = {}\n    game.reservedIds = set()\n    game.reservedRememberAs = set()\n    game.appearing = []\n    game.locations = {}\n    game.listeners = _fresh_listeners()\n    game.interactSeq = 0\n    game.interactFrame = None\n    game.interactTarget = None\n    game.mapSpawn = None\n    game.dialogBox = None\n    game.dialogOwner = None\n    game.mapBottom = None\n    game.fallMarginOverride = None\n    game.cameraBounds = None\n    game.tilemapBuilt = False\n    game.playerSpawnedThisVisit = False\n    game.hitStop = 0\n    game.pendingTransition = False\n    game.pendingFade = None\n    game.finished = False\n    game.player = None\n    game.mapRows = None\n    game.mapCols = None\n    game.originX = 0\n    game.originY = 0\n    # Reset so a room that never calls build_tilemap doesn't inherit a\n    # stale tile size from whichever room ran before it.\n    global CELL\n    CELL = ENGINE_DEFAULTS['tilemap']['defaultCell']\n    viewport = ENGINE_DEFAULTS['viewport']\n    set_camera_size(viewport['width'], viewport['height'])\n    if _is_script_room(name):\n        set_camera(0, 0)\n    _start_room_music(name, preserve_current=preserve_music)\n    set_room(name)\n\ndef arrival_location():\n    # The named destination for the entire visit - not cleared by\n    # spawn_player(); an explicit spawn_player(at=...) changes actual\n    # position, not this name.\n    return getattr(game, 'arrivalLocation', None)\n\ndef go_to_room(room, location=None):\n    # Freezes the player and fades to black. A map room needs a location; a\n    # script room takes none. Both names must resolve before a fade is\n    # created; a second valid request while a fade is pending is ignored.\n    _require_destination(game.room, room, location)\n    if getattr(game, 'pendingTransition', False):\n        return\n    current_music = getattr(game, '_studio_room_music', None)\n    if current_music is not None:\n        _cancel_sound_fades(current_music)\n        fade_sound(current_music, getattr(game, '_studio_room_music_volume', 0), 0, 30)\n    game.pendingTransition = True\n    if game.player is not None:\n        game.player.frozen = True\n    fade = FadeOut()\n    fade.nextRoom = room\n    fade.nextLocation = location\n    game.pendingFade = fade\n\ndef start_game():\n    # Goes to the game's start room and point, as go_to_room does: what a title screen calls to begin.\n    go_to_room(game.startRoom, game.startLocation)\n\ndef on_collect(callback):\n    return _on_event('collect', callback)\n\ndef on_game_finished(callback):\n    return _on_event('gameFinished', callback)\n\ndef on_enemy_defeated(callback):\n    return _on_event('enemyDefeated', callback)\n\ndef on_player_hit(callback):\n    return _on_event('playerHit', callback)\n\ndef _on_event(name, callback):\n    if not callable(callback):\n        raise ValueError(f\"on_{name} needs a callable.\")\n    listeners = game.listeners[name]\n    for existing in listeners:\n        if existing is callback:\n            def _unsub_existing():\n                if callback in listeners:\n                    listeners.remove(callback)\n            return _unsub_existing\n    listeners.append(callback)\n    def _unsub():\n        if callback in listeners:\n            listeners.remove(callback)\n    return _unsub\n\ndef _dispatch(name, *args):\n    # Dispatches a snapshot in registration order; adding/removing listeners\n    # during dispatch affects only the next event. A room transition, death,\n    # or an exception aborts the remaining snapshot immediately.\n    token = game.visitToken\n    for cb in list(game.listeners[name]):\n        cb(*args)\n        if game.visitToken != token or getattr(game, 'pendingTransition', False):\n            return"
            }
          },
          {
            "controls.py": {
              "type": "function script",
              "head": "# Every CONTROLS action is a list of keys; pressing any of them triggers it. A name starting\n# with 'mouse' is a mouse button instead: 'mouseleft' or 'mouseright'.\n\ndef _input_is_pressed(key):\n    return mouse_is_pressed(key[5:]) if key.startswith('mouse') else key_is_pressed(key)\n\n\ndef _input_was_pressed(key):\n    return mouse_was_pressed(key[5:]) if key.startswith('mouse') else key_was_pressed(key)\n\n\ndef _input_was_released(key):\n    return mouse_was_released(key[5:]) if key.startswith('mouse') else key_was_released(key)\n\n\ndef _control_is_pressed(action):\n    return any(_input_is_pressed(key) for key in CONTROLS[action])\n\n\ndef _control_was_pressed(action):\n    return any(_input_was_pressed(key) for key in CONTROLS[action])\n\n\ndef _control_was_released(action):\n    return any(_input_was_released(key) for key in CONTROLS[action])"
            }
          },
          {
            "player.py": {
              "type": "function script",
              "head": "# Player lifecycle - spawn (fresh start and mid-game respawn/entry),\n# damage, and death/respawn.\n\ndef _follow_player_camera(x, y):\n    target_x, target_y = _clamped_camera(x, y)\n    camera_y = getattr(game, '_platformer_camera_y', target_y)\n    camera_y += (target_y - camera_y) * 0.1\n    _, camera_y = _clamped_camera(target_x, camera_y)\n    game._platformer_camera_y = camera_y\n    return target_x, camera_y\n\n\ndef _add_life_icon(index, x, y):\n    livesLayout = UI_CONFIG['lives']\n    life = Life()\n    life.index = index\n    life.x = x + livesLayout['x'] + index * (get_width(life) + livesLayout['gap'])\n    life.y = y + livesLayout['y']\n    game.hud_lives.append(life)\n\n\ndef _spawn_lives_hud(px, py):\n    # One icon per health point, with a backdrop behind them.\n    for i in range(min(_max_health(), UI_CONFIG['lives'].get('displayLimit', 10))):\n        _add_life_icon(i, px, py)\n    game.hud_lives_backdrop = LivesBackdrop()\n\n\ndef spawn_player(*, at=None):\n    # An explicit position works exactly like every add_*() factory's at=\n    # form. With no position at all, resolves to this room visit's\n    # arrival_location(). Requires build_tilemap() to have already run this\n    # visit, and can only be called once per visit. During a death respawn,\n    # the checkpointed world coordinates take precedence over any at=\n    # evaluated by the room script - at= is still validated (so a broken\n    # room script errors even during respawn), just not used for position.\n    if not getattr(game, 'tilemapBuilt', False):\n        raise ValueError('spawn_player() needs build_tilemap() to run first.')\n    if getattr(game, 'playerSpawnedThisVisit', False):\n        raise ValueError('spawn_player() was already called once this room visit.')\n\n    if at is not None:\n        candidate = _resolve_at(at)\n    else:\n        candidate = None\n\n    respawn = getattr(game, 'respawnCheckpoint', None)\n    if respawn is not None and respawn['coords'] is not None:\n        px, py = respawn['coords']\n    elif candidate is not None:\n        px, py = candidate\n    else:\n        name = game.arrivalLocation\n        if name not in game.locations:\n            raise ValueError(f\"No location named {name!r} on this room - check 'locations' in maps.py.\")\n        px, py = game.locations[name]\n\n    background_name = getattr(game, 'mapBackground', None)\n    background_pose = None if background_name == '__studio_black__' else _require_type(\n        BACKGROUND_TYPES, background_name, \"this room's background\"\n    )\n\n    p = Player()\n    p._isPlayer = True\n    p.x = px\n    p.y = py\n    # Set here directly so a same-frame collision check never reads a\n    # stale hitbox position before the player's own loop first runs.\n    p.hitbox.x = px\n    p.hitbox.y = py + p.hitboxOffsetY\n    game.player = p\n    # Brief grace window so freshly-constructed enemies/hazards can't hit\n    # the player before a real frame has passed.\n    p.invulnerable = 10\n    cx, cy = _clamped_camera(px, py)\n    game._platformer_camera_y = cy\n    set_camera(cx, cy)\n    FadeIn()\n    game.bg = Background()\n    if background_pose is not None:\n        _apply_pose(game.bg, _load_pose(background_pose))\n        game.bg.visible = True\n    game.hud_lives = []\n    game.hud_lives_backdrop = None\n    if UI_CONFIG['lives']['icon'] is not None:\n        _spawn_lives_hud(px, py)\n    _spawn_player_indicators(p)\n    _spawn_combat_hud(p)\n    if not hasattr(game, 'counter'):\n        game.counter = 0\n    if not hasattr(game, 'meter'):\n        game.meter = 0\n    if not hasattr(game, 'unlocked'):\n        game.unlocked = []\n    if not hasattr(game, 'persisted'):\n        game.persisted = {}\n    if not hasattr(game, 'globals'):\n        game.globals = {}\n\n    # A death respawn re-applies its pre-death checkpoint values once more\n    # here, so any set_global/counter call a room-start script made during\n    # reconstruction (discouraged - see the guide) can't accumulate or\n    # redefine the checkpoint.\n    if respawn is not None:\n        game.counter = respawn['counter']\n        game.meter = respawn['meter']\n        game.persisted = {name: set(values) for name, values in respawn['persisted'].items()}\n        game.globals = dict(respawn['globals'])\n        game.respawnCheckpoint = None\n\n    # Every room is a save point - death restores this checkpoint, not zero.\n    game.counterCheckpoint = game.counter\n    game.meterCheckpoint = game.meter\n    game.persistedCheckpoint = {name: set(values) for name, values in game.persisted.items()}\n    game.globalsCheckpoint = dict(game.globals)\n    game.spawnCheckpoint = (px, py)\n    game.arrivalCheckpoint = game.arrivalLocation\n    if UI_CONFIG['counter']['icon'] is None:\n        game.hud_counter = None\n    else:\n        game.hud_counter = Counter()\n    fall_override = getattr(game, 'fallMarginOverride', None)\n    if fall_override is not None:\n        p.fallMargin = fall_override\n    game.playerSpawnedThisVisit = True\n    return p\n\n\ndef _flash_player_hurt(player):\n    player.invulnerable = player.invulnerableFrames\n    if player.damageFilterId is not None:\n        remove_filter(player, player.damageFilterId)\n    player.damageFilterId = add_filter(player, new_adjustment_filter({ 'contrast': 0, 'brightness': 5 }))\n    player.damageFlashTimer = player.damageFlashFrames\n\n\ndef _stands_on_safe_ground(player, solids):\n    # Safe ground is still Platform under both of the player's feet, away from\n    # hazards: a barrier can open and a moving platform moves.\n    if get_collision(player.hitbox, 'Hazard'):\n        return False\n    halfWidth = get_width(player.hitbox) / 2\n    left = player.hitbox.x - halfWidth\n    right = player.hitbox.x + halfWidth\n    leftSupported = False\n    rightSupported = False\n    for solid in solids:\n        if getattr(solid, 'moving', None) is not False or solid.y >= player.hitbox.y:\n            continue\n        solidHalfWidth = get_width(solid) / 2\n        if solid.x - solidHalfWidth <= left <= solid.x + solidHalfWidth:\n            leftSupported = True\n        if solid.x - solidHalfWidth <= right <= solid.x + solidHalfWidth:\n            rightSupported = True\n    return leftSupported and rightSupported\n\n\ndef _fall_to_safe_ground(player):\n    # A fall costs one heart and puts the player back on the last still,\n    # hazard-free ground they stood on in this room. Falling with the last\n    # heart, or before standing anywhere, restarts the room like any death.\n    if player.health <= 1 or player.safeGround is None:\n        _respawn_player()\n        return\n    player.health -= 1\n    _end_dash(player)\n    _cancel_heal(player)\n    player.x, player.y = player.safeGround\n    player.dx = 0\n    player.dy = 0\n    player.moveLocked = True\n    _flash_player_hurt(player)\n    _play_sound('hurt')\n    _add_camera_shake()\n    _dispatch('playerHit', player, 1)\n\n\ndef _damage_player(amount, source=None):\n    # source, if given, is the enemy/hazard that hit the player - used to\n    # point knockback away from it.\n    player = game.player\n    if player.invulnerable > 0 or player.frozen:\n        return\n    player.health -= amount\n    _end_dash(player)\n    # A hit knocks the player off a ladder.\n    if player.climbing:\n        player.climbing = False\n        player.climbRegrabTimer = CLIMB_REGRAB_FRAMES\n    _cancel_heal(player)\n    _flash_player_hurt(player)\n    if source is not None:\n        direction = 1 if player.x >= source.x else -1\n        player.x += direction * player.knockbackX\n        player.dy = player.knockbackY\n    if player.health > 0:\n        _play_sound('hurt')\n    _add_camera_shake()\n    # A player_hit listener that raises must not leave health<=0 playable -\n    # death cleanup runs in `finally`, before the exception re-raises, so a\n    # callback bug can't skip checkpoint restore/fade cancellation.\n    try:\n        _dispatch('playerHit', player, amount)\n    finally:\n        if player.health <= 0:\n            _respawn_player()\n\n\ndef _respawn_player():\n    # Death is instant, not faded - a full room restart from scratch. Copies\n    # the existing checkpoint, restores its gameplay values immediately (so\n    # switches/collectibles rebuilt during reconstruction read the correct\n    # restored globals), rebuilds the same room at the same arrival, and\n    # supplies the checkpointed world coordinates to spawn_player. Any\n    # pending room change this same hit triggered is cancelled - death wins.\n    _play_sound('death')\n    checkpoint = {\n        'counter': getattr(game, 'counterCheckpoint', 0),\n        'meter': getattr(game, 'meterCheckpoint', 0),\n        'persisted': {name: set(values) for name, values in getattr(game, 'persistedCheckpoint', {}).items()},\n        'globals': dict(getattr(game, 'globalsCheckpoint', {})),\n        'coords': getattr(game, 'spawnCheckpoint', None),\n        'arrival': getattr(game, 'arrivalCheckpoint', None),\n    }\n    game.counter = checkpoint['counter']\n    game.meter = checkpoint['meter']\n    game.persisted = {name: set(values) for name, values in checkpoint['persisted'].items()}\n    game.globals = dict(checkpoint['globals'])\n    game.respawnCheckpoint = checkpoint\n    pending_fade = getattr(game, 'pendingFade', None)\n    if pending_fade is not None and not pending_fade._destroyed:\n        destroy(pending_fade)\n    game.pendingFade = None\n    game.pendingTransition = False\n    _enter_room(game.room, checkpoint['arrival'], preserve_music=True)\n\n\n# === Climbing ===\n# Ladders, vines and ropes (add_climbable). Up or down grabs one the player\n# overlaps; down also grabs from standing on the top one. While climbing,\n# gravity is off and every direction moves at climbSpeed. Jump lets go.\n\n# Frames after letting go before holding up grabs again, so a jump off a\n# ladder isn't caught by the same ladder.\nCLIMB_REGRAB_FRAMES = 12\n\n\ndef _live_climbables():\n    found = []\n    for key, objects in game.byCategoryType.items():\n        if key[0] == 'climbable':\n            found += [obj for obj in objects if not obj._destroyed]\n    return found\n\n\ndef _climbable_top(climbable, climbables):\n    # The top of a column: nothing climbable directly above it.\n    width = get_width(climbable) / 2\n    height = get_height(climbable)\n    for other in climbables:\n        if other is not climbable and abs(other.x - climbable.x) < width and 0 < other.y - climbable.y <= height * 1.01:\n            return False\n    return True\n\n\ndef _touching_climbable(player):\n    return any(not obj._destroyed for obj in get_collision_list(player.hitbox, 'Climbable'))\n\n\ndef _feet(player):\n    return player.y + player.hitboxOffsetY - get_height(player.hitbox) / 2\n\n\ndef _land_on_climbable_top(player, previousFeet):\n    # The top of a ladder is a floor the player can drop through by climbing down.\n    # Looks 3 px below the feet too, since collisions miss overlaps of 2 px or less.\n    if player.climbing or player.dy > 0:\n        return\n    feet = _feet(player)\n    halfWidth = get_width(player.hitbox) / 2\n    climbables = _live_climbables()\n    for climbable in climbables:\n        top = climbable.y + get_height(climbable) / 2\n        if abs(climbable.x - player.x) >= halfWidth + get_width(climbable) / 2 - 1:\n            continue\n        if previousFeet < top - 3 or feet > top or not _climbable_top(climbable, climbables):\n            continue\n        player.y += top - feet\n        player.dy = 0\n        player.onGround = True\n        player.climbableBelow = climbable\n        return\n\n\ndef _step_climbing(player):\n    # Runs before gravity: starts, steers and ends a climb.\n    player.climbJumped = False\n    up = _control_is_pressed('aimUp')\n    down = _control_is_pressed('aimDown')\n    if player.climbRegrabTimer > 0:\n        player.climbRegrabTimer -= 1\n    if not player.climbing:\n        standingOnTop = player.onGround and player.climbableBelow is not None and not player.climbableBelow._destroyed\n        if down and standingOnTop:\n            # Step into the ladder below so the climb overlaps it.\n            player.y -= 4\n            player.hitbox.y = player.y + player.hitboxOffsetY\n        elif not ((up and player.climbRegrabTimer <= 0) or (down and not player.onGround)):\n            return\n        if not _touching_climbable(player):\n            return\n        _end_dash(player)\n        player.climbing = True\n        player.jumped = False\n    elif not _touching_climbable(player):\n        player.climbing = False\n        player.dy = 0\n        return\n    if _control_was_pressed('jump'):\n        player.climbing = False\n        player.climbJumped = True\n        player.climbRegrabTimer = CLIMB_REGRAB_FRAMES\n        player.dy = 0 if down else player.jumpSpeed\n        player.jumped = True\n        player.bufferTimer = 0\n        if not down:\n            _play_sound('jump')\n        return\n    speed = PLAYER_CONFIG['climbSpeed']\n    player.dy = speed * ((1 if up else 0) - (1 if down else 0))\n    player.dx = speed * ((1 if _control_is_pressed('moveRight') else 0) - (1 if _control_is_pressed('moveLeft') else 0))\n    if player.dx != 0:\n        player.facing = 1 if player.dx > 0 else -1"
            }
          },
          {
            "abilities.py": {
              "type": "function script",
              "head": "# Opt-in player abilities (ABILITIES_CONFIG): dash, air jump and wall jump. An ability does\n# nothing unless it is enabled, its `requires` global (if it names one) is on, and, when it\n# comes from a pickup, the player has one.\n\n\ndef _requirement_met(requires):\n    return requires == '' or get_global(requires) is True\n\n\ndef _ability_active(name):\n    ability = ABILITIES_CONFIG[name]\n    return ability['enabled'] == 1 and _requirement_met(ability['requires']) and _unlocked(name)\n\n\ndef _dash_ready(player):\n    if player.dashCooldownTimer > 0:\n        return False\n    return ABILITIES_CONFIG['dash']['style'] != 'eightWay' or player.dashCharges > 0\n\n\ndef _dash_direction(player):\n    # Burst dashes the way the player faces. Eight-way dashes the way the player holds,\n    # diagonals included, and the way they face when nothing is held.\n    if ABILITIES_CONFIG['dash']['style'] != 'eightWay':\n        return player.facing, 0\n    x = (1 if _control_is_pressed('moveRight') else 0) - (1 if _control_is_pressed('moveLeft') else 0)\n    y = (1 if _control_is_pressed('aimUp') else 0) - (1 if _control_is_pressed('aimDown') else 0)\n    if x == 0 and y == 0:\n        return player.facing, 0\n    if x != 0 and y != 0:\n        return x * 0.7071, y * 0.7071\n    return x, y\n\n\ndef _start_dash(player):\n    if not _ability_active('dash') or player.dashing or player.climbing or not _dash_ready(player):\n        return\n    if not _control_was_pressed('dash'):\n        return\n    dash = ABILITIES_CONFIG['dash']\n    player.dashing = True\n    player.dashX, player.dashY = _dash_direction(player)\n    if player.dashX != 0:\n        player.facing = 1 if player.dashX > 0 else -1\n    player.dashFramesLeft = dash['frames']\n    player.dashCooldownTimer = dash['cooldown']\n    player.dashCharges = max(player.dashCharges - 1, 0)\n    player.dy = 0\n    if _ability_active('airJump') and ABILITIES_CONFIG['airJump']['refill'] == 'dash':\n        player.airJumps = min(player.airJumps + 1, ABILITIES_CONFIG['airJump']['count'])\n    _play_sound('dash')\n\n\ndef _end_dash(player):\n    if not player.dashing:\n        return\n    player.dashing = False\n    player.dx = max(-player.maxSpeed, min(player.maxSpeed, player.dx))\n    if player.dy > 0:\n        player.dy = min(player.dy, player.jumpSpeed * 0.5)\n\n\ndef _dash_dy(player):\n    # The vertical speed while dashing: none for a sideways dash, so gravity is off.\n    return ABILITIES_CONFIG['dash']['speed'] * player.dashY\n\n\ndef _refill_on_ground(player):\n    if not player.onGround:\n        return\n    if ABILITIES_CONFIG['airJump']['refill'] == 'landing':\n        player.airJumps = ABILITIES_CONFIG['airJump']['count']\n    if not player.dashing:\n        player.dashCharges = ABILITIES_CONFIG['dash']['charges']\n\n\ndef _refill_abilities(player):\n    # A stomp or a melee bounce gives back every air jump and the dash.\n    if _ability_active('airJump'):\n        player.airJumps = ABILITIES_CONFIG['airJump']['count']\n    player.dashCharges = ABILITIES_CONFIG['dash']['charges']\n    player.dashCooldownTimer = 0\n\n\ndef _show_dash_ready(player):\n    # The player turns grey while the dash can't be used.\n    grey = _ability_active('dash') and not _dash_ready(player)\n    if grey and player.dashFilterId is None:\n        player.dashFilterId = add_filter(player, new_adjustment_filter({ 'saturation': 0, 'contrast': 1, 'gamma': 0.8, 'brightness': 0.85 }))\n    elif not grey and player.dashFilterId is not None:\n        remove_filter(player, player.dashFilterId)\n        player.dashFilterId = None\n\n\ndef _step_abilities(player):\n    # Runs once a frame after the vertical move, so onGround is this frame's.\n    _refill_on_ground(player)\n    if player.dashCooldownTimer > 0:\n        player.dashCooldownTimer -= 1\n    if player.dashing:\n        player.dx = ABILITIES_CONFIG['dash']['speed'] * player.dashX\n        player.dashFramesLeft -= 1\n        if player.dashFramesLeft <= 0:\n            _end_dash(player)\n    _show_dash_ready(player)\n\n\ndef _dash_protects(player):\n    # With Safe while dashing on, enemies and their shots can't hurt a dashing player.\n    # Hazards and falls still do.\n    return player.dashing and ABILITIES_CONFIG['dash']['safe'] == 1\n\n\ndef _try_air_jump(player):\n    if not _ability_active('airJump') or player.onGround or player.airJumps <= 0:\n        return False\n    player.airJumps -= 1\n    _end_dash(player)\n    player.dy = player.jumpSpeed\n    player.jumped = True\n    player.coyoteTimer = 0\n    player.bufferTimer = 0\n    player.sqX = player.jumpSquashX\n    player.sqY = player.jumpSquashY\n    _play_sound('jump')\n    return True\n\n\n# Frames after leaving a wall that a jump still kicks off it.\nWALL_JUMP_GRACE_FRAMES = 6\n\n\ndef _wall_side(player):\n    # Which side a wall touches the player's hitbox on: -1 left, 1 right, 0 none. A floor or\n    # ceiling tile beside the player doesn't count. The room's invisible edge walls are EdgeWalls, so they aren't checked.\n    side_found = 0\n    hitbox_height = get_height(player.hitbox)\n    for side in (-1, 1):\n        # get_collision_list misses overlaps of 2 px or less, so look 3 px out.\n        player.hitbox.x = player.x + side * 3\n        for solid in _live_solids(player.hitbox):\n            beside = (solid.x - player.x) * side > 0\n            overlap = (hitbox_height + get_height(solid)) / 2 - abs(solid.y - player.hitbox.y)\n            if beside and overlap > 3:\n                side_found = side\n    player.hitbox.x = player.x\n    return side_found\n\n\ndef _step_wall_contact(player):\n    # Runs after the sideways move, so the wall check sees where the player ended up.\n    if player.onGround or not _ability_active('wallJump'):\n        player.wallTimer = 0\n        return\n    side = _wall_side(player)\n    if side != 0:\n        player.wallSide = side\n        player.wallTimer = WALL_JUMP_GRACE_FRAMES\n    elif player.wallTimer > 0:\n        player.wallTimer -= 1\n\n\ndef _try_wall_jump(player):\n    if player.wallTimer <= 0 or player.onGround or not _ability_active('wallJump'):\n        return False\n    _end_dash(player)\n    player.facing = -player.wallSide\n    player.dx = player.facing * ABILITIES_CONFIG['wallJump']['speed']\n    player.dy = player.jumpSpeed\n    player.wallKickTimer = ABILITIES_CONFIG['wallJump']['frames']\n    player.wallTimer = 0\n    player.jumped = True\n    player.coyoteTimer = 0\n    player.bufferTimer = 0\n    player.sqX = player.jumpSquashX\n    player.sqY = player.jumpSquashY\n    _play_sound('jump')\n    return True\n\n\ndef _spawn_player_indicators(player):\n    # Icons that float above the player and show a count, e.g. air jumps left. Each entry of\n    # UI_CONFIG['playerIndicators'] names the player attribute to show and the one holding its maximum.\n    if ABILITIES_CONFIG['airJump']['enabled'] != 1:\n        return\n    for spec in UI_CONFIG.get('playerIndicators', {}).values():\n        total = int(getattr(player, spec['max']))\n        for index in range(total):\n            icon = PlayerIndicator()\n            icon.spec = spec\n            icon.index = index\n            icon.total = total\n            _apply_pose(icon, _load_pose(spec['icon']))"
            }
          },
          {
            "combat.py": {
              "type": "function script",
              "head": "# Melee attacks, hit-stop, stagger, shooting limits, the meter, healing, pickup effects and unlocks.\n# Each reads COMBAT_CONFIG and changes nothing while its setting is off.\n\n\ndef _melee_on():\n    return COMBAT_CONFIG['melee'] == 1\n\n\ndef _hit_stopped():\n    return getattr(game, 'hitStop', 0) > 0\n\n\ndef _step_hit_stop():\n    # The player counts the freeze down, so it runs exactly once per frame.\n    if not _hit_stopped():\n        return False\n    game.hitStop -= 1\n    return True\n\n\ndef _swing_frames():\n    return COMBAT_CONFIG['windupFrames'] + COMBAT_CONFIG['activeFrames'] + COMBAT_CONFIG['recoveryFrames']\n\n\ndef _attack_direction(player):\n    if not _unlocked('upDown'):\n        return 'side'\n    if COMBAT_CONFIG['upAttack'] == 1 and _control_is_pressed('aimUp'):\n        return 'up'\n    if COMBAT_CONFIG['downAttack'] == 1 and not player.onGround and _control_is_pressed('aimDown'):\n        return 'down'\n    return 'side'\n\n\ndef _start_attack(player):\n    if not _melee_on() or not _unlocked('melee') or player.attackTimer > 0 or not _control_was_pressed('attack'):\n        return\n    strike = Strike()\n    pose = _load_pose(PLAYER_CONFIG['poses'].get('strike'))\n    strike.hasArt = pose is not None\n    _apply_pose(strike, pose)\n    strike.direction = _attack_direction(player)\n    strike.facing = player.facing\n    strike.visible = False\n    strike.hitbox = StrikeHitbox()\n    player.strike = strike\n    player.attackTimer = _swing_frames()\n    _place_strike(player, strike)\n\n\ndef _strike_size(player, strike):\n    if strike.hasArt:\n        return abs(get_width(strike)), abs(get_height(strike))\n    return abs(get_width(player.hitbox)), abs(get_height(player.hitbox))\n\n\ndef _place_strike(player, strike):\n    # Strike art points right; up and down attacks turn it, so its length runs along the attack.\n    length, thickness = _strike_size(player, strike)\n    halfWidth = abs(get_width(player.hitbox)) / 2\n    halfHeight = abs(get_height(player.hitbox)) / 2\n    if strike.direction == 'side':\n        strike.x = player.hitbox.x + strike.facing * (halfWidth + length / 2)\n        strike.y = player.hitbox.y\n        strike.angle = 0\n        strike.scaleX = getattr(strike, 'artFacing', 1) * strike.facing\n        boxWidth, boxHeight = length, thickness\n    else:\n        sign = 1 if strike.direction == 'up' else -1\n        strike.x = player.hitbox.x\n        strike.y = player.hitbox.y + sign * (halfHeight + length / 2)\n        strike.angle = 90 * sign\n        strike.scaleX = getattr(strike, 'artFacing', 1)\n        boxWidth, boxHeight = thickness, length\n    box = strike.hitbox\n    box.scaleX = boxWidth / box.baseWidth\n    box.scaleY = boxHeight / box.baseHeight\n    box.x = strike.x\n    box.y = strike.y\n\n\ndef _end_attack(player):\n    strike = getattr(player, 'strike', None)\n    if strike is not None:\n        for piece in (strike.hitbox, strike):\n            if not piece._destroyed:\n                destroy(piece)\n    player.strike = None\n    player.attackTimer = 0\n\n\ndef _step_attack(player):\n    if player.attackTimer <= 0:\n        return\n    player.attackTimer -= 1\n    strike = player.strike\n    age = _swing_frames() - player.attackTimer\n    windup = COMBAT_CONFIG['windupFrames']\n    active = windup < age <= windup + COMBAT_CONFIG['activeFrames']\n    _place_strike(player, strike)\n    strike.visible = active and strike.hasArt\n    if active:\n        hit = _strike_hits(player, strike)\n        if age == windup + 1 and not hit:\n            _play_sound('swing')\n    if player.attackTimer == 0:\n        _end_attack(player)\n\n\ndef _attack_pose_showing(player):\n    return player.attackTimer > COMBAT_CONFIG['recoveryFrames']\n\n\ndef _strike_hits(player, strike):\n    hit = False\n    for enemyHitbox in get_collision_list(strike.hitbox, 'EnemyHitbox'):\n        enemy = enemyHitbox.owner\n        if enemy._destroyed or enemy.dying or enemy in strike.hitTargets:\n            continue\n        strike.hitTargets.append(enemy)\n        hit = True\n        _pogo(player, strike)\n        if _hurt_enemy(enemy, COMBAT_CONFIG['meleeDamage'], False):\n            _gain_meter(COMBAT_CONFIG['meterPerHit'])\n            _stagger_enemy(enemy, player)\n    if strike.direction == 'down':\n        for hazard in get_collision_list(strike.hitbox, 'Hazard'):\n            if hazard.visible:\n                _pogo(player, strike)\n    return hit\n\n\ndef _pogo(player, strike):\n    if strike.direction != 'down' or COMBAT_CONFIG['pogo'] != 1 or strike.pogoed:\n        return\n    strike.pogoed = True\n    player.dy = player.jumpSpeed * player.stompBounce\n    _refill_abilities(player)\n    player.jumped = True\n    player.coyoteTimer = 0\n\n\ndef _stagger_enemy(enemy, player):\n    game.hitStop = COMBAT_CONFIG['hitStop']\n    if enemy.dying:\n        return\n    enemy.staggerTimer = COMBAT_CONFIG['stagger']\n    direction = 1 if enemy.x >= player.x else -1\n    _knock_back_enemy(enemy, direction)\n\n\ndef _in_wall(enemy):\n    # A solid reaching above the enemy's feet is a wall, as is the room's edge; the floor it stands on is not.\n    feet = enemy.hitbox.y - abs(get_height(enemy.hitbox)) / 2\n    return any(solid.y + abs(get_height(solid)) / 2 > feet + 1 for solid in _live_solids(enemy.hitbox, edges=True))\n\n\ndef _knock_back_fits(enemy, direction, distance):\n    startX = enemy.x\n    enemy.x += direction * distance\n    _sync_enemy_hitbox(enemy)\n    if _in_wall(enemy):\n        enemy.x = startX\n        _sync_enemy_hitbox(enemy)\n        return False\n    return True\n\n\ndef _knock_back_enemy(enemy, direction):\n    # Enemies stop at a wall but not at a ledge, so they can fall off; stationary enemies and droppers stay put.\n    distance = COMBAT_CONFIG['knockback']\n    if distance <= 0 or enemy.behavior not in KNOCKBACK_BEHAVIORS:\n        return\n    if not _knock_back_fits(enemy, direction, distance):\n        _knock_back_fits(enemy, direction, distance / 2)\n\n\ndef _step_stagger(enemy):\n    if enemy.staggerTimer <= 0:\n        return False\n    enemy.staggerTimer -= 1\n    _sync_enemy_hitbox(enemy)\n    return True\n\n\ndef _meter_on():\n    return COMBAT_CONFIG['meter'] == 1\n\n\ndef _gain_meter(amount):\n    if _meter_on():\n        game.meter = min(getattr(game, 'meter', 0) + amount, COMBAT_CONFIG['meterMax'])\n\n\ndef _can_shoot(player):\n    ammo = COMBAT_CONFIG['ammo']\n    if ammo == 'recharging':\n        return player.ammo > 0\n    if ammo == 'meter':\n        return _meter_on() and getattr(game, 'meter', 0) >= COMBAT_CONFIG['shotCost']\n    return True\n\n\ndef _spend_shot(player):\n    ammo = COMBAT_CONFIG['ammo']\n    if ammo == 'recharging':\n        player.ammo -= 1\n    elif ammo == 'meter':\n        game.meter -= COMBAT_CONFIG['shotCost']\n\n\ndef _recharge_ammo(player):\n    # One shot comes back every ammoRechargeFrames while any are spent.\n    if COMBAT_CONFIG['ammo'] != 'recharging' or player.ammo >= COMBAT_CONFIG['maxAmmo']:\n        player.ammoTimer = 0\n        return\n    player.ammoTimer += 1\n    if player.ammoTimer >= COMBAT_CONFIG['ammoRechargeFrames']:\n        player.ammo += 1\n        player.ammoTimer = 0\n\n\ndef _step_shooting(player):\n    _recharge_ammo(player)\n    if player.shootCooldown > 0:\n        player.shootCooldown -= 1\n        return\n    if player.projectile is None or not _unlocked('shoot') or not _control_is_pressed('shoot') or not _can_shoot(player):\n        return\n    _spend_shot(player)\n    _fire_projectile(player, player.projectile, player.facing, True)\n    player.shootCooldown = COMBAT_CONFIG['shootCooldown']\n\n\ndef _can_heal(player):\n    return (COMBAT_CONFIG['heal'] == 1 and _meter_on() and player.health < _max_health()\n            and getattr(game, 'meter', 0) >= COMBAT_CONFIG['healCost'])\n\n\ndef _show_healing(player, healing):\n    # The player glows while healing.\n    if healing and player.healFilterId is None:\n        player.healFilterId = add_filter(player, new_adjustment_filter({ 'brightness': 1.6 }))\n    elif not healing and player.healFilterId is not None:\n        remove_filter(player, player.healFilterId)\n        player.healFilterId = None\n\n\ndef _cancel_heal(player):\n    player.healTimer = 0\n    _show_healing(player, False)\n\n\ndef _step_heal(player):\n    # Holding heal for healFrames spends healCost meter for one health. Letting go or a hit starts over.\n    if not _control_is_pressed('heal') or not _can_heal(player):\n        _cancel_heal(player)\n        return\n    player.healTimer += 1\n    _show_healing(player, True)\n    if player.healTimer >= COMBAT_CONFIG['healFrames']:\n        game.meter -= COMBAT_CONFIG['healCost']\n        player.health += 1\n        player.healTimer = 0\n        _play_sound('heal')\n\n\ndef _spawn_ammo_hud(player):\n    # One pip per shot, drawn with the player's projectile art; a spent shot is faded.\n    if COMBAT_CONFIG['ammo'] != 'recharging' or player.projectile is None:\n        return\n    layout = UI_CONFIG['ammo']\n    pose = _load_pose(PROJECTILE_TYPES[player.projectile]['sprite'])\n    for index in range(min(COMBAT_CONFIG['maxAmmo'], layout['displayLimit'])):\n        pip = AmmoPip()\n        _apply_pose(pip, pose)\n        pip.index = index\n        size = max(abs(get_width(pip)), abs(get_height(pip)))\n        if size > layout['height']:\n            pip.scaleX *= layout['height'] / size\n            pip.scaleY *= layout['height'] / size\n        game.hud_combat.append(pip)\n\n\n# Adjustment filters that turn pixel.png (pure green) into each HUD colour: saturation 0 makes it a 0.715 grey,\n# which red/green/blue and brightness then tint. A light frame and a dark panel show on any background.\nHUD_COLOURS = {\n    'frame': {'saturation': 0, 'brightness': 1.2},\n    'panel': {'saturation': 0, 'brightness': 0.17},\n    'track': {'saturation': 0, 'brightness': 0.47},\n    'health': {'saturation': 0, 'brightness': 1.26, 'green': 0.22, 'blue': 0.22},\n    'meter': {'saturation': 0, 'brightness': 1.4, 'green': 0.8, 'blue': 0.25},\n}\nHUD_FRAME = 1\n# The boss panel's dark space around its bar and above its name, and the share of the font size its letters fill.\nBOSS_PANEL_PADDING = 4\nBOSS_PANEL_TOP = 2\nBOSS_NAME_SHARE = 0.7\n\n\ndef _hud_rect(colour, z):\n    rect = HudRect()\n    rect.z = z\n    add_filter(rect, new_adjustment_filter(HUD_COLOURS[colour]))\n    return rect\n\n\ndef _place_hud_rect(rect, x, y, width, height):\n    # x and y are the rectangle's centre; a rectangle with no width is hidden.\n    rect.visible = width > 0\n    rect.x = x\n    rect.y = y\n    rect.scaleX = max(width, 1) / rect.baseWidth\n    rect.scaleY = height / rect.baseHeight\n\n\ndef _place_hud_bar(bar, left, y, layout, share):\n    # A framed bar the size of layout's width and height: the dark track, and the fill growing from the left by share (0 to 1).\n    width = layout['width']\n    height = layout['height']\n    _place_hud_rect(bar.frame, left + width / 2, y, width + 2 * HUD_FRAME, height + 2 * HUD_FRAME)\n    _place_hud_rect(bar.track, left + width / 2, y, width, height)\n    _place_hud_rect(bar.fill, left + width * share / 2, y, width * share, height)\n\n\ndef _spawn_meter_hud():\n    # The meter bar sits under the ammo pips, or in their place when there are none.\n    if not _meter_on():\n        return\n    bar = MeterBar()\n    bar.layoutY = UI_CONFIG['meter']['y'] if game.hud_combat else UI_CONFIG['ammo']['y']\n    game.hud_combat.append(bar)\n\n\ndef _spawn_combat_hud(player):\n    game.hud_combat = []\n    _spawn_ammo_hud(player)\n    _spawn_meter_hud()\n\n\nPICKUP_EFFECTS = ('none', 'heal', 'maxHealth', 'refill', 'unlock')\nUNLOCKABLES = ('melee', 'upDown', 'shoot', 'dash', 'airJump', 'wallJump')\n\n\ndef _unlocked(name):\n    # An ability that comes from a pickup is locked until collected; unlocks survive death.\n    return COMBAT_CONFIG[name + 'FromPickup'] != 1 or name in getattr(game, 'unlocked', [])\n\n\ndef _max_health():\n    return PLAYER_CONFIG['maxHealth'] + getattr(game, 'maxHealthBonus', 0)\n\n\ndef _keep_after_death(collectible):\n    # Upgrades stay collected even when the player dies before leaving the room.\n    persistentId = getattr(collectible, 'persistentId', None)\n    if persistentId is not None:\n        game.persistedCheckpoint.setdefault('collectedMapItems', set()).add(persistentId)\n\n\ndef _refill_combat(player):\n    player.ammo = COMBAT_CONFIG['maxAmmo']\n    if _meter_on():\n        game.meter = COMBAT_CONFIG['meterMax']\n\n\ndef _raise_max_health(player):\n    game.maxHealthBonus = getattr(game, 'maxHealthBonus', 0) + 1\n    player.health += 1\n    if UI_CONFIG['lives']['icon'] is not None and len(game.hud_lives) < UI_CONFIG['lives'].get('displayLimit', 10):\n        _add_life_icon(len(game.hud_lives), camera_x(), camera_y())\n\n\ndef _unlock(name):\n    if name not in game.unlocked:\n        game.unlocked.append(name)\n\n\ndef _apply_pickup_effect(collectible):\n    # What a collectible Type's Effect does to the player when picked up.\n    player = getattr(game, 'player', None)\n    if collectible.effect == 'none' or player is None or player._destroyed:\n        return\n    if collectible.effect == 'heal':\n        player.health = min(player.health + collectible.healAmount, _max_health())\n    elif collectible.effect == 'refill':\n        _refill_combat(player)\n    elif collectible.effect == 'maxHealth':\n        _raise_max_health(player)\n        _keep_after_death(collectible)\n    elif collectible.effect == 'unlock':\n        _unlock(collectible.unlocks)\n        _keep_after_death(collectible)"
            }
          },
          {
            "terrain.py": {
              "type": "function script",
              "head": "# Static and moving platform/wall placement - everything that becomes a\n# Platform instance. Terrain factories deliberately take no id=/remember_as=\n# in this slice - repeated terrain has no individual persisted identity.\n\n\ndef _track_ground_extent(bottom_y):\n    # Tracks the lowest bottom edge among every platform/wall created so\n    # far, as game.mapBottom - the player's own fall-off kill-plane check.\n    if getattr(game, 'suppressGroundTracking', False):\n        return\n    current = getattr(game, 'mapBottom', None)\n    if current is None or bottom_y < current:\n        game.mapBottom = bottom_y\n\n\ndef _new_platform(x, y, type=None, launch_speed=None):\n    plat = Platform()\n    cfg = _require_type(PLATFORM_TYPES, type, 'add_platform/add_wall')\n    _apply_pose(plat, _load_pose(cfg['sprite']))\n    plat.scaleX = getattr(plat, 'artFacing', 1)\n    plat.tileSprite = _tile_identity(cfg['sprite'])\n    # A launcher (spring, trampoline, ...) is still a Platform - its launch\n    # strength lives on its type. `isLauncher` is a declared flag any pack's\n    # launcher-flavored type can set, not a name match on one skin.\n    plat.launchSpeed = launch_speed * UNIT if launch_speed is not None else cfg.get('launchSpeed')\n    if plat.launchSpeed is None and cfg.get('isLauncher'):\n        plat.launchSpeed = PLAYER_CONFIG['jumpSpeed'] * PLAYER_CONFIG['launchJumpMultiplier']\n    plat.springIdlePose = _load_pose(cfg['sprite'])\n    plat.springPressedPose = _load_pose(cfg.get('pressedSprite', cfg['sprite']))\n    plat.springFrames = cfg.get('pressFrames', 0)\n    plat.x = x\n    plat.y = y\n    _track_ground_extent(plat.y - get_height(plat) / 2)\n    _register_instance('platform', type, plat)\n    return plat\n\n\ndef add_platform(*, at, type=None, launch_speed=None):\n    x, y = _resolve_at(at)\n    if launch_speed is not None and (not _finite_number(launch_speed) or launch_speed <= 0):\n        raise ValueError('add_platform launch_speed must be a positive finite number.')\n    return _new_platform(x, y, type, launch_speed)\n\n\ndef add_platform_row(*, at, tiles=None, type=None):\n    # Places `tiles` Platforms side by side, spaced by their real measured\n    # width so they neither overlap nor gap. Repeated terrain - no id=.\n    start_x, start_y = _resolve_at(at)\n    if tiles is None:\n        raise ValueError('add_platform_row needs tiles - how many tiles to place.')\n    result = []\n    width = None\n    for i in range(tiles):\n        plat = _new_platform(start_x, start_y, type)\n        if width is None:\n            width = get_width(plat)\n        plat.x = start_x + i * width\n        plat.tileOffset = i * width\n        result.append(plat)\n    return result\n\n\ndef _start_moving(plat, speed):\n    plat.startX = plat.x\n    plat.targetX = plat.x\n    plat.startY = plat.y\n    plat.targetY = plat.y\n    plat.speed = speed * UNIT\n    plat.moving = True\n    return plat\n\n\ndef add_moving_platform(*, at, type=None, to=None, speed=0.5):\n    # Single-axis travel only - to= must differ from the anchor on exactly\n    # one axis, same convention as add_moving_platform_group's to=.\n    x, y = _resolve_at(at)\n    if to is None:\n        raise ValueError('add_moving_platform needs to= - where it travels to.')\n    to_x, to_y = _resolve_at(to)\n    plat = _start_moving(_new_platform(x, y, type), speed)\n    if to_x != x and to_y == y:\n        plat.axis = 'x'\n        plat.targetX = to_x\n        plat.dir = 1 if to_x > x else -1\n    elif to_y != y and to_x == x:\n        plat.axis = 'y'\n        plat.targetY = to_y\n        plat.dir = 1 if to_y > y else -1\n    else:\n        raise ValueError(\"add_moving_platform's to= must differ from at on exactly one axis - single-axis travel only.\")\n    return plat\n\n\ndef add_moving_platform_row(*, at, tiles=None, to=None, speed=0.5, type=None):\n    # Each tile's target reuses its own tileOffset from add_platform_row, so\n    # the run keeps its real measured-width spacing at the target too.\n    x, y = _resolve_at(at)\n    if tiles is None:\n        raise ValueError('add_moving_platform_row needs tiles - how many tiles to place.')\n    if to is None:\n        raise ValueError('add_moving_platform_row needs to= - where it travels to.')\n    to_x, to_y = _resolve_at(to)\n    if to_x != x and to_y == y:\n        axis = 'x'\n    elif to_y != y and to_x == x:\n        axis = 'y'\n    else:\n        raise ValueError(\"add_moving_platform_row's to= must differ from at on exactly one axis - single-axis travel only.\")\n    tiles_list = add_platform_row(at=at, tiles=tiles, type=type)\n    for plat in tiles_list:\n        _start_moving(plat, speed)\n        plat.axis = axis\n        if axis == 'y':\n            plat.targetY = to_y + (plat.y - tiles_list[0].y)\n            plat.dir = 1 if to_y > plat.y else -1\n        else:\n            plat.targetX = to_x + plat.tileOffset\n            plat.dir = 1 if plat.targetX > plat.x else -1\n    return tiles_list\n\n\ndef add_moving_platform_group(*, at, parts=None, to=None, speed=0.5):\n    # A group of (possibly differently-typed) tiles that move together as\n    # one rigid unit - one movement specification for the whole group,\n    # instead of patching each grid-placed tile's target independently.\n    # parts is a list of {'row_offset', 'col_offset', 'type'} dicts, in CELL\n    # units relative to the anchor part (row_offset=0, col_offset=0,\n    # positioned at at=); to is where that anchor ends up, and every other\n    # part keeps its own relative offset at the target too. Moving-group\n    # offsets always use CELL, even in a world room with no grid - the\n    # configured tile_size remains its explicit spacing unit.\n    x, y = _resolve_at(at)\n    if not parts:\n        raise ValueError(\"add_moving_platform_group needs parts - a list of {'row_offset', 'col_offset', 'type'} dicts.\")\n    if to is None:\n        raise ValueError('add_moving_platform_group needs to= - where the anchor part (row_offset=0, col_offset=0) ends up.')\n    to_x, to_y = _resolve_at(to)\n    if to_x != x and to_y == y:\n        axis, target = 'x', to_x\n    elif to_y != y and to_x == x:\n        axis, target = 'y', to_y\n    else:\n        raise ValueError(\"add_moving_platform_group's to= must differ from at on exactly one axis - single-axis travel only.\")\n    seen_anchor = False\n    for part in parts:\n        if part.get('row_offset', 0) == 0 and part.get('col_offset', 0) == 0:\n            seen_anchor = True\n    if not seen_anchor:\n        raise ValueError(\"add_moving_platform_group needs exactly one part at row_offset=0, col_offset=0.\")\n    plats = []\n    for part in parts:\n        px = x + part.get('col_offset', 0) * CELL\n        py = y - part.get('row_offset', 0) * CELL\n        plat = _start_moving(_new_platform(px, py, part.get('type')), speed)\n        plat.axis = axis\n        if axis == 'x':\n            plat.targetX = target + (px - x)\n            plat.dir = 1 if plat.targetX > px else -1\n        else:\n            plat.targetY = target + (py - y)\n            plat.dir = 1 if plat.targetY > py else -1\n        plats.append(plat)\n    return plats\n\n\ndef _new_wall(x, y, type=None):\n    # Same Platform class/collision tag as _new_platform - a wall is\n    # mechanically identical to a floor, just oriented vertically.\n    wall = Platform()\n    cfg = _require_type(PLATFORM_TYPES, type, 'add_platform/add_wall')\n    _apply_pose(wall, _load_pose(cfg['sprite']))\n    wall.scaleX = getattr(wall, 'artFacing', 1)\n    wall.tileSprite = _tile_identity(cfg['sprite'])\n    wall.x = x\n    wall.y = y\n    # A wall is standable ground too - its top edge is a real place to land.\n    _track_ground_extent(wall.y - get_height(wall) / 2)\n    _register_instance('platform', type, wall)\n    return wall\n\n\ndef add_wall(*, at, type=None):\n    x, y = _resolve_at(at)\n    return _new_wall(x, y, type)\n\n\ndef add_wall_column(*, at, tiles=None, type=None):\n    # Repeated terrain - no id=. Wall columns extend +y.\n    start_x, start_y = _resolve_at(at)\n    if tiles is None:\n        raise ValueError('add_wall_column needs tiles - how many tiles to place.')\n    result = []\n    height = None\n    for i in range(tiles):\n        wall = _new_wall(start_x, start_y, type)\n        if height is None:\n            height = get_height(wall)\n        wall.y = start_y + i * height\n        wall.tileOffset = i * height\n        result.append(wall)\n    return result"
            }
          },
          {
            "progression.py": {
              "type": "function script",
              "head": "# Exits: flags, doors and pipes that go to another room or end the game.\n\n\ndef _next_interact_seq():\n    # A deterministic tie-break for the shared interaction selector below -\n    # first-registered wins a tie, regardless of dict/list iteration order.\n    seq = getattr(game, 'interactSeq', 0)\n    game.interactSeq = seq + 1\n    return seq\n\n\ndef _interact_distance(x, y):\n    player = game.player\n    dx = x - player.x\n    dy = y - player.y\n    return (dx * dx + dy * dy) ** 0.5\n\n\ndef _consider_simple_candidate(obj, best, best_key):\n    # Shared by every single-object (non-composite-region) interactable -\n    # npc/sign/interact-activated switch - so each category's branch below\n    # only says which objects are eligible, not how to compare them. A\n    # hidden interactable still works by intent (its prompt just stays\n    # hidden) - hide_object never removes it from candidacy.\n    if not get_collision(obj, 'PlayerHitbox'):\n        return best, best_key\n    key = (_interact_distance(obj.x, obj.y), obj.interactSeq)\n    if best_key is None or key < best_key:\n        return obj, key\n    return best, best_key\n\n\ndef _resolve_interact_target():\n    # NPCs, signs, interact-activated switches, and interact-activated\n    # exits each want to consume the same 'e' press when the player\n    # is near more than one at once. Recomputed once per frame (cached by\n    # game.frame, not call order) so every candidate's loop() sees the same\n    # answer regardless of which one runs first - exactly one interactable\n    # can ever act on a given press.\n    if getattr(game, 'interactFrame', None) == game.frame:\n        return game.interactTarget\n    game.interactFrame = game.frame\n    # The NPC or sign that started an open conversation keeps every press\n    # until it ends, even once the player walks out of range.\n    owner = getattr(game, 'dialogOwner', None)\n    if owner is not None:\n        if (not owner._destroyed and getattr(owner, '_visitToken', game.visitToken) == game.visitToken\n                and getattr(game, 'dialogBox', None) is not None):\n            game.interactTarget = owner\n            return owner\n        game.dialogOwner = None\n    best = None\n    best_key = None\n    for (category, _type), objs in game.byCategoryType.items():\n        # A destroyed object raises on any attribute read except _destroyed.\n        live = [obj for obj in objs if not obj._destroyed]\n        if category in ('npc', 'sign'):\n            for obj in live:\n                if not getattr(obj, 'lines', None):\n                    continue\n                best, best_key = _consider_simple_candidate(obj, best, best_key)\n        elif category == 'switch':\n            for obj in live:\n                if getattr(obj, 'activation', 'touch') != 'interact' or (not obj.reusable and obj.used):\n                    continue\n                best, best_key = _consider_simple_candidate(obj, best, best_key)\n        elif category == 'exit':\n            for trigger in live:\n                region = trigger.region\n                if not region.get('prompt') or region['reached'] or not region['armed']:\n                    continue\n                touching = [t for t in region['triggers'] if not t._destroyed and get_collision(t, 'PlayerHitbox')]\n                if not touching:\n                    continue\n                nearest = min(touching, key=lambda t: _interact_distance(t.x, t.y))\n                key = (_interact_distance(nearest.x, nearest.y), region['interactSeq'])\n                if best_key is None or key < best_key:\n                    best, best_key = region, key\n    game.interactTarget = best\n    return best\n\n\ndef is_interact_target(candidate):\n    # False for None/dead/stale/noninteractable candidates, even though the\n    # shared selector itself may resolve to None (no eligible candidate this\n    # frame) - `None is None` would otherwise wrongly read as \"yes.\"\n    if candidate is None or getattr(candidate, '_destroyed', False):\n        return False\n    if getattr(candidate, '_visitToken', game.visitToken) != game.visitToken:\n        return False\n    return _resolve_interact_target() is candidate\n\n\ndef _update_interact_prompt(obj, show, layout):\n    show = (show and not getattr(obj, 'promptSuppressed', False)\n            and UI_CONFIG['dialog']['indicator']['pose'] is not None)\n    if show and obj.prompt is None:\n        obj.prompt = DialogPrompt()\n    elif not show and obj.prompt is not None:\n        destroy(obj.prompt)\n        obj.prompt = None\n    if obj.prompt is not None:\n        offsets = UI_CONFIG['dialog']['indicator'][layout]\n        obj.prompt.x = obj.x + offsets['offsetX']\n        obj.prompt.y = obj.y + get_height(obj) / 2 + get_height(obj.prompt) / 2 + offsets['gap']\n        obj.prompt.alpha = getattr(obj, 'promptAlpha', 1)\n\n\ndef _new_exit_region(requires, success_text, fail_text, to_room, to_location, prompt):\n    # Exits are collision proxies; this record owns the state shared by\n    # every proxy in one composite, so a multi-part door or flag need not\n    # collapse to one object's own fields.\n    return {\n        'requires': requires,\n        'successText': success_text,\n        'failText': fail_text,\n        'toRoom': to_room,\n        'toLocation': to_location,\n        'prompt': prompt,\n        'promptIndicator': None,\n        'promptSuppressed': False,\n        'promptAlpha': 1,\n        'dialogFrame': None,\n        'dialogShown': False,\n        'armed': to_room is None,\n        'reached': False,\n        'triggers': [],\n        'interactSeq': _next_interact_seq(),\n    }\n\n\ndef _add_exit_trigger(x, y, pose, region):\n    g = Exit()\n    _apply_pose(g, _load_pose(pose))\n    g.scaleX = getattr(g, 'artFacing', 1)\n    g.x = x\n    g.y = y\n    g.region = region\n    _clear_duplicate_tile(x, y, _tile_identity(pose), exclude=g)\n    region['triggers'].append(g)\n    return g\n\n\ndef _composite_parts(cfg, default_parts):\n    # A type's own 'parts' (row_offset/col_offset off the at= anchor), or\n    # `default_parts` when the type declares none - shared by every\n    # composite factory (add_barrier, add_exit) so \"no authored parts\"\n    # resolves the same way everywhere: a single part at the anchor.\n    # Multi-cell content built this way writes its shared state once per\n    # touch, not once per cell.\n    parts = cfg.get('parts')\n    return parts if parts is not None else default_parts\n\n\ndef _composite_base_part(parts, what):\n    for part in parts:\n        if part['row_offset'] == 0 and part['col_offset'] == 0:\n            return part\n    raise ValueError(f'{what} needs one part at row_offset=0, col_offset=0.')\n\n\ndef _add_composite_triggers(x, y, parts, base, region, step_w, step_h):\n    # Adds every part besides `base` (already added by the caller) as its\n    # own trigger on the shared region, offset by measured spacing - not an\n    # assumed CELL-sized grid, since a type's art need not match the room's\n    # tile size.\n    for part in parts:\n        if part is base:\n            continue\n        px = x + part['col_offset'] * step_w\n        py = y - part['row_offset'] * step_h\n        _add_exit_trigger(px, py, part['sprite'], region)\n\n\ndef add_exit(*, at, destination=None, activation='touch', requires=None,\n             fail_text=None, success_text=None, type=None, id=None):\n    # A flag, door or pipe. destination=(room, location) goes to a map room,\n    # destination='Room' goes to a script room, and no destination ends the\n    # game with success_text. A multi-cell exit is one composite: the type's\n    # own 'parts' each add a touchable trigger to the same region, so a\n    # player spanning two cells fires it once. Never remembered.\n    x, y = _resolve_at(at)\n    _reserve_id(id)\n    to_room, to_location = _exit_destination(destination)\n    if to_room is not None:\n        _require_destination(game.room, to_room, to_location)\n    if activation not in ('touch', 'interact'):\n        raise ValueError(\"add_exit needs activation='touch' or 'interact'.\")\n    _validate_requires(requires, 'add_exit')\n    if fail_text is not None and not isinstance(fail_text, str):\n        raise ValueError('add_exit needs fail_text to be a string or None.')\n    if success_text is not None and not isinstance(success_text, str):\n        raise ValueError('add_exit needs success_text to be a string or None.')\n    cfg = _require_type(EXIT_TYPES, type, 'add_exit')\n    parts = _composite_parts(cfg, [{'row_offset': 0, 'col_offset': 0, 'sprite': cfg.get('sprite')}])\n    base = _composite_base_part(parts, 'Exit type')\n    region = _new_exit_region(requires, success_text, fail_text, to_room, to_location,\n                              activation == 'interact')\n    base_trigger = _add_exit_trigger(x, y, base['sprite'], region)\n    _add_composite_triggers(x, y, parts, base, region, get_width(base_trigger), get_height(base_trigger))\n    _register_instance('exit', type, base_trigger, id=id)\n    return base_trigger"
            }
          },
          {
            "interactables.py": {
              "type": "function script",
              "head": "# Pickups, keys, barriers, switches, hazards, decor, signs - content a room\n# script calls directly. _open_barrier is barrier-internal, used by\n# Barrier's own loop. _requires_met/_validate_requires are the one shared\n# global-gate primitive behind add_barrier/add_exit's `requires` and a\n# placement's appears_when/disappears_when (grid.py): a global name, a list\n# (all must be true), or None. Boolean-only, checked at author time\n# (_validate_requires), not just at runtime - a truthiness check silently\n# misreads a nonzero int or a non-empty enum string as \"met,\" so a\n# numeric/enum global here fails loudly instead of quietly doing the wrong\n# thing.\n\n\ndef _requires_met(requires):\n    # requires is a single declared global name, a list of names (all must\n    # be true), or None (always met). Reads through get_global(), which\n    # raises for any undeclared name instead of silently treating it as unset.\n    if requires is None:\n        return True\n    names = requires if isinstance(requires, list) else [requires]\n    for name in names:\n        if not get_global(name):\n            return False\n    return True\n\ndef _validate_requires(requires, what):\n    if requires is None:\n        return\n    for name in (requires if isinstance(requires, list) else [requires]):\n        _validate_global(name, what)\n        if _global_type(name) != 'bool':\n            raise ValueError(\n                f\"{what} only supports boolean globals - \"\n                f\"{name!r} is type {_global_type(name)!r}.\"\n            )\n\n\ndef _clear_duplicate_tile(x, y, sprite, exclude=None):\n    # Removes any Platform/Decor at this exact position using this exact\n    # sprite - the map's own grid content sometimes draws the same art a\n    # real object supplies itself. `exclude` is the object just created,\n    # which can carry that same position/sprite and must never match itself.\n    if sprite is None:\n        return\n    for obj in get_room_objects():\n        if obj is exclude or obj._destroyed or not _tile_identities_overlap(getattr(obj, 'tileSprite', None), sprite):\n            continue\n        if obj.x == x and obj.y == y:\n            destroy(obj)\n\n\ndef _open_barrier(barrier):\n    if barrier._destroyed or not barrier.locked:\n        return\n    met = barrier.condition() if barrier.condition is not None else _requires_met(barrier.requires)\n    if not met:\n        return\n    barrier.locked = False\n    _play_sound('unlock')\n    _mark_persisted('openedBarriers', barrier.persistentId)\n    destroy_object(barrier)\n\n\ndef _validate_remember_as(remember_as, category, what):\n    if remember_as is None:\n        return\n    if not isinstance(remember_as, str) or remember_as == '':\n        raise ValueError(f\"{what}'s remember_as must be a non-empty string.\")\n\n\ndef add_collectible(*, at, type=None, sets_global=None, id=None, remember_as=None):\n    # Validate everything that can fail before reserving id=/remember_as= -\n    # a failed call must not leave a name reserved that a later, correct\n    # call could otherwise use.\n    x, y = _resolve_at(at)\n    if sets_global is not None:\n        _validate_global(sets_global, 'add_collectible')\n        if _global_type(sets_global) != 'bool':\n            raise ValueError(f\"add_collectible's sets_global only supports boolean globals - {sets_global!r} is type {_global_type(sets_global)!r}.\")\n    cfg = _require_type(COLLECTIBLE_TYPES, type, 'add_collectible')\n    _reserve_id(id)\n    _reserve_remember_as(remember_as)\n    persistent_id = _persistent_id(remember_as)\n    _clear_duplicate_tile(x, y, _tile_identity(cfg['sprite']))\n    if _is_persisted('collectedMapItems', persistent_id):\n        return None\n    c = _build_collectible(x, y, type, sets_global)\n    c.persistentId = persistent_id\n    _register_instance('collectible', type, c, id=id)\n    return c\n\n\ndef _build_collectible(x, y, type, sets_global):\n    # Shared by add_collectible and add_key - registration is the caller's\n    # job, since a key registers as ('key', type) only, never also as\n    # ('collectible', type) (that would double-count it under both kinds).\n    cfg = _require_type(COLLECTIBLE_TYPES, type, 'add_collectible')\n    c = Collectible()\n    c.x = x\n    c.y = y\n    c.setsGlobal = sets_global\n    c.counter = cfg['counter']\n    c.sound = cfg.get('sound') or ('collect' if c.counter else 'pickup')\n    c.effect = cfg.get('effect', 'none')\n    c.healAmount = cfg.get('healAmount', 1)\n    c.unlocks = cfg.get('unlocks')\n    if c.effect not in PICKUP_EFFECTS:\n        raise ValueError(f\"Collectible type {type!r} has effect {c.effect!r}; use one of {PICKUP_EFFECTS}.\")\n    if c.effect == 'unlock' and c.unlocks not in UNLOCKABLES:\n        raise ValueError(f\"Collectible type {type!r} unlocks {c.unlocks!r}; use one of {UNLOCKABLES}.\")\n    _apply_pose(c, _load_pose(cfg['sprite']))\n    c.scaleX = getattr(c, 'artFacing', 1)\n    c.tileSprite = _tile_identity(cfg['sprite'])\n    return c\n\n\ndef add_decor(*, at, type=None, id=None):\n    # Decor has no collision tag or gameplay state - map art, not a\n    # Platform masquerading as art. Never remembered.\n    x, y = _resolve_at(at)\n    _reserve_id(id)\n    cfg = _require_type(DECOR_TYPES, type, 'add_decor')\n    d = Decor()\n    _apply_pose(d, _load_pose(cfg['sprite']))\n    d.scaleX = getattr(d, 'artFacing', 1)\n    d.tileSprite = _tile_identity(cfg['sprite'])\n    d.x = x\n    d.y = y\n    _register_instance('decor', type, d, id=id)\n    return d\n\n\ndef add_climbable(*, at, type=None, id=None):\n    # A ladder, vine or rope: the player climbs it with up and down and can\n    # stand on the top one of a column. Never blocks movement; never remembered.\n    x, y = _resolve_at(at)\n    _reserve_id(id)\n    cfg = _require_type(CLIMBABLE_TYPES, type, 'add_climbable')\n    c = Climbable()\n    _apply_pose(c, _load_pose(cfg['sprite']))\n    c.scaleX = getattr(c, 'artFacing', 1)\n    c.tileSprite = _tile_identity(cfg['sprite'])\n    c.x = x\n    c.y = y\n    _clear_duplicate_tile(x, y, c.tileSprite, exclude=c)\n    _register_instance('climbable', type, c, id=id)\n    return c\n\n\ndef add_key(*, at, sets_global=None, type=None, id=None, remember_as=None):\n    # A labeled collectible - delegates to add_collectible rather than a\n    # separate class/catalog. Returns the created Collectible, or None if\n    # this authored key's remember_as was already resolved on an earlier\n    # visit to this room - never a destroyed handle.\n    x, y = _resolve_at(at)\n    if sets_global is None:\n        raise ValueError('add_key needs sets_global - the declared global name this key sets.')\n    if type is None:\n        raise ValueError('add_key needs an explicit type - assign one when authoring this content.')\n    _validate_global(sets_global, 'add_key')\n    if _global_type(sets_global) != 'bool':\n        raise ValueError(f\"add_key's sets_global only supports boolean globals - {sets_global!r} is type {_global_type(sets_global)!r}.\")\n    cfg = _require_type(COLLECTIBLE_TYPES, type, 'add_key')\n    _reserve_id(id)\n    _reserve_remember_as(remember_as)\n    persistent_id = _persistent_id(remember_as)\n    # Cleared unconditionally, even on a return visit where the key was\n    # already collected - the raw grid's own placeholder art for this key\n    # must never linger just because no Collectible gets built this time.\n    _clear_duplicate_tile(x, y, _tile_identity(cfg['sprite']))\n    if _is_persisted('collectedMapItems', persistent_id):\n        return None\n    key = _build_collectible(x, y, type, sets_global)\n    key.persistentId = persistent_id\n    _register_instance('key', type, key, id=id)\n    return key\n\n\ndef add_barrier(*, at, requires=None, type=None, id=None, remember_as=None):\n    # A solid, conditional obstruction that never changes rooms - opens\n    # only when its requirement is met AND the player touches it. at=\n    # identifies the part at row=0, col=0. remember_as makes the opened\n    # state persistent across room re-entry (a remember_as-less barrier\n    # rebuilds locked every visit, same as a remember_as-less key never\n    # persisting).\n    x, y = _resolve_at(at)\n    if requires is None:\n        raise ValueError('add_barrier needs requires - the declared global name (or list of names) that unlocks it.')\n    _validate_requires(requires, 'add_barrier')\n    cfg = _require_type(BARRIER_TYPES, type, 'add_barrier')\n    _reserve_id(id)\n    _reserve_remember_as(remember_as)\n    persistent_id = _persistent_id(remember_as)\n    already_opened = _is_persisted('openedBarriers', persistent_id)\n    b = Barrier()\n    # A single part at the anchor by default - same convention as\n    # add_exit's own composite handling (progression.py). A\n    # multi-cell barrier type declares its own 'parts' to opt into that.\n    parts = _composite_parts(cfg, [{'row_offset': 0, 'col_offset': 0, 'sprite': cfg.get('sprite')}])\n    base = _composite_base_part(parts, 'Barrier type')\n    _apply_pose(b, _load_pose(base['sprite']))\n    b.scaleX = getattr(b, 'artFacing', 1)\n    b.tileSprite = _tile_identity(base['sprite'])\n    b.x = x\n    b.y = y\n    b.requires = requires\n    b.persistentId = persistent_id\n    _clear_duplicate_tile(x, y, b.tileSprite, exclude=b)\n    # Measured spacing, not an assumed CELL-sized grid - a barrier's own art\n    # need not match the room's tile size. World y increases upward, so a\n    # positive (downward) row_offset subtracts from y.\n    step_w = get_width(b)\n    step_h = get_height(b)\n    b.parts = []\n    for part in parts:\n        if part is base:\n            continue\n        piece = Platform()\n        _apply_pose(piece, _load_pose(part['sprite']))\n        piece.scaleX = getattr(piece, 'artFacing', 1)\n        piece.tileSprite = _tile_identity(part['sprite'])\n        piece.x = x + part['col_offset'] * step_w\n        piece.y = y - part['row_offset'] * step_h\n        piece.z = 2\n        piece.barrier = b\n        _clear_duplicate_tile(piece.x, piece.y, piece.tileSprite, exclude=piece)\n        b.parts.append(piece)\n    if already_opened:\n        # Unlocked on an earlier visit to this room - every part's raw grid\n        # duplicate is already cleared above, so just remove the (re-locked)\n        # barrier itself rather than making the player open it again. No\n        # live handle for an absent placement - return None.\n        b.locked = False\n        for part in b.parts:\n            destroy(part)\n        destroy(b)\n        return None\n    _register_instance('barrier', type, b, id=id)\n    return b\n\n\ndef add_switch(*, at, sets_global=None, type=None, id=None, remember_as=None, reusable=False, activation='touch'):\n    # Use-once by default: first touch sets the global and it stops\n    # reacting after that. reusable=True flips the global on every touch.\n    # A one-shot switch whose global is already true starts used. remember_as\n    # preserves used state independently if another script later clears that\n    # global. A reusable switch with remember_as is rejected because it has no\n    # one-time effect to remember. activation='touch' (default) fires on\n    # contact; 'interact' requires 'e' and only fires when is_interact_target\n    # selects it - same convention as add_exit.\n    x, y = _resolve_at(at)\n    if reusable and remember_as is not None:\n        raise ValueError('add_switch cannot combine reusable=True with remember_as - a reusable switch has no one-time effect to remember.')\n    if sets_global is None:\n        raise ValueError('add_switch needs sets_global - the declared global name this switch toggles.')\n    if activation not in ('touch', 'interact'):\n        raise ValueError(\"add_switch needs activation='touch' or 'interact'.\")\n    _validate_global(sets_global, 'add_switch')\n    if _global_type(sets_global) != 'bool':\n        raise ValueError(f\"add_switch's sets_global only supports boolean globals - {sets_global!r} is type {_global_type(sets_global)!r}.\")\n    poses = _require_type(SWITCH_TYPES, type, 'add_switch')['poses']\n    _reserve_id(id)\n    _reserve_remember_as(remember_as)\n    persistent_id = _persistent_id(remember_as)\n    s = Switch()\n    s.onSprite = _load_pose(_resolve_pose(poses, 'on'))\n    s.offSprite = _load_pose(_resolve_pose(poses, 'off'))\n    s.setsGlobal = sets_global\n    s.reusable = reusable\n    s.activation = activation\n    s.interactSeq = _next_interact_seq()\n    s.persistentId = persistent_id\n    if (not reusable and get_global(sets_global)) or _is_persisted('usedSwitches', persistent_id):\n        s.used = True\n    s.x = x\n    s.y = y\n    # A one-shot switch's visible pose always reflects its global, including\n    # immediately on construction, not only on its next loop() - used state\n    # and global value are distinct (a used switch can be inert even if the\n    # global later goes false).\n    _apply_pose(s, s.onSprite if get_global(sets_global) else s.offSprite)\n    s.scaleX = getattr(s, 'artFacing', 1)\n    _clear_duplicate_tile(x, y, _tile_identity(_resolve_pose(poses, 'on')), exclude=s)\n    _clear_duplicate_tile(x, y, _tile_identity(_resolve_pose(poses, 'off')), exclude=s)\n    _register_instance('switch', type, s, id=id)\n    return s\n\n\ndef add_hazard(*, at, type=None, id=None):\n    # Never remembered. A switch-gated hazard is a placement with\n    # disappears_when (see grid.py's _update_appearing).\n    x, y = _resolve_at(at)\n    _reserve_id(id)\n    cfg = _require_type(HAZARD_TYPES, type, 'add_hazard')\n    h = Hazard()\n    _apply_pose(h, _load_pose(cfg['sprite']))\n    h.scaleX = getattr(h, 'artFacing', 1)\n    h.tileSprite = _tile_identity(cfg['sprite'])\n    h.x = x\n    h.y = y\n    h.damage = cfg.get('damage', 1)\n    h.hitbox = _pose_hitbox(cfg['sprite'])\n    _clear_duplicate_tile(x, y, h.tileSprite, exclude=h)\n    _register_instance('hazard', type, h, id=id)\n    return h\n\n\ndef add_sign(*, at, lines=None, type=None, id=None):\n    # Uses the NPC dialogue interaction, with its own visual catalog. Never\n    # remembered. lines has the same shape as add_npc's lines - speaker\n    # labels belong to the dialogue data.\n    x, y = _resolve_at(at)\n    _reserve_id(id)\n    if lines is None:\n        raise ValueError('add_sign needs lines - the list of things it says.')\n    if not isinstance(lines, list):\n        raise ValueError('add_sign needs lines to be a list.')\n    _validate_dialogue_lines(lines, 'add_sign')\n    s = NPC()\n    cfg = _require_type(SIGN_TYPES, type, 'add_sign')\n    signSprite = cfg['sprite']\n    _apply_pose(s, _load_pose(signSprite))\n    s.stillPose = signSprite\n    s.scaleX = getattr(s, 'artFacing', 1)\n    s.lines = lines\n    s.interactSeq = _next_interact_seq()\n    s.x = x\n    s.y = y\n    _clear_duplicate_tile(x, y, _tile_identity(cfg['sprite']), exclude=s)\n    _register_instance('sign', type, s, id=id)\n    return s"
            }
          },
          {
            "characters.py": {
              "type": "function script",
              "head": "# Enemies and NPCs - placement plus the patrol-behavior helpers Enemy's\n# own loop uses.\n\n\n# PixelPad trims 1 px off each side of a collision box, so floor tiles have 2 px gaps between them.\nENEMY_SENSOR_MIN_WIDTH = 6\n\n\ndef _ground_ahead(enemy, direction, foot_y, reach=None):\n    # Probes `reach` (default: one step) ahead of a ground-based enemy, at\n    # foot height, for solid ground.\n    lead = abs(get_width(enemy)) / 2 + (enemy.senseAhead if reach is None else reach)\n    widened = abs(get_width(enemy.sensor)) - ENEMY_DEFAULTS['sensorSize']\n    enemy.sensor.x = enemy.x + direction * (lead + widened / 2)\n    enemy.sensor.y = foot_y - abs(get_height(enemy)) / 2 - enemy.senseDown\n    return _live_solid_at(enemy.sensor)\n\n\ndef _solid_kinds(edges):\n    # Platforms and barriers block movement; the room's invisible edge walls do too when edges is True.\n    return ('Platform', 'Barrier', 'EdgeWall') if edges else ('Platform', 'Barrier')\n\n\ndef _solids_touching(obj, edges=False):\n    # Every solid obj overlaps, including ones destroyed this frame, like an opened barrier.\n    return [solid for kind in _solid_kinds(edges) for solid in get_collision_list(obj, kind)]\n\n\ndef _live_solids(obj, edges=False):\n    return [solid for solid in _solids_touching(obj, edges) if not solid._destroyed]\n\n\ndef _live_solid_at(sensor, edges=False):\n    # True when the sensor touches a solid that hasn't just been destroyed.\n    for kind in _solid_kinds(edges):\n        hit = get_collision(sensor, kind)\n        if hit and (not hit._destroyed or any(not solid._destroyed for solid in get_collision_list(sensor, kind))):\n            return True\n    return False\n\n\ndef _wall_ahead(enemy, middle_y=None):\n    # Probes just ahead of an enemy, at the height of its middle, for a wall or barrier.\n    enemy.sensor.x = enemy.x + enemy.dir * (abs(get_width(enemy)) / 2 + enemy.senseAhead)\n    enemy.sensor.y = enemy.y if middle_y is None else middle_y\n    return _live_solid_at(enemy.sensor, edges=True)\n\n\ndef _hop_reach(enemy):\n    # How far one hop carries a jumper sideways: its speed times its time in the air.\n    return enemy.speed * 2 * enemy.jumpSpeed / -enemy.hopGravity\n\n\ndef _choose_patrol_direction(enemy, foot_y, reach=None, walls=True):\n    # Past patrolRange it heads back to its start, turning at edges and walls; cut off from its start, it patrols where it is.\n    outside = abs(enemy.x - enemy.spawnX) > enemy.patrolRange\n    if outside:\n        enemy.dir = 1 if enemy.x < enemy.spawnX else -1\n    if not _ground_ahead(enemy, enemy.dir, foot_y, reach) or (walls and _wall_ahead(enemy)):\n        if outside:\n            enemy.spawnX = enemy.x - enemy.dir * enemy.patrolRange\n        enemy.dir = -enemy.dir\n\n\ndef _patrol_step(enemy, foot_y):\n    # Horizontal movement for 'patrol': turn around at a real edge, a wall\n    # or patrolRange, whichever comes first.\n    _choose_patrol_direction(enemy, foot_y)\n    enemy.x += enemy.dir * enemy.speed\n    enemy.scaleX = getattr(enemy, 'artFacing', 1) * enemy.dir\n\n\nENEMY_HIT_FLASH_FRAMES = 8\nENEMY_HIT_INVULNERABLE_FRAMES = 30\nENEMY_BLINK_CYCLE_FRAMES = 4\n\n\ndef _hurt_enemy(enemy, amount, blink=True):\n    # A melee hit doesn't blink: each swing can hit an enemy only once anyway.\n    if (blink and enemy.invulnerable > 0) or enemy.dying or enemy.invincible:\n        return False\n    enemy.health -= amount\n    _play_sound('enemyhit')\n    if enemy.hitFilterId is not None:\n        remove_filter(enemy, enemy.hitFilterId)\n    enemy.hitFilterId = add_filter(enemy, new_adjustment_filter({ 'contrast': 0, 'brightness': 5 }))\n    enemy.hitFlashTimer = ENEMY_HIT_FLASH_FRAMES\n    if enemy.health <= 0:\n        _defeat_enemy(enemy)\n    elif blink:\n        enemy.invulnerable = ENEMY_HIT_INVULNERABLE_FRAMES\n    return True\n\n\ndef _defeat_enemy(enemy):\n    # An enemy beaten in the air drops its pickup once it lands.\n    enemy.dying = True\n    if (enemy.airborne or enemy.flying) and enemy.behavior in GROUND_BEHAVIORS:\n        enemy.dropPending = True\n    else:\n        _drop_pickup(enemy)\n    if enemy.beatenSetsGlobal is not None:\n        set_global(enemy.beatenSetsGlobal, True)\n    _dispatch('enemyDefeated', enemy)\n\n\ndef _drop_pickup(enemy):\n    if enemy.drop is None or random.random() * 100 >= enemy.dropChance:\n        return\n    pickup = _build_collectible(enemy.x, enemy.y, enemy.drop, enemy.dropSetsGlobal)\n    pickup.persistentId = None\n    _register_instance('collectible', enemy.drop, pickup)\n\n\ndef _update_enemy_hit_effects(enemy):\n    if enemy.invulnerable > 0:\n        enemy.invulnerable -= 1\n        enemy.visible = enemy.invulnerable % ENEMY_BLINK_CYCLE_FRAMES < ENEMY_BLINK_CYCLE_FRAMES // 2\n    enemy.hitFlashTimer -= 1\n    if enemy.hitFilterId is not None and enemy.hitFlashTimer <= 0:\n        remove_filter(enemy, enemy.hitFilterId)\n        enemy.hitFilterId = None\n\n\ndef _handle_enemy_contact(enemy, player, contactFeet):\n    # Feet above the enemy's middle stomp it unless still rising; lower contact hurts.\n    if getattr(enemy, '_destroyed', False) or enemy.dying:\n        return None\n    if contactFeet < enemy.hitbox.y or COMBAT_CONFIG['stomp'] != 1:\n        if not _dash_protects(player):\n            _damage_player(enemy.contactDamage, enemy)\n        return None\n    if player.dy > 0:\n        return None\n    _end_dash(player)\n    player.dy = player.jumpSpeed * player.stompBounce\n    _refill_abilities(player)\n    _hurt_enemy(enemy, player.stompDamage)\n    return enemy.hitbox.y + get_height(enemy.hitbox) / 2\n\n\ndef _solid_top(solid):\n    return solid.y + get_height(solid) / 2\n\n\ndef _floor_below(enemy, previous_bottom, tolerance=None):\n    # The solid with the highest top the enemy's hitbox now overlaps that was no more than `tolerance` above its feet.\n    reach = ENEMY_GROUND_PROBE if tolerance is None else tolerance\n    floors = [solid for solid in _live_solids(enemy.hitbox) if _solid_top(solid) <= previous_bottom + reach]\n    return max(floors, key=_solid_top) if floors else None\n\n\ndef _still_on(enemy, solid, bottom):\n    # True while the enemy's feet rest on top of the same solid it stood on last frame.\n    if solid is None or solid._destroyed or abs(_solid_top(solid) - bottom) > 0.001:\n        return False\n    return abs(solid.x - enemy.hitbox.x) < (abs(get_width(solid)) + abs(get_width(enemy.hitbox))) / 2 - 2\n\n\ndef _ceiling_above(enemy, previous_top):\n    bottoms = [solid.y - get_height(solid) / 2 for solid in _live_solids(enemy.hitbox)]\n    bottoms = [bottom for bottom in bottoms if bottom >= previous_top - ENEMY_GROUND_PROBE]\n    return min(bottoms) if bottoms else None\n\n\n# Collision boxes lose 1 px a side, so a standing enemy probes this far into the floor, and a solid this far above its feet is floor.\nENEMY_GROUND_PROBE = 3\nGROUND_BEHAVIORS = ('patrol', 'jumper', 'scripted')\nKNOCKBACK_BEHAVIORS = GROUND_BEHAVIORS + ('flyer',)\n\n\ndef _stand_on(enemy, floor):\n    enemy.y = _solid_top(floor) + abs(get_height(enemy.hitbox)) / 2 - enemy.hitboxOffsetY\n    _sync_enemy_hitbox(enemy)\n\n\ndef _ride_ground(enemy):\n    # A grounded enemy moves with the moving platform it stands on, and so does its patrol range.\n    # A Scripted enemy's spawnX stays where it was placed, since its code may steer by it.\n    ride = enemy.groundSolid\n    if enemy.airborne or ride is None or ride._destroyed:\n        return\n    enemy.x += getattr(ride, 'dx', 0)\n    if enemy.behavior != 'scripted':\n        enemy.spawnX += getattr(ride, 'dx', 0)\n    enemy.y += getattr(ride, 'dy', 0)\n\n\ndef _fall_to_last_ground(enemy, gravity):\n    # In a room with no platforms, the height an enemy last stood at is its floor, so it can still hop.\n    if not enemy.airborne and enemy.hopDy <= 0:\n        return False\n    enemy.hopDy = max(enemy.hopDy + gravity, enemy.maxFallSpeed)\n    enemy.y += enemy.hopDy\n    floor_y = enemy.lastGround[1]\n    if enemy.y > floor_y:\n        enemy.airborne = True\n        _sync_enemy_hitbox(enemy)\n        return False\n    enemy.y = floor_y\n    enemy.airborne = False\n    enemy.hopDy = 0\n    _sync_enemy_hitbox(enemy)\n    return True\n\n\ndef _enemy_fall(enemy, gravity):\n    # Gravity for an enemy that walks or hops, stopping at floors and ceilings; True on the frame it lands.\n    if getattr(game, 'mapBottom', None) is None:\n        return _fall_to_last_ground(enemy, gravity)\n    _ride_ground(enemy)\n    _sync_enemy_hitbox(enemy)\n    half = abs(get_height(enemy.hitbox)) / 2\n    previous_bottom = enemy.hitbox.y - half\n    previous_top = enemy.hitbox.y + half\n    if not enemy.airborne and enemy.hopDy <= 0 and _still_on(enemy, enemy.groundSolid, previous_bottom):\n        enemy.lastGround = (enemy.x, enemy.y)\n        enemy.fallsOut = 0\n        return False\n    if enemy.airborne or enemy.hopDy > 0:\n        enemy.hopDy = max(enemy.hopDy + gravity, enemy.maxFallSpeed)\n        step = enemy.hopDy\n    else:\n        step = -ENEMY_GROUND_PROBE\n    enemy.y += step\n    _sync_enemy_hitbox(enemy)\n    if step <= 0:\n        floor = _floor_below(enemy, previous_bottom)\n        if floor is not None:\n            _stand_on(enemy, floor)\n            enemy.groundSolid = floor\n            landed = enemy.airborne\n            enemy.airborne = False\n            enemy.hopDy = 0\n            enemy.lastGround = (enemy.x, enemy.y)\n            enemy.fallsOut = 0\n            return landed\n    else:\n        ceiling = _ceiling_above(enemy, previous_top)\n        if ceiling is not None:\n            enemy.y = ceiling - half - enemy.hitboxOffsetY\n            _sync_enemy_hitbox(enemy)\n            enemy.hopDy = 0\n    enemy.groundSolid = None\n    enemy.airborne = True\n    return False\n\n\ndef _enemy_gravity(enemy):\n    return enemy.fallGravity if enemy.behavior == 'patrol' else enemy.hopGravity\n\n\ndef _unsquash_jumper(enemy):\n    # Undo last frame's squash offset, so the hop works with the real position.\n    enemy.scaleY = 1\n    enemy.y += get_height(enemy) * (1 - enemy.sqY) / 2\n\n\ndef _squash_jumper(enemy):\n    # Draw squashed with the feet where the hitbox's feet are.\n    enemy.y -= get_height(enemy) * (1 - enemy.sqY) / 2\n    enemy.scaleX = getattr(enemy, 'artFacing', 1) * enemy.dir * enemy.sqX\n    enemy.scaleY = enemy.sqY\n\n\ndef _jumper_step(enemy):\n    # Hop, land, pause, repeat - moves sideways only while in the air.\n    if _enemy_fall(enemy, enemy.hopGravity):\n        enemy.sqX = enemy.landingSquashX\n        enemy.sqY = enemy.landingSquashY\n    if enemy.airborne:\n        if _wall_ahead(enemy):\n            enemy.dir = -enemy.dir\n        enemy.x += enemy.dir * enemy.speed\n    elif enemy.hopPause > 0:\n        enemy.hopPause -= 1\n    else:\n        _choose_patrol_direction(enemy, enemy.y, _hop_reach(enemy), False)\n        enemy.hopDy = enemy.jumpSpeed\n        enemy.airborne = True\n        enemy.hopPause = enemy.hopPauseMax\n        enemy.sqX = enemy.jumpSquashX\n        enemy.sqY = enemy.jumpSquashY\n    if enemy.hopDy > 0:\n        _apply_pose(enemy, enemy.jumpUpPose)\n    elif not enemy.airborne:\n        _apply_pose(enemy, enemy.idlePose)\n    else:\n        _apply_pose(enemy, enemy.jumpDownPose)\n    enemy.sqX += (1.0 - enemy.sqX) * enemy.squashEaseRate\n    enemy.sqY += (1.0 - enemy.sqY) * enemy.squashEaseRate\n\n\ndef _fall_while_staggered(enemy):\n    # A staggered or beaten enemy keeps falling, so a knockback can push it off a ledge; a flying one falls only once beaten.\n    if enemy.behavior not in GROUND_BEHAVIORS or (enemy.flying and not enemy.dying):\n        return\n    _enemy_fall(enemy, _enemy_gravity(enemy))\n    _fell_out_of_room(enemy)\n\n\ndef _settle_on_floor(enemy):\n    # A ground enemy placed overlapping a floor stands on top of the one under its middle, not a step beside it.\n    _sync_enemy_hitbox(enemy)\n    floors = [solid for solid in _live_solids(enemy.hitbox)\n              if _solid_top(solid) <= enemy.hitbox.y + ENEMY_GROUND_PROBE and abs(solid.x - enemy.hitbox.x) <= abs(get_width(solid)) / 2]\n    if floors:\n        _stand_on(enemy, max(floors, key=_solid_top))\n\n\ndef _fell_out_of_room(enemy):\n    # Falling below the room beats an enemy, dropping its pickup where it last stood; a live Boss just returns there.\n    mapBottom = getattr(game, 'mapBottom', None)\n    margin = getattr(game, 'fallMarginOverride', None)\n    if mapBottom is None or enemy.y >= mapBottom - (PLAYER_CONFIG['fallMargin'] if margin is None else margin):\n        return False\n    enemy.airborne = False\n    enemy.hopDy = 0\n    if enemy.isBoss and not enemy.dying and enemy.fallsOut < 2:\n        # Falls in a row without landing: the first returns it to its last spot, the second to where it was placed, the third beats it.\n        enemy.x, enemy.y = enemy.lastGround if enemy.fallsOut == 0 else enemy.home\n        enemy.fallsOut += 1\n        _sync_enemy_hitbox(enemy)\n        return False\n    enemy.x, enemy.y = enemy.lastGround\n    if not enemy.dying:\n        _defeat_enemy(enemy)\n    # A flying enemy is left waiting to land before it drops its pickup; it never will now.\n    if enemy.dropPending:\n        enemy.dropPending = False\n        _drop_pickup(enemy)\n    destroy_object(enemy)\n    return True\n\n\ndef _step_dying(enemy):\n    # A beaten enemy flashes, falling until it lands; it is removed once it is on the ground and the flash is over.\n    _fall_while_staggered(enemy)\n    if enemy._destroyed or enemy.airborne:\n        return\n    if enemy.dropPending:\n        enemy.dropPending = False\n        _drop_pickup(enemy)\n    if enemy.hitFlashTimer <= 0:\n        destroy_object(enemy)\n\n\ndef _step_enemy(enemy):\n    # One frame of a live or beaten enemy, with a jumper's squash already undone.\n    if enemy.dying:\n        _step_dying(enemy)\n        return\n    if _hit_stopped():\n        return\n    if _step_stagger(enemy):\n        _fall_while_staggered(enemy)\n        return\n    _move_enemy(enemy)\n    if enemy._destroyed or enemy.dying:\n        return\n    if enemy.behavior in GROUND_BEHAVIORS and _fell_out_of_room(enemy):\n        return\n    _sync_enemy_hitbox(enemy)\n    if enemy.projectile is not None and enemy.behavior != 'scripted':\n        enemy.fireTimer -= 1\n        if enemy.fireTimer <= 0 and _player_in_range(enemy):\n            _fire_projectile(enemy, enemy.projectile, enemy.dir, False)\n            enemy.fireTimer = enemy.shootInterval\n\n\ndef _move_enemy(enemy):\n    if enemy.behavior == 'patrol':\n        # Turns around at an edge, a wall or patrolRange, whichever comes first.\n        if not enemy.airborne:\n            _patrol_step(enemy, enemy.y)\n        _enemy_fall(enemy, enemy.fallGravity)\n    elif enemy.behavior == 'flyer':\n        _flyer_step(enemy)\n    elif enemy.behavior == 'dropper':\n        _dropper_step(enemy)\n    elif enemy.behavior == 'scripted':\n        _scripted_step(enemy)\n    elif enemy.behavior == 'jumper':\n        _jumper_step(enemy)\n\n\ndef _flyer_step(enemy):\n    if _wall_ahead(enemy):\n        enemy.dir = -enemy.dir\n    enemy.x += enemy.dir * enemy.speed\n    if enemy.x > enemy.spawnX + enemy.patrolRange:\n        enemy.dir = -1\n    elif enemy.x < enemy.spawnX - enemy.patrolRange:\n        enemy.dir = 1\n    enemy.scaleX = getattr(enemy, 'artFacing', 1) * enemy.dir\n\n\ndef _dropper_step(enemy):\n    # Waits at its start, shakes when the player passes underneath, falls, rests on the floor, then rises back.\n    if enemy.dropState == 'wait':\n        _apply_pose(enemy, enemy.idlePose)\n        if enemy.dropPause > 0:\n            enemy.dropPause -= 1\n            return\n        player = getattr(game, 'player', None)\n        if player is not None and not player._destroyed and player.y < enemy.y and abs(player.x - enemy.hitbox.x) <= abs(get_width(enemy.hitbox)) / 2 + enemy.senseWidth:\n            enemy.dropState = 'warn'\n            enemy.dropPause = enemy.warnFrames\n            _apply_pose(enemy, enemy.droppingPose)\n    elif enemy.dropState == 'warn':\n        # Shakes in place before falling.\n        enemy.dropPause -= 1\n        enemy.x = enemy.spawnX + (enemy.warnShake if enemy.dropPause % 4 < 2 else -enemy.warnShake)\n        if enemy.dropPause <= 0:\n            enemy.x = enemy.spawnX\n            enemy.dropState = 'fall'\n            enemy.dropDy = 0\n    elif enemy.dropState == 'fall':\n        previous_bottom = enemy.hitbox.y - abs(get_height(enemy.hitbox)) / 2\n        enemy.dropDy = max(enemy.dropDy + enemy.fallGravity, enemy.maxFallSpeed)\n        enemy.y += enemy.dropDy\n        _sync_enemy_hitbox(enemy)\n        floor = _floor_below(enemy, previous_bottom)\n        if floor is not None:\n            _stand_on(enemy, floor)\n            enemy.dropState = 'landed'\n            enemy.dropPause = enemy.landedPauseMax\n            if _on_screen(enemy):\n                _add_camera_shake()\n                _play_sound('dropper')\n        elif enemy.y < enemy.spawnY - enemy.maxFall:\n            enemy.dropState = 'rise'\n    elif enemy.dropState == 'landed':\n        enemy.dropPause -= 1\n        if enemy.dropPause <= 0:\n            enemy.dropState = 'rise'\n    else:\n        _apply_pose(enemy, enemy.idlePose)\n        enemy.y = min(enemy.y + enemy.riseSpeed, enemy.spawnY)\n        if enemy.y >= enemy.spawnY:\n            enemy.dropState = 'wait'\n            enemy.dropPause = enemy.topPauseMax\n\n\ndef _freeze_for_win(obj):\n    # Once the level is won: show the still pose once, facing the same way.\n    if obj.winFrozen:\n        return\n    obj.winFrozen = True\n    facing = 1 if obj.scaleX * getattr(obj, 'artFacing', 1) >= 0 else -1\n    _apply_pose(obj, _load_pose(obj.stillPose, fps=0))\n    obj.scaleX = getattr(obj, 'artFacing', 1) * facing\n\n\ndef _fire_projectile(shooter, name, direction, from_player, shot=None):\n    # shot can hold: 'aim', a unit (dx, dy) to fly along instead of straight ahead; 'size'; 'speed';\n    # 'art', replacing the projectile's own art; and 'levelY', a height the shot heads for at 45 degrees\n    # before flying straight ahead.\n    shot = shot or {}\n    aim = shot.get('aim')\n    size = shot.get('size', 1)\n    level_y = shot.get('levelY')\n    p = Projectile()\n    projectileSprite = shot.get('art') or PROJECTILE_TYPES[name]['sprite']\n    _apply_pose(p, _load_pose(projectileSprite))\n    p.stillPose = projectileSprite\n    p.hitbox = _pose_hitbox(projectileSprite)\n    p.vx, p.vy = (direction, 0) if aim is None else aim\n    p.dir = direction\n    p.scaleX = getattr(p, 'artFacing', 1) * direction * size\n    p.scaleY = size\n    p.x = shooter.hitbox.x + p.vx * abs(get_width(shooter.hitbox)) / 2\n    p.y = (shooter.y if from_player else shooter.hitbox.y) + p.vy * abs(get_height(shooter.hitbox)) / 2\n    p.speed = (PROJECTILE_CONFIG['playerSpeed'] if from_player else PROJECTILE_CONFIG['enemySpeed']) if shot.get('speed') is None else shot['speed']\n    if level_y is not None and level_y != p.y:\n        p.levelY = level_y\n        p.vx = direction * 0.7071\n        p.vy = 0.7071 if level_y > p.y else -0.7071\n    p.angle = _travel_angle(p)\n    p.damage = PROJECTILE_CONFIG['damage']\n    p.maxDistance = PROJECTILE_CONFIG['maxDistance'] if from_player else shooter.bulletDistance\n    p.fromPlayer = from_player\n    p._visitToken = game.visitToken\n    if from_player:\n        _play_sound('shoot')\n    return p\n\n\ndef _travel_angle(p):\n    # The art points the way it flies; angle turns it counterclockwise after its left/right flip.\n    import math\n    return math.degrees(math.atan2(p.vy * p.dir, p.vx * p.dir))\n\n\ndef _projectile_touches(projectile, other):\n    # Only the projectile's drawn pixels collide, when its art says where they are.\n    return projectile.hitbox is None or _hitbox_touches(projectile, projectile.hitbox, other)\n\n\ndef _player_in_range(enemy):\n    player = _live_player()\n    if player is None:\n        return False\n    reach = enemy.noticeRange\n    return abs(player.x - enemy.x) <= reach and abs(player.y - enemy.y) <= reach / 2\n\n\ndef _foot_inset(cfg, height):\n    # Empty rows below the art: the space under the type's hitbox, if it has one.\n    box = cfg.get('hitbox')\n    return 0 if box is None else (1 - box['y'] - box['height']) * height\n\n\ndef _fit_enemy_hitbox(enemy, box):\n    # box is fractions of the art frame from its unflipped top-left; None is the whole frame.\n    if box is None:\n        box = {'x': 0, 'y': 0, 'width': 1, 'height': 1}\n    width = abs(get_width(enemy))\n    height = abs(get_height(enemy))\n    if enemy.hitboxBase is None:\n        # get_width and get_height include scale, so a refit scales from the size measured before the first fit.\n        enemy.hitboxBase = (get_width(enemy.hitbox), get_height(enemy.hitbox))\n    enemy.hitbox.scaleX = width * box['width'] / enemy.hitboxBase[0]\n    enemy.hitbox.scaleY = height * box['height'] / enemy.hitboxBase[1]\n    enemy.hitboxOffsetX = (box['x'] + box['width'] / 2 - 0.5) * width\n    enemy.hitboxOffsetY = (0.5 - box['y'] - box['height'] / 2) * height\n    _sync_enemy_hitbox(enemy)\n\n\ndef _sync_enemy_hitbox(enemy):\n    enemy.hitbox.x = enemy.x + (enemy.hitboxOffsetX if enemy.scaleX >= 0 else -enemy.hitboxOffsetX)\n    enemy.hitbox.y = enemy.y + enemy.hitboxOffsetY\n\n\ndef _apply_anchor(y, anchor, height, what, footInset=0):\n    # 'center' places the sprite center exactly at the resolved position\n    # (the uniform default, for both factories and grid-dispatched\n    # characters). 'cell_bottom' stands the visible art on the bottom of the\n    # cell-height box around that position - footInset is the empty rows\n    # below the type's hitbox - and does not search for floor geometry. It needs\n    # grid metadata regardless of whether at= was cell(), world(), or a name.\n    if anchor == 'center':\n        return y\n    if anchor == 'cell_bottom':\n        if getattr(game, 'mapRows', None) is None:\n            raise ValueError(f\"{what}'s anchor='cell_bottom' needs a room with a nonempty grid.\")\n        return y - CELL / 2 + height / 2 - footInset\n    raise ValueError(f\"{what}'s anchor must be 'center' or 'cell_bottom'.\")\n\n\ndef add_npc(*, at, lines=None, type=None, id=None, anchor='center'):\n    # lines is a list whose elements are either a plain string or a\n    # {'speaker': ..., 'text': ...} dict. Speaker labels belong to the\n    # dialogue data, not to the character placement. Touch the NPC and press\n    # 'e' to advance. type picks the visual from NPC_TYPES.\n    x, y = _resolve_at(at)\n    _reserve_id(id)\n    if lines is None:\n        raise ValueError('add_npc needs lines - the list of things they say.')\n    if not isinstance(lines, list):\n        raise ValueError('add_npc needs lines to be a list.')\n    _validate_dialogue_lines(lines, 'add_npc')\n    n = NPC()\n    cfg = _require_type(NPC_TYPES, type, \"add_npc's type\")\n    poses = cfg['poses']\n    idlePose = _resolve_pose(poses, 'idle')\n    _apply_pose(n, _load_pose(idlePose))\n    n.stillPose = idlePose\n    n.scaleX = getattr(n, 'artFacing', 1)\n    n.lines = lines\n    n.interactSeq = _next_interact_seq()\n    n.x = x\n    n.y = _apply_anchor(y, anchor, get_height(n), 'add_npc', _foot_inset(cfg, get_height(n)))\n    _register_instance('npc', type, n, id=id)\n    return n\n\n\ndef add_enemy(*, at, type=None, id=None, patrol_range=None, facing=1, anchor='center', shoot_interval=None):\n    # type picks a whole enemy type - look, behavior, contactDamage,\n    # maxHealth, and speed together, not independent choices.\n    x, y = _resolve_at(at)\n    _reserve_id(id)\n    if facing not in (-1, 1):\n        raise ValueError('add_enemy needs facing to be exactly -1 or 1.')\n    explicit_patrol_range = patrol_range is not None\n    if patrol_range is None:\n        patrol_range = ENEMY_DEFAULTS['patrolRange']\n    if isinstance(patrol_range, bool) or not isinstance(patrol_range, (int, float)) or patrol_range < 0:\n        raise ValueError('add_enemy needs patrol_range to be a finite nonnegative number.')\n    if shoot_interval is not None and (not _finite_number(shoot_interval) or shoot_interval <= 0):\n        raise ValueError(f'add_enemy needs shoot_interval to be a number of frames above 0, not {shoot_interval!r}.')\n    cfg = _require_type(ENEMY_TYPES, type, 'add_enemy')\n    behavior = cfg['behavior']\n    if behavior not in ENEMY_BEHAVIORS:\n        raise ValueError(f\"Enemy type {type!r} uses unknown behavior {behavior!r}.\")\n    poses = cfg['poses']\n    e = Enemy()\n    e.x = x\n    e.y = y\n    e.behavior = behavior\n    e.patrolRange = patrol_range * UNIT if explicit_patrol_range else patrol_range\n    e.speed = cfg.get('speed', 2 / 3 * UNIT)\n    e.dir = facing\n    e.contactDamage = cfg.get('contactDamage', 1)\n    e.health = cfg.get('maxHealth', 1)\n    e.projectile = cfg.get('projectile')\n    e.bulletDistance = cfg.get('bulletDistance', PROJECTILE_CONFIG['maxDistance'])\n    e.noticeRange = cfg.get('noticeRange', PROJECTILE_CONFIG['enemyRange'])\n    e.drop = cfg.get('drop')\n    e.dropChance = cfg.get('dropChance', 100)\n    e.dropSetsGlobal = cfg.get('dropSetsGlobal')\n    if e.dropSetsGlobal is not None:\n        _validate_global(e.dropSetsGlobal, 'add_enemy')\n        if _global_type(e.dropSetsGlobal) != 'bool':\n            raise ValueError(f\"Enemy type {type!r} drops a pickup that sets {e.dropSetsGlobal!r}, which is type {_global_type(e.dropSetsGlobal)!r}; it must be a boolean global.\")\n    e.typeName = type\n    e.maxHealth = e.health\n    e.poses = poses\n    e.isBoss = cfg.get('boss', False) is True\n    e.beatenSetsGlobal = cfg.get('beatenSetsGlobal')\n    if e.beatenSetsGlobal is not None:\n        _validate_global(e.beatenSetsGlobal, 'add_enemy')\n        if _global_type(e.beatenSetsGlobal) != 'bool':\n            raise ValueError(f\"Enemy type {type!r} sets {e.beatenSetsGlobal!r} when beaten, which is type {_global_type(e.beatenSetsGlobal)!r}; it must be a boolean global.\")\n    e.shootInterval = PROJECTILE_CONFIG['enemyFireInterval'] if shoot_interval is None else shoot_interval\n    e.fireTimer = e.shootInterval\n    e.stillPose = _resolve_pose(poses, 'idle')\n    for key, value in ENEMY_BEHAVIORS.get(behavior, {}).items():\n        setattr(e, key, value)\n\n    if behavior == 'dropper':\n        e.invincible = True\n        e.idlePose = _load_pose(_resolve_pose(poses, 'idle'))\n        e.droppingPose = _load_pose(_resolve_pose(poses, 'dropping'))\n        _apply_pose(e, e.idlePose)\n    elif behavior == 'jumper':\n        e.jumpUpPose = _load_pose(_resolve_pose(poses, 'jumpUp'))\n        e.jumpDownPose = _load_pose(_resolve_pose(poses, 'jumpDown'))\n        e.idlePose = _load_pose(_resolve_pose(poses, 'idle'))\n        _apply_pose(e, e.jumpUpPose)\n    elif behavior == 'patrol':\n        _set_character_pose(e, poses, 'run')\n    else:\n        _set_character_pose(e, poses, 'idle')\n    e.scaleX = getattr(e, 'artFacing', 1) * e.dir\n    e.y = _apply_anchor(y, anchor, get_height(e), 'add_enemy', _foot_inset(cfg, get_height(e)))\n    _fit_enemy_hitbox(e, cfg.get('hitbox'))\n    if behavior in GROUND_BEHAVIORS:\n        _settle_on_floor(e)\n    e.spawnX = e.x\n    e.spawnY = e.y\n    e.lastGround = (e.x, e.y)\n    _register_instance('enemy', type, e, id=id)\n    if e.isBoss:\n        _add_boss_bar(e)\n    if behavior == 'scripted':\n        e.poseName = 'idle'\n        start = _enemy_script(e, 'start')\n        e.loopScript = _enemy_script(e, 'loop')\n        if start is not None:\n            maxHealth = e.maxHealth\n            start(e)\n            if e._destroyed:\n                return e\n            _check_enemy_fields(e, 'Start')\n            if e.maxHealth == maxHealth:\n                e.maxHealth = e.health\n            _face_enemy_art(e)\n            _fit_enemy_hitbox(e, cfg.get('hitbox'))\n            if not e.flying:\n                _settle_on_floor(e)\n            e.spawnX = e.x\n            e.spawnY = e.y\n            e.lastGround = (e.x, e.y)\n    e.home = (e.x, e.y)\n    return e\n\n\ndef _enemy_script(enemy, phase):\n    scripts = ENEMY_SCRIPTS.get(enemy.typeName)\n    return None if scripts is None else scripts[phase]\n\n\ndef _face_enemy_art(enemy):\n    enemy.dir = -1 if enemy.dir < 0 else 1\n    enemy.scaleX = getattr(enemy, 'artFacing', 1) * enemy.dir * (abs(enemy.scaleX) or 1)\n\n\ndef _check_enemy_fields(enemy, phase):\n    # The message starts \"In <label>'s <phase> code:\", which Studio uses to point at that code.\n    for name in ('x', 'y', 'dir', 'speed', 'health', 'maxHealth'):\n        value = getattr(enemy, name)\n        if not _finite_number(value):\n            raise ValueError(f\"In {ENEMY_SCRIPTS[enemy.typeName]['label']}'s {phase} code: self.{name} needs to be a number, not {value!r}.\")\n    if not isinstance(enemy.flying, bool):\n        raise ValueError(f\"In {ENEMY_SCRIPTS[enemy.typeName]['label']}'s {phase} code: self.flying needs to be True or False, not {enemy.flying!r}.\")\n\n\ndef _scripted_step(enemy):\n    loop = enemy.loopScript\n    startX = enemy.x\n    startY = enemy.y\n    if loop is not None:\n        loop(enemy)\n    if enemy._destroyed:\n        return\n    if loop is not None:\n        _check_enemy_fields(enemy, 'Loop')\n    _stop_at_walls(enemy, startX)\n    _stop_at_floor(enemy, startY)\n    _stop_at_ceiling(enemy, startY)\n    if enemy.flying:\n        enemy.airborne = False\n        enemy.hopDy = 0\n        enemy.groundSolid = None\n    else:\n        _enemy_fall(enemy, enemy.hopGravity)\n    _face_enemy_art(enemy)\n\n\ndef _stop_at_walls(enemy, startX):\n    # Walls and the room's edge undo a Scripted enemy's sideways move, unless it started inside a wall.\n    if enemy.x == startX:\n        return\n    _sync_enemy_hitbox(enemy)\n    if not _in_wall(enemy):\n        return\n    movedX = enemy.x\n    enemy.x = startX\n    _sync_enemy_hitbox(enemy)\n    if _in_wall(enemy):\n        enemy.x = movedX\n        _sync_enemy_hitbox(enemy)\n\n\ndef _stop_at_floor(enemy, startY):\n    # A Scripted enemy's code that moves it down into a floor leaves it standing on that floor.\n    if enemy.y >= startY:\n        return\n    _sync_enemy_hitbox(enemy)\n    feet = enemy.hitbox.y - abs(get_height(enemy.hitbox)) / 2\n    floor = _floor_below(enemy, feet + startY - enemy.y, 0)\n    if floor is not None:\n        _stand_on(enemy, floor)\n\n\ndef _stop_at_ceiling(enemy, startY):\n    # A Scripted enemy's code that moves it up into a ceiling leaves it just under that ceiling.\n    if enemy.y <= startY:\n        return\n    _sync_enemy_hitbox(enemy)\n    half = abs(get_height(enemy.hitbox)) / 2\n    ceiling = _ceiling_above(enemy, enemy.hitbox.y + half - (enemy.y - startY))\n    if ceiling is not None:\n        enemy.y = ceiling - half - enemy.hitboxOffsetY\n        _sync_enemy_hitbox(enemy)\n\n\ndef _require_enemy(enemy, what):\n    _require_live_handle(enemy, what)\n    if not getattr(enemy, '_isEnemy', False):\n        raise ValueError(f\"{what} needs an enemy, such as self in an enemy's code.\")\n\n\ndef _live_player():\n    player = getattr(game, 'player', None)\n    return None if player is None or player._destroyed else player\n\n\ndef face_player(enemy):\n    _require_enemy(enemy, 'face_player')\n    player = _live_player()\n    if player is not None and player.x != enemy.x:\n        enemy.dir = 1 if player.x > enemy.x else -1\n        _face_enemy_art(enemy)\n\n\ndef player_distance(enemy):\n    _require_enemy(enemy, 'player_distance')\n    player = _live_player()\n    if player is None:\n        return None\n    return (player.x - enemy.x, player.y - enemy.y)\n\n\nMAX_SHOT_SIZE = 4\nMAX_SHOT_SPEED = 20\n\n\ndef _shot_aim(enemy):\n    # A unit (dx, dy) from the enemy toward the player's middle, or None with no player.\n    player = _live_player()\n    if player is None:\n        return None\n    target = getattr(player, 'hitbox', None) or player\n    dx = target.x - enemy.hitbox.x\n    dy = target.y - enemy.hitbox.y\n    length = (dx * dx + dy * dy) ** 0.5\n    return None if length == 0 else (dx / length, dy / length)\n\n\ndef _check_shot(at_player, size, speed, sprite, level_y):\n    if level_y is not None and not _finite_number(level_y):\n        raise ValueError(f'enemy_shoot needs level_y to be a height in the room, such as self.y - 20, not {level_y!r}.')\n    if not isinstance(at_player, bool):\n        raise ValueError(f'enemy_shoot needs at_player to be True or False, not {at_player!r}.')\n    if level_y is not None and at_player:\n        raise ValueError('enemy_shoot can aim at_player or head for level_y, not both.')\n    if not _finite_number(size) or not 0 < size <= MAX_SHOT_SIZE:\n        raise ValueError(f'enemy_shoot needs size to be a number above 0 and at most {MAX_SHOT_SIZE}, not {size!r}.')\n    if speed is not None and (not _finite_number(speed) or not 0 < speed <= MAX_SHOT_SPEED):\n        raise ValueError(f'enemy_shoot needs speed to be a number of pixels per frame above 0 and at most {MAX_SHOT_SPEED}, not {speed!r}.')\n    if sprite is not None and (not isinstance(sprite, str) or not sprite):\n        raise ValueError(f\"enemy_shoot needs sprite to be an art name such as 'fireball.png', not {sprite!r}.\")\n\n\ndef enemy_shoot(enemy, at_player=False, size=1, speed=None, sprite=None, level_y=None):\n    _require_enemy(enemy, 'enemy_shoot')\n    _check_shot(at_player, size, speed, sprite, level_y)\n    if enemy.projectile is None and sprite is None:\n        raise ValueError(\"enemy_shoot needs the enemy to have a projectile, or a sprite='art name'. Choose a projectile in Characters.\")\n    if enemy.dying:\n        return None\n    _face_enemy_art(enemy)\n    _sync_enemy_hitbox(enemy)\n    aim = _shot_aim(enemy) if at_player else None\n    direction = enemy.dir if aim is None or aim[0] == 0 else (1 if aim[0] > 0 else -1)\n    return _fire_projectile(enemy, enemy.projectile, direction, False, {'aim': aim, 'size': size, 'speed': None if speed is None else speed * UNIT, 'art': sprite, 'levelY': level_y})\n\n\ndef wall_ahead(enemy):\n    _require_enemy(enemy, 'wall_ahead')\n    return _wall_ahead(enemy)\n\n\ndef ground_ahead(enemy):\n    _require_enemy(enemy, 'ground_ahead')\n    return _ground_ahead(enemy, -1 if enemy.dir < 0 else 1, enemy.y)\n\n\ndef set_pose(enemy, name):\n    _require_enemy(enemy, 'set_pose')\n    if enemy.behavior != 'scripted':\n        raise ValueError('set_pose only works for an enemy with the Scripted behaviour.')\n    if name not in ENEMY_POSE_NAMES:\n        names = ', '.join(repr(pose) for pose in ENEMY_POSE_NAMES)\n        raise ValueError(f\"set_pose needs one of {names}, not {name!r}.\")\n    if enemy.poseName == name or enemy.dying:\n        return\n    enemy.poseName = name\n    _set_character_pose(enemy, enemy.poses, name)\n    _face_enemy_art(enemy)\n\n\ndef jump(enemy, speed):\n    _require_enemy(enemy, 'jump')\n    if not _finite_number(speed) or speed <= 0:\n        raise ValueError('jump needs a speed above 0, in pixels per frame.')\n    if enemy.behavior != 'scripted':\n        raise ValueError('jump only works for an enemy with the Scripted behaviour.')\n    if enemy.airborne or enemy.flying:\n        return\n    enemy.airborne = True\n    enemy.hopDy = speed * UNIT\n\n\ndef in_air(enemy):\n    _require_enemy(enemy, 'in_air')\n    return enemy.airborne\n\n\ndef _live_boss_bars():\n    # Bars from an earlier room are not always marked destroyed, so a bar also has to belong to this visit.\n    return [bar for bar in getattr(game, 'bossBars', []) if not bar._destroyed and bar.visit == game.visitToken]\n\n\ndef _add_boss_bar(enemy):\n    bars = _live_boss_bars()\n    bar = BossBar()\n    bar.visit = game.visitToken\n    bar.owner = enemy\n    bar.label.text = _boss_name(enemy.typeName)\n    bars.append(bar)\n    game.bossBars = bars\n\n\ndef _boss_name(type_name):\n    name = ENEMY_TYPES[type_name].get('name')\n    return name if isinstance(name, str) and name else type_name.replace('_', ' ').title()"
            }
          },
          {
            "grid.py": {
              "type": "function script",
              "head": "# LEGEND-grid scanning and dispatch - turns a map's grid + 'objects' list\n# into real object instances, dispatching into every other objects/ file's\n# own add_*()/_new_*() factories.\n\n\ndef _add_boundary_wall(x, y, width, height):\n    # An invisible solid wall used to contain a bounded room's left/right edges.\n    wall = EdgeWall()\n    _apply_pose(wall, _load_pose('pixel.png'))\n    wall.visible = False\n    wall.scaleX = width\n    wall.scaleY = height\n    wall.x = x\n    wall.y = y\n    return wall\n\n\ndef _place(category, type, x, y):\n    # Legend-token dispatch for the simple, argument-free categories only -\n    # anything needing extra fields (key/barrier/switch/sign/npc/an exit\n    # with a destination or requires) is declared through 'objects' instead, never a bare\n    # legend token.\n    at = world(x, y)\n    if category == 'platform':\n        return add_platform(at=at, type=type)\n    if category == 'hazard':\n        return add_hazard(at=at, type=type)\n    if category == 'collectible':\n        return add_collectible(at=at, type=type)\n    if category == 'decor':\n        return add_decor(at=at, type=type)\n    if category == 'climbable':\n        return add_climbable(at=at, type=type)\n    if category == 'enemy':\n        return add_enemy(at=at, type=type)\n    if category == 'exit':\n        return add_exit(at=at, type=type)\n    raise ValueError(\n        f\"Unknown placement category {category!r} - expected one of \"\n        \"'platform', 'hazard', 'collectible', 'decor', 'climbable', 'enemy', 'exit'.\"\n    )\n\n\n# Every declarative category's allowed keys - kept in lockstep with the\n# factory it dispatches to, so a field the factory accepts can't silently\n# vanish here, and a typo'd/unsupported field is caught instead of being\n# dropped on the floor. The category-to-factory mapping is literal, per the\n# implementation spec: platform, wall, collectible, decor, climbable, key, barrier,\n# switch, hazard, enemy, npc, sign, exit.\nOBJECT_SPEC_KEYS = {\n    'platform': {'category', 'at', 'type', 'launch_speed'},\n    'wall': {'category', 'at', 'type'},\n    'collectible': {'category', 'at', 'type', 'sets_global', 'id', 'remember_as'},\n    'decor': {'category', 'at', 'type', 'id'},\n    'climbable': {'category', 'at', 'type', 'id'},\n    'key': {'category', 'at', 'type', 'sets_global', 'id', 'remember_as'},\n    'barrier': {'category', 'at', 'type', 'requires', 'id', 'remember_as'},\n    'switch': {'category', 'at', 'type', 'sets_global', 'id', 'remember_as', 'reusable', 'activation'},\n    'hazard': {'category', 'at', 'type', 'id'},\n    'enemy': {'category', 'at', 'type', 'id', 'patrol_range', 'facing', 'anchor', 'shoot_interval'},\n    'npc': {'category', 'at', 'type', 'lines', 'id', 'anchor'},\n    'sign': {'category', 'at', 'type', 'lines', 'id'},\n    'exit': {'category', 'at', 'type', 'destination', 'activation', 'requires', 'success_text', 'fail_text', 'id'},\n}\n# 'layer' is data-only rendering provenance (which source layer a\n# converter-generated placement came from), never a factory gameplay\n# argument - allowed on every category alongside its own keys, per the\n# implementation spec's converter-ownership rules.\n# 'appears_when' / 'disappears_when' name declared boolean global(s): the\n# placement exists only while they are all true / not all true (see\n# _update_appearing). Every category takes them.\nPRESENCE_KEYS = ('appears_when', 'disappears_when')\nfor _keys in OBJECT_SPEC_KEYS.values():\n    _keys.add('layer')\n    _keys.update(PRESENCE_KEYS)\n\nOBJECT_SPEC_REQUIRED = {\n    'platform': ('at', 'type'), 'wall': ('at', 'type'),\n    'collectible': ('at', 'type'), 'decor': ('at', 'type'), 'climbable': ('at', 'type'),\n    'key': ('at', 'type', 'sets_global'), 'barrier': ('at', 'type', 'requires'),\n    'switch': ('at', 'type', 'sets_global'), 'hazard': ('at', 'type'),\n    'enemy': ('at', 'type'), 'npc': ('at', 'type', 'lines'),\n    'sign': ('at', 'type', 'lines'), 'exit': ('at', 'type'),\n}\n\n\ndef _validate_object_spec_shape(spec):\n    # Schema-level preflight only (category/keys/required fields) - run over\n    # every declaration before any of them is constructed, so a malformed\n    # last declaration can't leave earlier ones half-built.\n    if not isinstance(spec, dict) or 'category' not in spec:\n        raise ValueError(\"Map option 'objects' needs dictionaries with a category.\")\n    category = spec['category']\n    allowed = OBJECT_SPEC_KEYS.get(category)\n    if allowed is None:\n        raise ValueError(f\"Unknown map object category {category!r}.\")\n    unsupported = spec.keys() - allowed\n    if unsupported:\n        raise ValueError(\n            f\"Map object of category {category!r} has unsupported field(s) \"\n            f\"{sorted(unsupported)!r}.\"\n        )\n    for key in OBJECT_SPEC_REQUIRED[category]:\n        if key not in spec:\n            raise ValueError(f\"Map object of category {category!r} needs {key!r}.\")\n\n\ndef _resolve_object_layer(layer, layer_names, layer_count):\n    # 'layer' names rendering provenance, not identity - a string is\n    # resolved against the room's current layer_names (robust to layer\n    # reordering across reconversions); an int indexes the current layers\n    # list directly.\n    if isinstance(layer, str):\n        if not layer_names or layer not in layer_names:\n            raise ValueError(f\"Map object references unknown layer {layer!r}.\")\n        return layer_names.index(layer)\n    if isinstance(layer, int) and not isinstance(layer, bool):\n        if layer < 0 or layer >= layer_count:\n            raise ValueError(f\"Map object layer index {layer} is out of range for {layer_count} layer(s).\")\n        return layer\n    raise ValueError(\"Map object 'layer' must be a layer name (str) or index (int).\")\n\n\ndef _dispatch_object(spec):\n    category = spec['category']\n    at = spec['at']\n    type_ = spec['type']\n    if category == 'platform':\n        return add_platform(at=at, type=type_, launch_speed=spec.get('launch_speed'))\n    if category == 'wall':\n        return add_wall(at=at, type=type_)\n    if category == 'collectible':\n        return add_collectible(at=at, type=type_, sets_global=spec.get('sets_global'),\n                                id=spec.get('id'), remember_as=spec.get('remember_as'))\n    if category == 'decor':\n        return add_decor(at=at, type=type_, id=spec.get('id'))\n    if category == 'climbable':\n        return add_climbable(at=at, type=type_, id=spec.get('id'))\n    if category == 'key':\n        return add_key(at=at, type=type_, sets_global=spec['sets_global'],\n                        id=spec.get('id'), remember_as=spec.get('remember_as'))\n    if category == 'barrier':\n        return add_barrier(at=at, type=type_, requires=spec['requires'],\n                            id=spec.get('id'), remember_as=spec.get('remember_as'))\n    if category == 'switch':\n        return add_switch(at=at, type=type_, sets_global=spec['sets_global'],\n                           id=spec.get('id'), remember_as=spec.get('remember_as'),\n                           reusable=spec.get('reusable', False), activation=spec.get('activation', 'touch'))\n    if category == 'hazard':\n        return add_hazard(at=at, type=type_, id=spec.get('id'))\n    if category == 'enemy':\n        return add_enemy(at=at, type=type_, id=spec.get('id'),\n                          patrol_range=spec.get('patrol_range'), facing=spec.get('facing', 1),\n                          anchor=spec.get('anchor', 'center'), shoot_interval=spec.get('shoot_interval'))\n    if category == 'npc':\n        return add_npc(at=at, type=type_, lines=spec['lines'],\n                        id=spec.get('id'), anchor=spec.get('anchor', 'center'))\n    if category == 'sign':\n        return add_sign(at=at, type=type_, lines=spec['lines'], id=spec.get('id'))\n    return add_exit(at=at, type=type_, destination=spec.get('destination'),\n                    activation=spec.get('activation', 'touch'), requires=spec.get('requires'),\n                    fail_text=spec.get('fail_text'), success_text=spec.get('success_text'),\n                    id=spec.get('id'))\n\n\ndef _apply_object_layer(obj, spec, layer):\n    if 'layer' not in spec:\n        return\n    layer_idx = _resolve_object_layer(spec['layer'], layer['names'], layer['count'])\n    obj.alpha = layer['alpha'](layer_idx)\n    _apply_map_layer_z(obj, layer_idx, layer['names'], layer['preserve_z_order'], layer['count'])\n\n\ndef _create_appearing(entry):\n    # build_tilemap reserved the placement's names for the whole visit; this\n    # entry owns them, so it releases them before building the placement again.\n    spec = entry['spec']\n    for store, key in ((game.reservedIds, 'id'), (game.reservedRememberAs, 'remember_as')):\n        if spec.get(key) is not None:\n            store.discard(spec[key])\n    obj = _dispatch_object(spec)\n    if obj is None:\n        # Already resolved (a remembered pickup or opened barrier).\n        entry['done'] = True\n        return\n    _apply_object_layer(obj, spec, entry['layer'])\n    entry['obj'] = obj\n\n\ndef _present(entry):\n    appears, disappears = entry['appears_when'], entry['disappears_when']\n    if appears is not None and not _requires_met(appears):\n        return False\n    return disappears is None or not _requires_met(disappears)\n\n\ndef _update_appearing():\n    # A placement with appears_when exists while its globals are all true; one\n    # with disappears_when is removed while its globals are all true. Removal\n    # destroys it and it is built fresh when it returns. One that was\n    # collected, defeated or opened stays gone for the rest of the visit.\n    for entry in game.appearing:\n        if entry['done']:\n            continue\n        obj = entry['obj']\n        if obj is not None and obj._destroyed:\n            entry['done'] = True\n            continue\n        met = _present(entry)\n        if met and obj is None:\n            _create_appearing(entry)\n        elif not met and obj is not None:\n            entry['obj'] = None\n            destroy_object(obj)\n\n\ndef _resolve_room_locations(locations, rows, cols, origin_x, origin_y, has_grid):\n    # World positions are already final coordinates and are never shifted by\n    # grid origin. A cell() location needs grid metadata to resolve; a\n    # world-authored room (no grid) can only declare world() locations.\n    resolved = {}\n    for name, pos in locations.items():\n        if pos['_posKind'] == 'world':\n            resolved[name] = (pos['x'], pos['y'])\n            continue\n        if not has_grid:\n            raise ValueError(f\"Map location {name!r} uses cell(...), but this room has no grid (layers=[]).\")\n        row, col = pos['row'], pos['col']\n        if row >= rows or col >= cols:\n            raise ValueError(f\"Map location {name!r} needs a whole cell inside this map.\")\n        x, y = _cell_center(row, col, rows)\n        resolved[name] = (x - origin_x, y - origin_y)\n    return resolved\n\n\ndef _apply_map_layer_z(obj, layer_idx, layer_names, preserve_z_order, layer_count):\n    if not preserve_z_order:\n        return\n    layer_bump = (layer_count - layer_idx) / (layer_count + 1)\n    if layer_names and layer_names[layer_idx].strip().lower() == 'background':\n        # Background-start.py uses z=-10. Keep named background art above that\n        # full-screen sprite, but below platforms and other world objects.\n        obj.z = -10 + layer_bump\n        return\n    obj.z += layer_bump\n\n\ndef _build_terrain(terrain_cells, rows, origin_x, origin_y, layer_alpha, layer_names, preserve_z_order, layer_count):\n    game.suppressGroundTracking = True\n    tile_size = None\n    for (row, col), type_name, layer_idx in terrain_cells:\n        x, y = _cell_center(row, col, rows)\n        x -= origin_x\n        y -= origin_y\n        obj = _place('platform', type_name, x, y)\n        assert obj is not None\n        obj.alpha = layer_alpha(layer_idx)\n        _apply_map_layer_z(obj, layer_idx, layer_names, preserve_z_order, layer_count)\n        measured = (get_width(obj), get_height(obj))\n        if tile_size is None:\n            tile_size = measured\n        elif measured != tile_size:\n            raise ValueError(\n                f\"All terrain tiles in one map must be the same size - \"\n                f\"found {tile_size} and {measured} (type {type_name!r}).\"\n            )\n        if measured[0] != CELL or measured[1] != CELL:\n            raise ValueError(\n                f\"Terrain tile {type_name!r} measures {measured}, expected \"\n                f\"{CELL}x{CELL} - check CELL and the tile art.\"\n            )\n    game.suppressGroundTracking = False\n    _track_ground_extent(-origin_y - CELL / 2)\n\n\ndef _build_entities(entity_cells, rows, origin_x, origin_y, layer_alpha, layer_names, preserve_z_order, layer_count):\n    for (row, col), category, type_name, layer_idx in entity_cells:\n        x, y = _cell_center(row, col, rows)\n        x -= origin_x\n        y -= origin_y\n        obj = _place(category, type_name, x, y)\n        # A legend-dispatched collectible never passes remember_as, so it\n        # can never come back as an absent (None) pickup - unlike an\n        # authored 'objects'/direct-call collectible, which can.\n        assert obj is not None\n        obj.alpha = layer_alpha(layer_idx)\n        _apply_map_layer_z(obj, layer_idx, layer_names, preserve_z_order, layer_count)\n\n\ndef _layer_alpha_fn(layer_names, layer_opacity, layer_count):\n    if layer_names and len(layer_names) != layer_count:\n        raise ValueError(\"Map option 'layer_names' must name every layer, in order.\")\n\n    def layer_alpha(index):\n        name = layer_names[index] if layer_names else index\n        alpha = layer_opacity.get(name, 1)\n        if not isinstance(alpha, (int, float)) or alpha < 0 or alpha > 1:\n            raise ValueError(f\"Layer opacity for {name!r} must be a number from 0 to 1.\")\n        return alpha\n    return layer_alpha\n\n\ndef _apply_camera_and_boundary(camera, boundary, left, right, bottom, top):\n    # 'camera' controls only the view: whether it's clamped to the extent or\n    # free to scroll anywhere. 'boundary' controls only physical edges:\n    # whether invisible walls stop the player at the extent's left/right\n    # edges. The two are independent.\n    game.cameraBounds = (left, right, bottom, top) if camera != 'free' else None\n    if boundary:\n        # No top/bottom walls: the bottom is the kill plane on purpose.\n        mid_y = (bottom + top) / 2\n        thickness = CELL\n        height = max((top - bottom) + 2 * CELL, ENGINE_DEFAULTS['viewport']['height'] * 4)\n        _add_boundary_wall(left - thickness / 2, mid_y, thickness, height)\n        _add_boundary_wall(right + thickness / 2, mid_y, thickness, height)\n\n\ndef build_tilemap():\n    # Builds the current room (MAPS[game.room]) exactly once per visit -\n    # calling it twice raises without duplication. Returns None -\n    # of_type()/get_object() read what this built off `game`.\n    global CELL\n    if getattr(game, 'tilemapBuilt', False):\n        raise ValueError('build_tilemap() was already called this visit - it only runs once per room entry.')\n    if game.room not in MAPS:\n        raise ValueError(\n            f\"No map registered for room {game.room!r} in MAPS - add MAPS[{game.room!r}] = ... in maps.py.\"\n        )\n    normalized = _normalize_room(MAPS[game.room])\n    has_grid = normalized['has_grid']\n    map_tile_size = normalized['tile_size'] if normalized['tile_size'] is not None else ENGINE_DEFAULTS['tilemap']['defaultCell']\n    CELL = map_tile_size\n\n    # 0, not None, when there's no grid - only ever read inside a\n    # `has_grid` branch below, but keeping them plain ints (rather than\n    # Optional) avoids static-checker noise at every arithmetic use.\n    rows = cols = 0\n    terrain_cells = entity_cells = []\n    origin_x, origin_y = 0, 0\n    if has_grid:\n        rows, cols, terrain_cells, entity_cells = _parse_layers(normalized['layers'], normalized['legend'])\n        game.mapRows = rows\n        game.mapCols = cols\n        origin = normalized['origin']\n        if origin is not None:\n            row, col = origin['row'], origin['col']\n            if row >= rows or col >= cols:\n                raise ValueError(\"Map option 'origin' must be a whole cell inside the grid.\")\n            origin_x, origin_y = _cell_center(row, col, rows)\n    game.originX = origin_x\n    game.originY = origin_y\n\n    game.locations = _resolve_room_locations(normalized['locations'], rows, cols, origin_x, origin_y, has_grid)\n\n    layer_count = len(normalized['layers']) if has_grid else 0\n    layer_alpha = _layer_alpha_fn(normalized['layer_names'], normalized['layer_opacity'], layer_count)\n\n    if has_grid:\n        _build_terrain(terrain_cells, rows, origin_x, origin_y, layer_alpha, normalized['layer_names'], normalized['preserve_z_order'], layer_count)\n        _build_entities(entity_cells, rows, origin_x, origin_y, layer_alpha, normalized['layer_names'], normalized['preserve_z_order'], layer_count)\n\n    # Preflight every declarative object before constructing any of them, so\n    # a malformed last declaration can't leave earlier declarations alive.\n    object_specs = normalized['objects']\n    for spec in object_specs:\n        _validate_object_spec_shape(spec)\n        if 'layer' in spec:\n            _resolve_object_layer(spec['layer'], normalized['layer_names'], layer_count)\n        for key in PRESENCE_KEYS:\n            if key in spec:\n                if spec[key] is None:\n                    raise ValueError(f\"Map object {key!r} needs a global name or a list of names.\")\n                _validate_requires(spec[key], f\"Map object {key!r}\")\n    layer = {'names': normalized['layer_names'], 'count': layer_count, 'alpha': layer_alpha,\n             'preserve_z_order': normalized['preserve_z_order']}\n    game.appearing = []\n    for spec in object_specs:\n        if any(key in spec for key in PRESENCE_KEYS):\n            _reserve_id(spec.get('id'))\n            _reserve_remember_as(spec.get('remember_as'))\n            game.appearing.append({\n                'spec': {key: value for key, value in spec.items() if key not in PRESENCE_KEYS},\n                'appears_when': spec.get('appears_when'), 'disappears_when': spec.get('disappears_when'),\n                'layer': layer, 'obj': None, 'done': False,\n            })\n            continue\n        obj = _dispatch_object(spec)\n        if obj is not None:\n            _apply_object_layer(obj, spec, layer)\n    _update_appearing()\n\n    fall_margin = normalized['fall_margin']\n    game.fallMarginOverride = fall_margin * CELL if fall_margin is not None else None\n    game.mapBackground = normalized['background']\n\n    if has_grid:\n        left = -origin_x - CELL / 2\n        right = (cols - 1) * CELL - origin_x + CELL / 2\n        bottom = -origin_y - CELL / 2\n        top = (rows - 1) * CELL - origin_y + CELL / 2\n    elif normalized['bounds'] is not None:\n        b = normalized['bounds']\n        left, right, bottom, top = b['left'], b['right'], b['bottom'], b['top']\n    else:\n        left = right = bottom = top = None\n\n    if left is not None:\n        _apply_camera_and_boundary(normalized['camera'], normalized['boundary'], left, right, bottom, top)\n        if not has_grid:\n            # Grid rooms already tracked their own extent bottom in\n            # _build_terrain; a world room's explicit bounds establishes the\n            # same baseline here - later add_platform/add_wall calls in the\n            # room-start script can still lower it further.\n            _track_ground_extent(bottom)\n    else:\n        game.cameraBounds = None\n\n    game.tilemapBuilt = True\n    return None"
            }
          }
        ]
      },
      {
        "config.py": {
          "type": "function script",
          "head": "# Game settings - change these to customize the game.\nPLAYER_CONFIG = {\n    \"maxHealth\": 3,\n    \"fallMargin\": 80,\n    \"hitboxWidthPercent\": 50,\n    \"hitboxHeightPercent\": 60,\n    \"accel\": 0.6666666666666666,\n    \"decel\": 0.6666666666666666,\n    \"maxSpeed\": 1.5555555555555554,\n    \"jumpSpeed\": 4.444444444444445,\n    \"fallMult\": 2,\n    \"gravity\": -0.18871111111111108,\n    \"terminalVel\": -4.444444444444445,\n    \"jumpCut\": 0.4,\n    \"coyoteMax\": 10,\n    \"bufferMax\": 9,\n    \"invulnerableFrames\": 30,\n    \"damageFlashFrames\": 8,\n    \"blinkCycleFrames\": 4,\n    \"knockbackX\": 5.333333333333333,\n    \"knockbackY\": 1.7777777777777777,\n    \"landingSquashX\": 1.3,\n    \"landingSquashY\": 0.7,\n    \"jumpSquashX\": 0.7,\n    \"jumpSquashY\": 1.3,\n    \"squashEaseRate\": 0.1,\n    \"stompBounce\": 0.6,\n    \"stompDamage\": 1,\n    \"launchJumpMultiplier\": 1.4,\n    \"climbSpeed\": 1.3333333333333333,\n    \"poses\": {\"idle\": {\"pose\": (\"tileset.png\", 13), \"facing\": 1}, \"run\": {\"pose\": (\"tileset.png\", 13), \"facing\": 1}, \"jumpUp\": {\"pose\": (\"tileset.png\", 15), \"facing\": 1}, \"jumpDown\": {\"pose\": (\"tileset.png\", 16), \"facing\": 1}, \"climb\": {\"pose\": (\"tileset.png\", 13), \"facing\": 1}, \"attack\": {\"pose\": (\"tileset.png\", 16), \"facing\": 1}, \"strike\": {\"pose\": (\"slash.png\", 0), \"facing\": 1}},\n    \"projectile\": None,\n}\nCONTROLS = {\n    \"moveLeft\": [\"a\", \"arrowleft\"],\n    \"moveRight\": [\"d\", \"arrowright\"],\n    \"jump\": [\" \", \"z\"],\n    \"interact\": [\"e\"],\n    \"skipDialog\": [\"escape\"],\n    \"attack\": [\"j\", \"x\", \"mouseleft\"],\n    \"shoot\": [\"k\", \"c\", \"mouseright\"],\n    \"aimUp\": [\"w\", \"arrowup\"],\n    \"aimDown\": [\"s\", \"arrowdown\"],\n    \"dash\": [\"shift\"],\n    \"heal\": [\"l\", \"v\"],\n    \"debugGrid\": [\"f1\"],\n    \"debugHitbox\": [\"f2\"],\n}\nUI_CONFIG = {\n    \"lives\": {\n        \"icon\"