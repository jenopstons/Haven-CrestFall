            "DialogPrompt": {
              "type": "object script",
              "start": "# Positioned each frame by whichever object owns it (Exit or NPC).\n_apply_pose(self, _load_pose(UI_CONFIG['dialog']['indicator']['pose']))\nself.z = 150\n",
