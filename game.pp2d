              "type": "object script",
              "start": "# One-shot camera jitter. Uses a shared game.shakeX/shakeY offset, added\n# by Player's own loop, instead of calling set_camera() here directly -\n# Player already calls it every frame to follow the player, so a second\n# call here would just race it.\nself.timer = CAMERA_SHAKE_CONFIG['timer']\nself.distance = CAMERA_SHAKE_CONFIG['distance']\ngame.shakeX = 0\ngame.shakeY = 0\nself.visible = False\n",
              "loop": "if self._destroyed:\n    return\nif self.timer % 3 == 0:\n    game.shakeX = random.randint(-self.distance, self.distance)\n    game.shakeY = random.randint(-self.distance, self.distance)\nself.timer -= 1\nif self.timer <= 0:\n    game.shakeX = 0\n    game.shakeY = 0\n    destroy(self)\n"
            }
