          {
            "PlayerIndicator": {
              "type": "object script",
              "start": "# One icon of a player-following indicator (UI_CONFIG['playerIndicators']); the spawner sets spec and index.\nself.spec = None\nself.index = 0\nself.total = 1\nself.z = 7\nself.visible = False\n",
              "loop": "if self._destroyed or self.spec is None:\n    return\nplayer = getattr(game, 'player', None)\nif player is None or player._destroyed:\n    self.visible = False\n    return\nself.visible = self.index < getattr(player, self.spec['value'], 0)\nslot = self.index - (self.total - 1) / 2\nself.x = player.x + slot * (get_width(self) + self.spec['gap'])\nself.y = player.y + self.spec['offsetY']\n"
