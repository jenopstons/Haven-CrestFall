      {
        "Projectiles": [
          {
            "Projectile": {
              "type": "object script",
              "start": "self.z = 4\nself.dir = 1\nself.vx = 1\nself.vy = 0\nself.levelY = None\nself.speed = 0\nself.damage = 1\nself.travelled = 0\nself.maxDistance = 0\nself.fromPlayer = True\nself.hitbox = None\nself.stillPose = None\nself.winFrozen = False\n",
              "loop": "if self._destroyed:\n    return\nif getattr(game, 'finished', False):\n    _freeze_for_win(self)\n    return\nif _hit_stopped():\n    return\nself.x += self.vx * self.speed\nself.y += self.vy * self.speed\nif self.levelY is not None and (self.y - self.levelY) * self.vy >= 0:\n    self.y = self.levelY\n    self.vx = self.dir\n    self.vy = 0\n    self.levelY = None\n    self.angle = 0\nself.travelled += self.speed\nif self.travelled > self.maxDistance:\n    destroy(self)\n    return\n\nif self.fromPlayer:\n    for enemyHitbox in get_collision_list(self, 'EnemyHitbox'):\n        enemy = enemyHitbox.owner\n        if enemy._destroyed or enemy.dying or not _projectile_touches(self, enemyHitbox):\n            continue\n        _hurt_enemy(enemy, self.damage)\n        destroy(self)\n        return\nelse:\n    for playerHitbox in get_collision_list(self, 'PlayerHitbox'):\n        if _projectile_touches(self, playerHitbox) and not _dash_protects(game.player):\n            _damage_player(self.damage, self)\n            destroy(self)\n            return\n\nfor solid in _live_solids(self, edges=True):\n    if _projectile_touches(self, solid):\n        destroy(self)\n        return\n"
            }
