              "loop": "if self._destroyed:\n    return\nself.x = camera_x()\nself.y = camera_y()\nif self.alpha < 1:\n    self.alpha += 0.02\nelif self.nextRoom:\n    _enter_room(self.nextRoom, self.nextLocation)\n"
