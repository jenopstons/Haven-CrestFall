          {
            "LivesBackdrop": {
              "type": "object script",
              "start": "_apply_pose(self, _load_pose(UI_CONFIG['fadeOverlay']))\nself.baseWidth = get_width(self)\nself.baseHeight = get_height(self)\nself.alpha = 0.3\nself.z = 99\n",
              "loop": "livesLayout = UI_CONFIG['lives']\nlives = getattr(game, 'hud_lives', [])\nif not lives:\n    return\nfirst = lives[0]\nlast = lives[-1]\nleft = first.x - get_width(first) / 2\nright = last.x + get_width(last) / 2\nself.x = (left + right) / 2\nself.y = first.y\nself.scaleX = (right - left) / self.baseWidth\nself.scaleY = get_height(first) / self.baseHeight\n"
            }
          },
          {
            "Life": {
              "type": "object script",
              "start": "# One instance per HP point. The UI binding owns both state poses, so this\n# works for loose files, atlas frames, and animated ranges alike. A state\n# with no art hides the icon but keeps the other state's size for spacing.\nlifePoses = UI_CONFIG['lives']['icon']\nself.fullPose = _load_pose(lifePoses['full'])\nself.emptyPose = _load_pose(lifePoses['empty'])\n_apply_pose(self, self.fullPose or self.emptyPose)\nself.visible = self.fullPose is not None\nself.index = 0\nself.filled = True\nself.z = 100\n",
              "loop": "if self._destroyed:\n    return\nlivesLayout = UI_CONFIG['lives']\nself.x = camera_x() + livesLayout['x'] + self.index * (get_width(self) + livesLayout['gap'])\nself.y = camera_y() + livesLayout['y']\nplayer = getattr(game, 'player', None)\nshouldFill = player is not None and self.index < player.health\nif shouldFill != self.filled:\n    self.filled = shouldFill\n    pose = self.fullPose if shouldFill else self.emptyPose\n    _apply_pose(self, pose)\n    self.visible = pose is not None\n"
            }
